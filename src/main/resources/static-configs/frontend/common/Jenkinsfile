pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
  }

  tools {
    nodejs 'node-20'
  }

  stages {
    stage('Install') {
      steps {
        sh '''
          corepack enable
          if [ -f pnpm-lock.yaml ]; then
            pnpm install --frozen-lockfile
          else
            npm ci
          fi
        '''
      }
    }
    stage('Lint') {
      steps {
        sh 'pnpm lint || npm run lint'
      }
    }
    stage('Build') {
      steps {
        sh 'pnpm build || npm run build'
      }
    }
    stage('Archive') {
      steps {
        archiveArtifacts artifacts: 'dist/**', fingerprint: true
      }
    }
  }
}
