[
  {
    "exampleId": "blog",
    "name": "Blog",
    "description": "Authors write posts; readers leave comments. Posts move through a kanban of draft → published.",
    "icon": "article",
    "sortOrder": 0,
    "entities": [
      {
        "name": "Author",
        "fields": [
          {
            "name": "id",
            "type": "LONG",
            "primaryKey": true,
            "generated": true
          },
          {
            "name": "name",
            "type": "STRING",
            "required": true,
            "length": 120
          },
          {
            "name": "email",
            "type": "STRING",
            "required": true,
            "unique": true,
            "email": true,
            "length": 200
          },
          {
            "name": "bio",
            "type": "TEXT"
          }
        ]
      },
      {
        "name": "Post",
        "listViews": [
          "table",
          "cards",
          "kanban"
        ],
        "fields": [
          {
            "name": "id",
            "type": "LONG",
            "primaryKey": true,
            "generated": true
          },
          {
            "name": "title",
            "type": "STRING",
            "required": true,
            "length": 200
          },
          {
            "name": "body",
            "type": "TEXT"
          },
          {
            "name": "status",
            "type": "ENUM",
            "required": true,
            "enumValues": [
              "DRAFT",
              "PUBLISHED",
              "ARCHIVED"
            ]
          },
          {
            "name": "publishedAt",
            "type": "LOCAL_DATE_TIME"
          }
        ],
        "relations": [
          {
            "type": "MANY_TO_ONE",
            "fieldName": "author",
            "targetEntity": "Author",
            "required": true
          }
        ]
      },
      {
        "name": "Comment",
        "fields": [
          {
            "name": "id",
            "type": "LONG",
            "primaryKey": true,
            "generated": true
          },
          {
            "name": "body",
            "type": "TEXT",
            "required": true
          },
          {
            "name": "createdOn",
            "type": "LOCAL_DATE",
            "required": true
          },
          {
            "name": "approved",
            "type": "BOOLEAN"
          }
        ],
        "relations": [
          {
            "type": "MANY_TO_ONE",
            "fieldName": "post",
            "targetEntity": "Post",
            "required": true
          },
          {
            "type": "MANY_TO_ONE",
            "fieldName": "author",
            "targetEntity": "Author",
            "required": false
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "home",
        "type": "dashboard",
        "title": "Blog overview",
        "description": "What was published lately, and what still waits for moderation.",
        "widgets": [
          {
            "kind": "kpi",
            "entity": "Post",
            "title": "Posts"
          },
          {
            "kind": "kpi",
            "entity": "Comment",
            "title": "Comments"
          },
          {
            "kind": "kpi",
            "entity": "Comment",
            "title": "Awaiting approval",
            "presetFilter": {
              "approved": "false"
            }
          },
          {
            "kind": "kpi",
            "entity": "Author",
            "title": "Authors"
          },
          {
            "kind": "donut",
            "entity": "Post",
            "title": "Posts by status",
            "groupBy": "status"
          },
          {
            "kind": "line",
            "entity": "Post",
            "title": "Posts per month",
            "groupBy": "publishedAt",
            "bucket": "month"
          },
          {
            "kind": "top",
            "entity": "Post",
            "title": "Most active authors",
            "groupBy": "author",
            "limit": 5
          },
          {
            "kind": "recent",
            "entity": "Post",
            "title": "Latest posts",
            "sortBy": "publishedAt",
            "limit": 6
          }
        ]
      },
      {
        "id": "posts",
        "type": "entity-list",
        "group": "Content",
        "icon": "FileText",
        "entity": "Post"
      },
      {
        "id": "authors",
        "type": "master-detail",
        "group": "Content",
        "title": "Authors",
        "parent": "Author",
        "child": "Post"
      },
      {
        "id": "moderation",
        "type": "entity-list",
        "group": "Community",
        "icon": "Inbox",
        "title": "Moderation queue",
        "description": "Comments not approved yet.",
        "entity": "Comment",
        "presetFilter": {
          "approved": "false"
        }
      },
      {
        "id": "post",
        "type": "record",
        "entity": "Post",
        "hidden": true,
        "childTabs": [
          {
            "entity": "Comment",
            "via": "post"
          }
        ]
      }
    ],
    "settings": {
      "scaffold": [
        "audit"
      ]
    }
  },
