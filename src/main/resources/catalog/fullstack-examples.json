  {
    "exampleId": "reporting",
    "name": "Sales reporting",
    "description": "Sales rows plus a read-only SELECT view that rolls them up per month. Shows the aggregate widgets and a report page with filters, a chart and a CSV export.",
    "icon": "monitoring",
    "sortOrder": 5,
    "entities": [
      {
        "name": "Sale",
        "listViews": [
          "table",
          "calendar"
        ],
        "fields": [
          {
            "name": "id",
            "type": "LONG",
            "primaryKey": true,
            "generated": true
          },
          {
            "name": "reference",
            "type": "STRING",
            "required": true,
            "unique": true,
            "length": 40
          },
          {
            "name": "region",
            "type": "ENUM",
            "required": true,
            "enumValues": [
              "NORTH",
              "CENTER",
              "SOUTH"
            ]
          },
          {
            "name": "amount",
            "type": "BIG_DECIMAL",
            "required": true,
            "min": 0
          },
          {
            "name": "soldOn",
            "type": "LOCAL_DATE",
            "required": true
          }
        ]
      },
      {
        "name": "MonthlySales",
        "label": "Monthly sales",
        "labelPlural": "Monthly sales",
        "listViews": [
          "table",
          "cards"
        ],
        "viewQuery": "SELECT SUBSTRING(CAST(s.sold_on AS VARCHAR), 1, 7) AS period, SUM(s.amount) AS total, COUNT(*) AS sales FROM sales s GROUP BY SUBSTRING(CAST(s.sold_on AS VARCHAR), 1, 7)",
        "fields": [
          {
            "name": "period",
            "type": "STRING",
            "primaryKey": true
          },
          {
            "name": "total",
            "type": "BIG_DECIMAL"
          },
          {
            "name": "sales",
            "type": "LONG"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "report",
        "type": "dashboard",
        "title": "Sales report",
        "description": "Revenue at a glance: totals, the split by region and the trend per month.",
        "dateRange": "12m",
        "widgets": [
          {
            "kind": "kpi",
            "entity": "Sale",
            "title": "Sales",
            "compare": true
          },
          {
            "kind": "kpi",
            "entity": "Sale",
            "title": "Total revenue",
            "agg": "sum",
            "field": "amount"
          },
          {
            "kind": "kpi",
            "entity": "Sale",
            "title": "Average sale",
            "agg": "avg",
            "field": "amount"
          },
          {
            "kind": "kpi",
            "entity": "Sale",
            "title": "North revenue",
            "agg": "sum",
            "field": "amount",
            "presetFilter": {
              "region": "NORTH"
            }
          },
          {
            "kind": "progress",
            "entity": "Sale",
            "title": "Revenue target",
            "agg": "sum",
            "field": "amount",
            "target": "250000",
            "span": 2
          },
          {
            "kind": "bar",
            "entity": "Sale",
            "title": "Revenue by region",
            "groupBy": "region",
            "agg": "sum",
            "field": "amount"
          },
          {
            "kind": "line",
            "entity": "Sale",
            "title": "Revenue per month",
            "groupBy": "soldOn",
            "bucket": "month",
            "agg": "sum",
            "field": "amount",
            "span": 4
          },
          {
            "kind": "recent",
            "entity": "Sale",
            "title": "Latest sales",
            "limit": 8,
            "sortBy": "soldOn"
          }
        ]
      },
      {
        "id": "sales",
        "type": "entity-list",
        "entity": "Sale"
      },
      {
        "id": "revenue",
        "type": "report",
        "title": "Revenue analysis",
        "description": "Filter the sales and read the totals per region — Export CSV gives exactly what you filtered.",
        "entity": "Sale",
        "charts": [
          {
            "groupBy": "region",
            "agg": "sum",
            "field": "amount"
          },
          {
            "groupBy": "soldOn",
            "bucket": "month",
            "agg": "sum",
            "field": "amount"
          }
        ]
      },
      {
        "id": "monthly",
        "type": "entity-list",
        "entity": "MonthlySales"
      }
    ],
    "settings": {
      "scaffold": [
        "csvExport"
      ]
    }
  }
]
