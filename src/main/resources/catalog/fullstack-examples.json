              "CENTER",
              "SOUTH"
            ]
          },
          {
            "name": "amount",
            "type": "BIG_DECIMAL",
            "required": true,
            "min": 0
          },
          {
            "name": "soldOn",
            "type": "LOCAL_DATE",
            "required": true
          }
        ]
      },
      {
        "name": "MonthlySales",
        "label": "Monthly sales",
        "labelPlural": "Monthly sales",
        "listViews": [
          "table",
          "cards"
        ],
        "viewQuery": "SELECT SUBSTRING(CAST(s.sold_on AS VARCHAR), 1, 7) AS month, SUM(s.amount) AS total, COUNT(*) AS sales FROM sale s GROUP BY SUBSTRING(CAST(s.sold_on AS VARCHAR), 1, 7)",
        "fields": [
          {
            "name": "month",
            "type": "STRING",
            "primaryKey": true
          },
          {
            "name": "total",
            "type": "BIG_DECIMAL"
          },
          {
            "name": "sales",
            "type": "LONG"
          }
        ]
      }
    ]
