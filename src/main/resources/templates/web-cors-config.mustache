package {{packageName}}.config;

import org.springframework.context.annotation.Configuration;
import org.springframework.web.servlet.config.annotation.CorsRegistry;
import org.springframework.web.servlet.config.annotation.WebMvcConfigurer;

/**
 * CORS configuration for the paired frontend dev server.
 *
 * <p>Allows the Vite dev server (default port 5173) to call this API directly
 * during local development. The frontend project's {@code vite.config.ts} also
 * proxies {@code /api} to this backend so production builds don't need CORS
 * — this config only matters for {@code npm run dev}.
 *
 * <p>Generated by the paired wizard. Remove or tighten the allowed origins
 * before deploying.
 */
@Configuration
public class CorsConfig implements WebMvcConfigurer {

    @Override
    public void addCorsMappings(CorsRegistry registry) {
        registry.addMapping("/api/**")
                .allowedOrigins("http://localhost:5173")
                .allowedMethods("GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS")
                .allowedHeaders("*")
                .allowCredentials(true);
    }
}
