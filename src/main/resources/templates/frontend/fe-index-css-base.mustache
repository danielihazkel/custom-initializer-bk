/*
 * Menora baseline theme — design tokens as CSS custom properties.
 *
 * Written for every generated frontend, and overwritten by the Tailwind / shadcn
 * baselines (src/index.css) when those design systems are selected. The brand,
 * accent, success and danger colours come from the chosen palette at generation
 * time; the shell is the fixed Menora navy and the gradient mirrors the
 * sideBarGradient from the Menora design system. Inter is loaded in src/main.tsx.
 */
:root {
  --brand:           {{palette.primary}};
  --brand-deep:      color-mix(in srgb, {{palette.primary}} 85%, black);
  --accent-highlight:{{palette.secondary}};
  --success:         {{#hasPaletteAccent}}{{palette.accent}}{{/hasPaletteAccent}}{{^hasPaletteAccent}}#16a34a{{/hasPaletteAccent}};
  --danger:          {{#hasPaletteError}}{{palette.error}}{{/hasPaletteError}}{{^hasPaletteError}}#dc2626{{/hasPaletteError}};

  --shell:           #2B2F4C;
  --shell-gradient:  linear-gradient(135deg, var(--brand) 0%, var(--brand) 70%, var(--accent-highlight) 100%);

  --canvas:          #f6f7f9;
  --surface:         #ffffff;
  --fg:              #0f172a;
  --muted:           #64748b;
  --border:          #e6e9ee;

  --font-sans:       'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  height: 100%;
}

body {
  margin: 0;
  font-family: var(--font-sans);
  background-color: var(--canvas);
  color: var(--fg);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

a {
  color: var(--brand);
}
