{{#apiTestHasWorkflow}}

    @Test
{{#apiTestBlocked}}    @Disabled("{{{apiTestBlockedReason}}}")
{{/apiTestBlocked}}    void aRowMovesOnlyByItsWorkflow() throws Exception {
        JsonNode created = create("{{EntityName}}");
        String path = pathOf("{{EntityName}}", created);
        // Whatever a client sends, a new row starts where the workflow starts it.
        assertThat(created.get("{{apiTestStatusField}}").asText()).isEqualTo("{{apiTestInitial}}");
{{#apiTestHasAssignee}}        // Claiming makes it the caller's.
        assertThat(send(post(path + "/claim"), null, 200).get("{{apiTestAssigneeField}}").asText()).isEqualTo(ADMIN);
{{/apiTestHasAssignee}}
        JsonNode moved = send(post(path + "/transitions/{{apiTestMove}}"), null, 200);
        assertThat(moved.get("{{apiTestStatusField}}").asText()).isEqualTo("{{apiTestMovedTo}}");
{{#apiTestHasWrongMove}}        // A move that does not start where the row is, is refused.
        send(post(path + "/transitions/{{apiTestWrongMove}}"), null, 409);
{{/apiTestHasWrongMove}}        send(post(path + "/transitions/noSuchMove"), null, 400);
    }
{{/apiTestHasWorkflow}}
