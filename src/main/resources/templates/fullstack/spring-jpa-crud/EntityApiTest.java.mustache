    private static final String PATH = "{{{apiTestListPath}}}";

    @Test
    void theListAnswersAPage() throws Exception {
        JsonNode page = read(PATH + "?size=5");
        assertThat(page.get("content").isArray()).isTrue();
        assertThat(page.has("totalElements") || page.has("page")).isTrue();
    }

    @Test
    void anUnknownSortIsRefused() throws Exception {
        send(get(PATH + "?sort=noSuchColumn,asc"), null, 400);
    }
{{#apiTestHasMissing}}

    @Test
