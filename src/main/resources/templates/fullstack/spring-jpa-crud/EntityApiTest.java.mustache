{{/apiTestHasMissing}}
{{#apiTestMutable}}

    @Test
{{#apiTestBlocked}}    @Disabled("{{{apiTestBlockedReason}}}")
{{/apiTestBlocked}}    void aRowIsCreatedReadChangedAndDeleted() throws Exception {
        JsonNode created = create("{{EntityName}}");
        String path = pathOf("{{EntityName}}", created);
        assertThat(read(path).get("{{apiTestKey}}")).isEqualTo(created.get("{{apiTestKey}}"));

        ObjectNode changed = created.deepCopy();
{{#apiTestHasUpdate}}        changed.put("{{apiTestUpdateField}}", {{{apiTestUpdateValue}}});
{{/apiTestHasUpdate}}        JsonNode updated = send(put(path), changed, 200);
{{#apiTestHasUpdate}}        assertThat(updated.get("{{apiTestUpdateField}}")).isEqualTo(changed.get("{{apiTestUpdateField}}"));
        assertThat(read(path).get("{{apiTestUpdateField}}")).isEqualTo(changed.get("{{apiTestUpdateField}}"));
{{/apiTestHasUpdate}}{{^apiTestHasUpdate}}        assertThat(updated.get("{{apiTestKey}}")).isEqualTo(created.get("{{apiTestKey}}"));
{{/apiTestHasUpdate}}

        send(delete(path), null, 204);
        send(get(path), null, 404);
{{#apiTestRestores}}
        // Deleted softly: it can be brought back.
        send(post(path + "/restore"), null, 200);
        assertThat(read(path).get("{{apiTestKey}}")).isEqualTo(created.get("{{apiTestKey}}"));
{{/apiTestRestores}}
    }
{{#apiTestHasSearch}}

    @Test
{{#apiTestBlocked}}    @Disabled("{{{apiTestBlockedReason}}}")
{{/apiTestBlocked}}    void theSearchFindsARowByItsText() throws Exception {
        JsonNode created = create("{{EntityName}}");
        String text = created.get("{{apiTestSearchField}}").asText();
        JsonNode found = send(get(PATH).param("size", "100").param("q", text), null, 200);
        assertThat(found.get("content").findValuesAsText("{{apiTestKey}}")).contains(created.get("{{apiTestKey}}").asText());
