package {{packageName}}.history;

import jakarta.persistence.*;

import java.time.Instant;

/**
 * One change to one row: who made it, when, which fields, and the row before and after (as JSON).
 * Written by {@link ChangeLogRecorder} in the transaction of the change; never changed afterwards.
 *
 * <pre>
 * create table app_change_log (
 *     id bigint generated by default as identity primary key,
 *     entity_name varchar(100) not null,   -- the entity in kebab case: order-line
 *     row_id varchar(100) not null,
 *     action varchar(16) not null,         -- CREATE, UPDATE, DELETE, RESTORE
 *     changed_at timestamp not null,
 *     changed_by varchar(255) not null,
 *     changed_fields varchar(2000),
 *     before_json text,
 *     after_json text
 * );
 * create index ix_app_change_log_row on app_change_log (entity_name, row_id);
 * </pre>
 */
@Entity
@Table(name = "app_change_log", indexes = @Index(name = "ix_app_change_log_row", columnList = "entity_name, row_id"))
public class ChangeLogEntry {

    public enum Action { CREATE, UPDATE, DELETE, RESTORE }

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(name = "entity_name", nullable = false, length = 100)
    private String entityName;

    @Column(name = "row_id", nullable = false, length = 100)
    private String rowId;

    @Enumerated(EnumType.STRING)
    @Column(name = "action", nullable = false, length = 16)
    private Action action;

    @Column(name = "changed_at", nullable = false)
    private Instant changedAt;

    @Column(name = "changed_by", nullable = false)
    private String changedBy;

    @Column(name = "changed_fields", length = 2000)
    private String changedFields;

    @Column(name = "before_json", columnDefinition = "TEXT")
    private String beforeJson;

    @Column(name = "after_json", columnDefinition = "TEXT")
    private String afterJson;

    protected ChangeLogEntry() {
    }

    /** An entry the code writes itself (most are written by {@link ChangeLogRecorder}). */
    static ChangeLogEntry of(String entityName, String rowId, Action action, String changedBy,
                             String changedFields, String beforeJson, String afterJson) {
        ChangeLogEntry e = new ChangeLogEntry();
        e.entityName = entityName;
        e.rowId = rowId;
        e.action = action;
        e.changedAt = Instant.now();
        e.changedBy = changedBy;
        e.changedFields = changedFields;
        e.beforeJson = beforeJson;
        e.afterJson = afterJson;
        return e;
    }

    public Long getId() { return id; }
    public String getEntityName() { return entityName; }
    public String getRowId() { return rowId; }
    public Action getAction() { return action; }
    public Instant getChangedAt() { return changedAt; }
    public String getChangedBy() { return changedBy; }
    public String getChangedFields() { return changedFields; }
    public String getBeforeJson() { return beforeJson; }
    public String getAfterJson() { return afterJson; }
}
