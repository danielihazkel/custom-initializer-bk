package {{packageName}}.history;

import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;

import java.util.List;
import java.util.Optional;

public interface ChangeLogRepository extends JpaRepository<ChangeLogEntry, Long> {

    /** A row's changes, newest first. */
    List<ChangeLogEntry> findByEntityNameAndRowIdOrderByIdDesc(String entityName, String rowId, Pageable page);

    Optional<ChangeLogEntry> findFirstByEntityNameAndRowIdOrderByIdDesc(String entityName, String rowId);
}
