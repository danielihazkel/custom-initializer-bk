package {{packageName}}.workflow;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.Index;
import jakarta.persistence.Table;

import java.time.Instant;

/**
 * One step of a row through its workflow: created in its first state, or moved from one state
 * to another by a transition — who did it, when, and how long the row had been in the state it
 * left. Written by {@link WorkflowMoveLog}; never changed afterwards.
 *
 * <p>The table, for a database whose schema is not created from the entities:
 * <pre>
 * create table app_workflow_move (
 *   id              bigint generated by default as identity primary key,
 *   entity_name     varchar(100) not null,
 *   row_id          varchar(100) not null,
 *   from_state      varchar(100),
 *   to_state        varchar(100) not null,
 *   transition_name varchar(40),
 *   actor           varchar(200),
 *   moved_at        timestamp    not null,
 *   seconds_in_from bigint
 * );
 * create index ix_app_workflow_move_row on app_workflow_move (entity_name, row_id);
 * </pre>
 */
@Entity
@Table(name = "app_workflow_move", indexes = @Index(name = "ix_app_workflow_move_row", columnList = "entity_name, row_id"))
public class WorkflowMove {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    /** The entity whose row moved, as its pages spell it ({@code expense-claim}). */
    @Column(name = "entity_name", nullable = false, length = 100)
    private String entityName;

    /** The row's key, as text. */
    @Column(name = "row_id", nullable = false, length = 100)
    private String rowId;

    /** The state the row left; null for the step that created it. */
    @Column(name = "from_state", length = 100)
    private String fromState;

    @Column(name = "to_state", nullable = false, length = 100)
    private String toState;

    /** The transition that moved it; null for the step that created it. */
    @Column(name = "transition_name", length = 40)
    private String transition;

    /** The user id of whoever did it, when the request said who. */
    @Column(name = "actor", length = 200)
    private String actor;

    @Column(name = "moved_at", nullable = false)
    private Instant movedAt;

    /** How long the row had been in {@code fromState}; null when its arrival there was not logged. */
    @Column(name = "seconds_in_from")
    private Long secondsInFrom;

    protected WorkflowMove() {
    }

    WorkflowMove(String entityName, String rowId, String fromState, String toState, String transition, String actor,
                 Instant movedAt, Long secondsInFrom) {
        this.entityName = entityName;
        this.rowId = rowId;
        this.fromState = fromState;
        this.toState = toState;
        this.transition = transition;
        this.actor = actor;
        this.movedAt = movedAt;
        this.secondsInFrom = secondsInFrom;
    }

    public Long getId() {
        return id;
    }

    public String getEntityName() {
        return entityName;
    }

    public String getRowId() {
        return rowId;
    }

    public String getFromState() {
        return fromState;
    }

    public String getToState() {
        return toState;
    }

    public String getTransition() {
        return transition;
    }

    public String getActor() {
        return actor;
    }

    public Instant getMovedAt() {
        return movedAt;
    }

    public Long getSecondsInFrom() {
        return secondsInFrom;
    }
}
