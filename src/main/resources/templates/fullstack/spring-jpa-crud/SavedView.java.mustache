package {{packageName}}.views;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import jakarta.persistence.UniqueConstraint;

import java.time.Instant;

/**
 * A named way of looking at one list — its search, filters, sort, page size, view and hidden
 * columns — kept for the user who saved it and, when shared, offered to everyone.
 *
 * <p>The state is the frontend's own JSON, stored as text: the server checks that it is an object
 * of a sane size and otherwise does not read it, so the list page can remember more without a
 * change here.
 *
 * <p>The table, for a database whose schema is not created from the entities:
 * <pre>
 * create table app_saved_view (
 *   id           bigint generated by default as identity primary key,
 *   list_name    varchar(100)  not null,
 *   owner_id     varchar(200)  not null,
 *   view_name    varchar(80)   not null,
 *   shared_view  boolean       not null,
 *   default_view boolean       not null,
 *   view_state   varchar(4000) not null,
 *   updated_at   timestamp     not null,
 *   constraint uk_app_saved_view_name unique (list_name, owner_id, view_name)
 * );
 * </pre>
 */
@Entity
@Table(name = "app_saved_view",
        uniqueConstraints = @UniqueConstraint(name = "uk_app_saved_view_name", columnNames = {"list_name", "owner_id", "view_name"}))
public class SavedView {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    /** The list the view is of: the entity's name as its pages spell it ({@code expense-claim}). */
    @Column(name = "list_name", nullable = false, length = 100)
    private String listName;

    /** The user id of whoever saved it. */
    @Column(name = "owner_id", nullable = false, length = 200)
    private String owner;

    @Column(name = "view_name", nullable = false, length = 80)
    private String name;

    /** Offered to every user of the list, who can apply it but not change it. */
    @Column(name = "shared_view", nullable = false)
    private boolean shared;

    /** The view its owner's list opens with. */
    @Column(name = "default_view", nullable = false)
    private boolean defaultView;

    @Column(name = "view_state", nullable = false, length = SavedViewService.MAX_STATE)
    private String state;

    @Column(name = "updated_at", nullable = false)
    private Instant updatedAt;

    protected SavedView() {
    }

    SavedView(String listName, String owner, String name, String state) {
        this.listName = listName;
        this.owner = owner;
        this.name = name;
        this.state = state;
        this.updatedAt = Instant.now();
    }

    public Long getId() {
        return id;
    }

    public String getListName() {
        return listName;
    }

    public String getOwner() {
        return owner;
    }

    public String getName() {
        return name;
    }

    void setName(String name) {
        this.name = name;
        this.updatedAt = Instant.now();
    }

    public boolean isShared() {
        return shared;
    }

    void setShared(boolean shared) {
        this.shared = shared;
        this.updatedAt = Instant.now();
    }

    public boolean isDefaultView() {
        return defaultView;
    }

    void setDefaultView(boolean defaultView) {
        this.defaultView = defaultView;
        this.updatedAt = Instant.now();
    }

    public String getState() {
        return state;
    }

    void setState(String state) {
        this.state = state;
        this.updatedAt = Instant.now();
    }

    public Instant getUpdatedAt() {
        return updatedAt;
    }
}
