    /**
     * Aggregates the rows the dashboard charts and report pages draw, honouring the same search
     * and filters as the list — so a chart always agrees with the table beneath it.
     *
     * @param groupBy a groupable or date column, or null/blank for a single total
     * @param bucket  {@code day}/{@code month}/{@code year} when {@code groupBy} is a date column
     * @param agg     {@code count} (the default) or {@code sum}/{@code avg}/{@code min}/{@code max}
     *                over {@code field}
     * @param top     the largest {@code top} groups only (1–100), biggest first — a ranking rather
     *                than a breakdown; null keeps every group, ordered by key
     * @param series  a second groupable column that splits every group (a stacked bar); one bucket
     *                per (group, series) pair
     */
    @Transactional(readOnly = true)
    public java.util.List<StatsBucket> stats(String q, {{#hasFilters}}Filters filters, {{/hasFilters}}String groupBy,
                                             String bucket, String agg, String field, Integer top, String series) {
        // Hibernate's builder rather than the JPA one, for the date parts below: cb.year(x) lowers
        // to `extract(year from x)`, which every dialect renders for itself. The portable-looking
        // cb.function("year", ...) would emit a raw SQL year() that only some databases have.
        HibernateCriteriaBuilder cb = (HibernateCriteriaBuilder) entityManager.getCriteriaBuilder();
        CriteriaQuery<Tuple> query = cb.createTupleQuery();
        Root<{{EntityName}}> root = query.from({{EntityName}}.class);

        java.util.List<Selection<?>> selections = new java.util.ArrayList<>();
        java.util.List<Expression<?>> groups = new java.util.ArrayList<>();
        boolean grouped = groupBy != null && !groupBy.isBlank();
        boolean overTime = grouped && isDateGroup(groupBy);
        if (top != null) {
            if (top < 1 || top > 100) throw new IllegalArgumentException("top must be between 1 and 100");
            if (!grouped || overTime) throw new IllegalArgumentException("top ranks groups, so it needs a groupBy that is not a date");
        }
        boolean split = series != null && !series.isBlank();
        if (split) {
            if (!grouped || overTime) throw new IllegalArgumentException("series splits groups, so it needs a groupBy that is not a date");
            if (top != null) throw new IllegalArgumentException("top and series cannot be combined");
            if (series.equals(groupBy)) throw new IllegalArgumentException("series must differ from groupBy");
        }
        if (overTime) {
{{#hasStatsDateFields}}            String unit = bucketUnit(bucket);
            Expression<? extends TemporalAccessor> when = datePath(root, groupBy);
            groups.add(cb.year(when));
            if (!"year".equals(unit)) groups.add(cb.month(when));
            if ("day".equals(unit)) groups.add(cb.day(when));
            selections.addAll(groups);
{{/hasStatsDateFields}}        } else if (grouped) {
            Path<?> path = groupPath(root, groupBy);
            groups.add(path);
            selections.add(path);
            if (split) {
                Path<?> seriesPath = groupPath(root, series);
                groups.add(seriesPath);
                selections.add(seriesPath);
            }
        }
        Expression<? extends Number> measure = aggregate(cb, root, agg, field);
        selections.add(measure);
        query.multiselect(selections);
{{#needsSpecification}}        Specification<{{EntityName}}> spec = specOf(q{{#hasFilters}}, filters{{/hasFilters}});
        if (spec != null) {
            Predicate predicate = spec.toPredicate(root, query, cb);
            if (predicate != null) query.where(predicate);
        }
{{/needsSpecification}}        if (!groups.isEmpty()) {
            query.groupBy(groups);
            if (top != null) {
                query.orderBy(cb.desc(measure));
            } else {
                // Ordered by the key, so a time series arrives oldest first and a breakdown is stable.
                // The Order type is spelled out: an entity called Order would shadow a plain import.
                java.util.List<jakarta.persistence.criteria.Order> ascending = new java.util.ArrayList<>();
                for (Expression<?> group : groups) ascending.add(cb.asc(group));
                query.orderBy(ascending);
            }
        }

        jakarta.persistence.TypedQuery<Tuple> typed = entityManager.createQuery(query);
        if (top != null) typed.setMaxResults(top);
        java.util.List<Tuple> rows = typed.getResultList();
        java.util.List<StatsBucket> out = new java.util.ArrayList<>(rows.size());
        for (Tuple row : rows) {
            Object value = row.get(groups.size());
            // A split row carries its series value right after the group key.
            Object seriesValue = split ? row.get(1) : null;
            out.add(new StatsBucket(keyOf(row, split ? 1 : groups.size(), overTime),
                    value == null ? null : new java.math.BigDecimal(value.toString()),
                    split ? (seriesValue == null ? "" : String.valueOf(seriesValue)) : null));
        }
        return out;
    }

    /** The reduction applied to each group. {@code count} counts rows; the rest cast the column to
     *  a decimal first, so one code path covers Long, Integer and BigDecimal alike. */
    private static Expression<? extends Number> aggregate(HibernateCriteriaBuilder cb, Root<{{EntityName}}> root,
                                                          String agg, String field) {
        String reduction = agg == null || agg.isBlank() ? "count" : agg.toLowerCase(java.util.Locale.ROOT);
        if (reduction.equals("count")) return cb.count(root);
        Expression<java.math.BigDecimal> value = cb.toBigDecimal(numericPath(root, field));
        return switch (reduction) {
            case "sum" -> cb.sum(value);
            case "avg" -> cb.avg(value);
            case "min" -> cb.min(value);
            case "max" -> cb.max(value);
            default -> throw new IllegalArgumentException("Unknown agg: " + agg);
        };
    }

