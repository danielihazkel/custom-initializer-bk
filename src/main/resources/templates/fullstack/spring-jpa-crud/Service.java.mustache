                // The Order type is spelled out: an entity called Order would shadow a plain import.
                java.util.List<jakarta.persistence.criteria.Order> ascending = new java.util.ArrayList<>();
                for (Expression<?> group : groups) ascending.add(cb.asc(group));
                query.orderBy(ascending);
            }
        }

        jakarta.persistence.TypedQuery<Tuple> typed = entityManager.createQuery(query);
        if (top != null) typed.setMaxResults(top);
        java.util.List<Tuple> rows = typed.getResultList();
        java.util.List<StatsBucket> out = new java.util.ArrayList<>(rows.size());
        for (Tuple row : rows) {
            Object value = row.get(groups.size());
            // A split row carries its series value right after the group key.
            Object seriesValue = split ? row.get(1) : null;
            out.add(new StatsBucket(keyOf(row, split ? 1 : groups.size(), overTime),
                    value == null ? null : new java.math.BigDecimal(value.toString()),
                    split ? (seriesValue == null ? "" : String.valueOf(seriesValue)) : null));
