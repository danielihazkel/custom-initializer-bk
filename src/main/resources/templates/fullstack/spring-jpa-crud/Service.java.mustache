                groups.add(seriesPath);
                selections.add(seriesPath);
            }
        }
        Expression<? extends Number> measure = aggregate(cb, root, agg, field);
        selections.add(measure);
        query.multiselect(selections);
{{#needsSpecification}}        Specification<{{EntityName}}> spec = specOf(q{{#hasFilters}}, filters{{/hasFilters}});
        if (spec != null) {
            Predicate predicate = spec.toPredicate(root, query, cb);
            if (predicate != null) query.where(predicate);
        }
{{/needsSpecification}}        if (!groups.isEmpty()) {
            query.groupBy(groups);
            if (top != null) {
