        {{EntityName}} existing = findById(id);
        if (!OPEN_STATES.contains(existing.get{{WorkflowStatusName}}())) {
            throw WorkflowException.wrongState("This {{EntityName}} is " + existing.get{{WorkflowStatusName}}() + ", so there is nothing left to do");
        }
