    /** {@code 2026}, {@code 2026-09} or {@code 2026-09-22} for a date group; the raw value otherwise. */
    private static String keyOf(Tuple row, int parts, boolean overTime) {
        if (parts == 0) return "";
        if (!overTime) {
            Object value = row.get(0);
            return value == null ? "" : String.valueOf(value);
        }
        StringBuilder key = new StringBuilder();
        for (int i = 0; i < parts; i++) {
            Number part = (Number) row.get(i);
            if (part == null) return "";
            key.append(i == 0 ? String.format("%04d", part.intValue()) : String.format("-%02d", part.intValue()));
        }
        return key.toString();
    }
