        // to `extract(year from x)`, which every dialect renders for itself. The portable-looking
        // cb.function("year", ...) would emit a raw SQL year() that only some databases have.
        HibernateCriteriaBuilder cb = (HibernateCriteriaBuilder) entityManager.getCriteriaBuilder();
        CriteriaQuery<Tuple> query = cb.createTupleQuery();
        Root<{{EntityName}}> root = query.from({{EntityName}}.class);

        java.util.List<Selection<?>> selections = new java.util.ArrayList<>();
        java.util.List<Expression<?>> groups = new java.util.ArrayList<>();
