    /** The reduction applied to each group. {@code count} counts rows; the rest cast the column to
     *  a decimal first, so one code path covers Long, Integer and BigDecimal alike. */
    private static Expression<? extends Number> aggregate(HibernateCriteriaBuilder cb, Root<{{EntityName}}> root,
                                                          String agg, String field) {
        String reduction = agg == null || agg.isBlank() ? "count" : agg.toLowerCase(java.util.Locale.ROOT);
        if (reduction.equals("count")) return cb.count(root);
        Expression<java.math.BigDecimal> value = cb.toBigDecimal(numericPath(root, field));
        return switch (reduction) {
            case "sum" -> cb.sum(value);
            case "avg" -> cb.avg(value);
            case "min" -> cb.min(value);
            case "max" -> cb.max(value);
            default -> throw new IllegalArgumentException("Unknown agg: " + agg);
        };
    }

