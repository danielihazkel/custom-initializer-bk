        boolean overTime = grouped && isDateGroup(groupBy);
        if (top != null) {
            if (top < 1 || top > 100) throw new IllegalArgumentException("top must be between 1 and 100");
            if (!grouped || overTime) throw new IllegalArgumentException("top ranks groups, so it needs a groupBy that is not a date");
        }
        boolean split = series != null && !series.isBlank();
        if (split) {
            if (!grouped || overTime) throw new IllegalArgumentException("series splits groups, so it needs a groupBy that is not a date");
            if (top != null) throw new IllegalArgumentException("top and series cannot be combined");
            if (series.equals(groupBy)) throw new IllegalArgumentException("series must differ from groupBy");
        }
        if (overTime) {
{{#hasStatsDateFields}}            String unit = bucketUnit(bucket);
            Expression<? extends TemporalAccessor> when = datePath(root, groupBy);
            groups.add(cb.year(when));
            if (!"year".equals(unit)) groups.add(cb.month(when));
            if ("day".equals(unit)) groups.add(cb.day(when));
            selections.addAll(groups);
{{/hasStatsDateFields}}        } else if (grouped) {
            Path<?> path = groupPath(root, groupBy);
            groups.add(path);
            selections.add(path);
            if (split) {
