/**
 * Seeds a handful of demo rows per entity on startup so a freshly generated app has something to
 * show. Runs only while every seeded table is empty, and is switched off with
 * {@code app.demo-data.enabled=false} (do that in production). Parents are seeded before children
 * so foreign keys resolve; strings and keys carry the row number so unique columns never clash.
 */
@Component
@ConditionalOnProperty(prefix = "app.demo-data", name = "enabled", havingValue = "true", matchIfMissing = true)
public class DemoDataLoader implements CommandLineRunner {

    private static final Logger log = LoggerFactory.getLogger(DemoDataLoader.class);

    /** Rows created per entity. */
    static final int ROWS = 8;

{{#hasWorkflowMoves}}    private final {{packageName}}.workflow.WorkflowMoveLog moves;
{{/hasWorkflowMoves}}{{#seedEntities}}    private final {{EntityName}}Repository {{entityName}}Repository;
{{/seedEntities}}{{#hasAttachments}}    private final {{packageName}}.attachment.Attachments attachments;
{{/hasAttachments}}
    public DemoDataLoader({{#seedEntities}}{{EntityName}}Repository {{entityName}}Repository{{^seedLast}}, {{/seedLast}}{{/seedEntities}}{{#hasAttachments}},
                          {{packageName}}.attachment.Attachments attachments{{/hasAttachments}}{{#hasWorkflowMoves}},
                          {{packageName}}.workflow.WorkflowMoveLog moves{{/hasWorkflowMoves}}) {
{{#seedEntities}}        this.{{entityName}}Repository = {{entityName}}Repository;
{{/seedEntities}}{{#hasAttachments}}        this.attachments = attachments;
{{/hasAttachments}}{{#hasWorkflowMoves}}        this.moves = moves;
{{/hasWorkflowMoves}}    }

    @Override
    public void run(String... args) {
        if ({{#seedEntities}}{{^seedFirst}} || {{/seedFirst}}{{entityName}}Repository.count() > 0{{/seedEntities}}) {
            log.info("Demo data: tables already contain rows, skipping");
            return;
        }
{{#seedEntities}}
        List<{{EntityName}}> {{entityName}}Rows = new ArrayList<>();
{{#uniqueKeys}}        // Unique key {{index}}: a row that would repeat another's values is left out.
        java.util.Set<List<Object>> {{entityName}}Key{{index}} = new java.util.HashSet<>();
{{/uniqueKeys}}        for (int i = 1; i <= ROWS; i++) {
            {{EntityName}} row = new {{EntityName}}();
{{#fields}}{{^isGenerated}}            row.set{{Name}}({{seedExpr}});
{{/isGenerated}}{{/fields}}{{#relations}}{{#targetSeeded}}{{#targetMayHaveNoRows}}            if ({{targetEntityCamel}}Rows.isEmpty()) continue; // its rules left it no demo rows to link to
{{/targetMayHaveNoRows}}            row.set{{FieldName}}({{targetEntityCamel}}Rows.get((i - 1) % {{targetEntityCamel}}Rows.size()));
{{/targetSeeded}}{{/relations}}{{#hasRules}}{{^hasRuleChecks}}            {{packageName}}.rules.{{EntityName}}Rules.derive(row); // hidden fields cleared, computed ones computed
{{/hasRuleChecks}}{{#hasRuleChecks}}            // Hidden fields cleared, computed ones computed — and a row a rule is broken by is left out:
            // the app would refuse to save it, so it could never be edited.
            if (!{{packageName}}.rules.{{EntityName}}Rules.apply(row).isEmpty()) continue;
{{/hasRuleChecks}}{{/hasRules}}{{#uniqueKeys}}            if (!{{entityName}}Key{{index}}.add(java.util.Arrays.<Object>asList({{{tuple}}}))) continue;
{{/uniqueKeys}}            {{entityName}}Rows.add(row);
        }
        {{entityName}}Rows = {{entityName}}Repository.saveAll({{entityName}}Rows);
{{#tracksMoves}}        // A history for each: created some days ago, and moved on if it is no longer where it started.
        for (int i = 0; i < {{entityName}}Rows.size(); i++) {
            {{EntityName}} row = {{entityName}}Rows.get(i);
            moves.seed("{{entityNameKebab}}", row.get{{pkField.Name}}(), {{workflowInitialJava}}, row.get{{WorkflowStatusName}}(), i);
        }
{{/tracksMoves}}
{{/seedEntities}}
        log.info("Demo data: seeded {} rows per entity", ROWS);
    }

{{#hasAttachments}}    /** A one-pixel PNG: what a required image field holds in the demo rows. */
    private static final byte[] SAMPLE_IMAGE = java.util.Base64.getDecoder().decode(
            "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==");

    /** Stores a placeholder picture for a required image field and answers its id. */
    private java.util.UUID sampleImage(int i) {
        return attachments.store("sample-" + i + ".png", "image/png", SAMPLE_IMAGE, {{packageName}}.attachment.Attachments.SYSTEM).id();
    }

    /** Stores a placeholder file for a required file field and answers its id. */
    private java.util.UUID sampleFile(int i) {
        byte[] content = ("Demo file " + i + "\n").getBytes(java.nio.charset.StandardCharsets.UTF_8);
        return attachments.store("sample-" + i + ".txt", "text/plain", content, {{packageName}}.attachment.Attachments.SYSTEM).id();
    }

{{#hasMultiFiles}}    /** The one file a required field with several files holds in the demo rows. */
    private java.util.List<{{packageName}}.attachment.AttachedFile> sampleFiles(int i, boolean image) {
        java.util.UUID id = image ? sampleImage(i) : sampleFile(i);
        return new java.util.ArrayList<>(java.util.List.of(new {{packageName}}.attachment.AttachedFile(id,
                "sample-" + i + (image ? ".png" : ".txt"))));
    }

{{/hasMultiFiles}}{{/hasAttachments}}    /** "{base} {i}", truncated to {max} characters while keeping the row number so values stay unique. */
    static String label(String base, int i, int max) {
        String s = base + " " + i;
        if (s.length() <= max) {
            return s;
        }
        String n = String.valueOf(i);
        if (n.length() >= max) {
            return n.substring(0, max);
        }
        return s.substring(0, max - n.length() - 1).trim() + " " + n;
    }

    /** A short paragraph of filler text ending in "{base} {i}". */
    static String text(String base, int i) {
        return "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt "
                + "ut labore et dolore magna aliqua. " + base + " " + i;
    }

    /** Row number {i} mapped into [{min}, {max}] when bounds are set (cycling), else {i} itself. */
    static long bounded(int i, Long min, Long max) {
        if (min == null && max == null) {
            return i;
        }
        long lo = min != null ? min : Math.min(0L, max);
        long hi = max != null ? max : lo + 1000;
        long span = Math.max(1L, hi - lo + 1);
        return lo + (i - 1) % span;
    }
}
