{
  "setKey": "spring-jpa-crud",
  "name": "Spring Boot + JPA CRUD",
  "description": "Per-entity JPA Entity, Repository, DTO, Service, and Controller with standard REST endpoints",
  "kind": "BACKEND_JAVA",
  "sortOrder": 10,
  "defaultDeps": ["data-jpa", "web", "h2", "validation", "actuator"],
  "files": [
