/**
 * {@code GET /api/events/stream}: the browser's live line to the data — a server-sent event
 * {@code change} ({@code {"entity", "rowId", "kind"}}) whenever a row it may read is committed, so
 * open lists and the bell refresh without polling. It says only which row changed; the page reads
 * the row through the API, with the caller's own access.
 *
 * <p>Each instance tells its own browsers of its own changes: behind a load balancer, a change made
 * on another instance reaches a page at its next refresh. A connection is closed after 30 minutes
 * and the page opens a new one; a comment every 25 seconds keeps proxies from closing it sooner.
 */
@RestController
public class LiveEvents {

    private static final long TIMEOUT_MS = 30 * 60 * 1000L;

    /** One open page, and the entities it may hear of. */
    private record Listener(SseEmitter emitter, Set<String> entities{{#hasRowAccess}}, Set<String> unnamed{{/hasRowAccess}}) {}

    private final Set<Listener> listeners = ConcurrentHashMap.newKeySet();
{{#hasLdapAuth}}
    private final PermissionService permissions;

    public LiveEvents(PermissionService permissions) {
        this.permissions = permissions;
    }
{{/hasLdapAuth}}

    @GetMapping(path = "/api/events/stream", produces = MediaType.TEXT_EVENT_STREAM_VALUE)
    public SseEmitter stream(@RequestHeader(value = "userinfo", required = false) String user, HttpServletResponse response) {
{{#hasLdapAuth}}
        if (user == null || user.isBlank()) {
            throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "User authentication required");
        }
{{/hasLdapAuth}}
        Set<String> entities = new TreeSet<>();
        for (EventRecorder.Tracked tracked : EventRecorder.TRACKED.values()) {
            if (tracked.publishes() && mayRead(user, tracked.readLevel())) entities.add(tracked.name());
        }
        // nginx passes each event on as it comes instead of buffering the response.
        response.setHeader("X-Accel-Buffering", "no");
        response.setHeader(HttpHeaders.CACHE_CONTROL, "no-cache");
        SseEmitter emitter = new SseEmitter(TIMEOUT_MS);
{{#hasRowAccess}}        // Where rows belong to users, a user hears that something changed — not which row.
        Set<String> unnamed = new TreeSet<>();
        if (!mayRead(user, "ADMIN")) {
            for (EventRecorder.Tracked tracked : EventRecorder.TRACKED.values()) {
                if (tracked.ownRows() && entities.contains(tracked.name())) unnamed.add(tracked.name());
            }
        }
{{/hasRowAccess}}        Listener listener = new Listener(emitter, entities{{#hasRowAccess}}, unnamed{{/hasRowAccess}});
        listeners.add(listener);
        emitter.onCompletion(() -> listeners.remove(listener));
        emitter.onTimeout(() -> listeners.remove(listener));
        emitter.onError(e -> listeners.remove(listener));
        send(listener, SseEmitter.event().name("ready").data(entities, MediaType.APPLICATION_JSON));
        return emitter;
    }

{{#hasLdapAuth}}
    private boolean mayRead(String user, String level) {
        try {
            return permissions.holds(user.trim(), level);
        } catch (UnauthorizedException e) {
            return false;
        }
    }
{{/hasLdapAuth}}
{{^hasLdapAuth}}
    private boolean mayRead(String user, String level) {
        // No roles without an ldap-auth dependency: every caller reads everything.
        return true;
    }
{{/hasLdapAuth}}

    /** Tells every page that may read {@code entity} that one of its rows changed. */
    public void publish(String entity, String rowId, String kind) {
        Map<String, String> change = new LinkedHashMap<>();
        change.put("entity", entity);
        change.put("rowId", rowId);
        change.put("kind", kind);
{{#hasRowAccess}}        Map<String, String> anonymous = new LinkedHashMap<>(change);
        anonymous.remove("rowId");
{{/hasRowAccess}}        for (Listener listener : listeners) {
            if (listener.entities().contains(entity)) {
                send(listener, SseEmitter.event().name("change").data({{#hasRowAccess}}listener.unnamed().contains(entity) ? anonymous : {{/hasRowAccess}}change, MediaType.APPLICATION_JSON));
            }
        }
    }

    /** How many pages are listening (for monitoring and tests). */
    public int listening() {
        return listeners.size();
    }

    @Scheduled(fixedRate = 25_000)
    public void heartbeat() {
        for (Listener listener : listeners) send(listener, SseEmitter.event().comment("still here"));
    }

    private void send(Listener listener, SseEmitter.SseEventBuilder event) {
        try {
            listener.emitter().send(event);
        } catch (Exception gone) {
            // The page went away: forget it.
            listeners.remove(listener);
            listener.emitter().completeWithError(gone);
        }
    }
}
