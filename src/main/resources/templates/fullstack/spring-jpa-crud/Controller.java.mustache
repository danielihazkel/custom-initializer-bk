    private static final String[] CSV_HEADERS = {
{{#fields}}            "{{name}}",
{{/fields}}{{#relations}}            "{{fkFieldName}}",
{{#hasTargetLabel}}            "{{fieldName}}Label",
{{/hasTargetLabel}}{{/relations}}{{#collections}}            "{{fieldName}}",
{{/collections}}{{#auditApplicable}}            "createdAt",
            "updatedAt",
            "createdBy",
            "updatedBy",
{{/auditApplicable}}    };

    /** Minimal RFC-4180 CSV cell: null → empty, and quote when the value contains a comma, quote,
     *  or newline (doubling any embedded quote). */
    /** What a spreadsheet takes for the start of a formula. */
    private static final String FORMULA_STARTS = "=+-@";

    private static String csv(Object value) {
        if (value == null) return "";
        String s = String.valueOf(value);
        // A spreadsheet runs a cell that starts like a formula. Text that does is led by an
        // apostrophe, which makes it text there (and which the app's own import drops again);
        // numbers and dates are not text and stay as they are.
        if (value instanceof CharSequence && !s.isEmpty() && FORMULA_STARTS.indexOf(s.charAt(0)) >= 0) {
            s = "'" + s;
        }
        if (s.contains(",") || s.contains("\"") || s.contains("\n") || s.contains("\r")) {
            return "\"" + s.replace("\"", "\"\"") + "\"";
        }
        return s;
    }
