{{/filterFields}}            Pageable pageable) {
{{#hasFilters}}        {{EntityName}}Service.Filters filters = new {{EntityName}}Service.Filters({{#filterFields}}{{#isEnumFilter}}{{name}}{{/isEnumFilter}}{{#isBooleanFilter}}{{name}}{{/isBooleanFilter}}{{#isNumericFilter}}{{name}}Min, {{name}}Max{{/isNumericFilter}}{{#isTemporalFilter}}{{name}}From, {{name}}To{{/isTemporalFilter}}{{#isRelationFilter}}{{name}}{{/isRelationFilter}}{{^last}}, {{/last}}{{/filterFields}});
{{/hasFilters}}        Sort sort = sortOf(pageable);
        // Streamed in fixed-size chunks so memory stays bounded regardless of table size; each
        // chunk is its own read-only transaction, so no session is held open across the response.
        StreamingResponseBody stream = out -> {
            java.io.Writer w = new java.io.BufferedWriter(
                    new java.io.OutputStreamWriter(out, java.nio.charset.StandardCharsets.UTF_8));
            w.write('\uFEFF'); // UTF-8 BOM so Excel detects the encoding
            w.write(String.join(",", CSV_HEADERS));
            w.write("\r\n");
            int pageNo = 0;
            Page<{{EntityName}}Dto> chunk;
            do {
                chunk = service.findAll(q, {{#hasFilters}}filters, {{/hasFilters}}PageRequest.of(pageNo++, CSV_CHUNK_SIZE, sort))
                        .map({{EntityName}}Dto::from);
                for ({{EntityName}}Dto dto : chunk) {
