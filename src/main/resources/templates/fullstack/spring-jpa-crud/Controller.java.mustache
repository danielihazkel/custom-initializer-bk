    /** Rows fetched per chunk while streaming the CSV export. */
    private static final int CSV_CHUNK_SIZE = 500;

    private static final String[] CSV_HEADERS = {
{{#fields}}            "{{name}}",
{{/fields}}{{#relations}}            "{{fkFieldName}}",
{{#hasTargetLabel}}            "{{fieldName}}Label",
{{/hasTargetLabel}}{{/relations}}{{#auditApplicable}}            "createdAt",
            "updatedAt",
{{/auditApplicable}}    };

    /** Minimal RFC-4180 CSV cell: null → empty, and quote when the value contains a comma, quote,
     *  or newline (doubling any embedded quote). */
    private static String csv(Object value) {
        if (value == null) return "";
        String s = String.valueOf(value);
        if (s.contains(",") || s.contains("\"") || s.contains("\n") || s.contains("\r")) {
            return "\"" + s.replace("\"", "\"\"") + "\"";
        }
        return s;
    }
