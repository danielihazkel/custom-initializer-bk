    /** Sort keys accepted from {@code ?sort=}: every scalar column the DTO exposes. Anything else is
     *  rejected as a 400 (via ApiExceptionHandler) instead of surfacing Spring Data's
     *  PropertyReferenceException as a 500 — and it keeps sorting from walking into relations. */
    private static final List<String> SORTABLE = List.of(new String[] {
{{#fields}}            "{{name}}",
{{/fields}}{{#auditApplicable}}            "createdAt",
            "updatedAt",
{{/auditApplicable}}    });

    /** Stable default order when the client sends none: every primary-key column. */
    private static final Sort DEFAULT_SORT = Sort.by({{#pkFields}}"{{name}}"{{^last}}, {{/last}}{{/pkFields}}).ascending();

    private static Sort sortOf(Pageable pageable) {
        if (!pageable.getSort().isSorted()) {
            return DEFAULT_SORT;
        }
        for (Sort.Order order : pageable.getSort()) {
            if (!SORTABLE.contains(order.getProperty())) {
                throw new IllegalArgumentException(
                        "Unknown sort property '" + order.getProperty() + "'; sortable: " + SORTABLE);
            }
        }
        return pageable.getSort();
    }
