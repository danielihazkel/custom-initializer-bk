{{/fields}}{{#relations}}                            csv(dto.{{fkFieldName}}()),
{{#hasTargetLabel}}                            csv(dto.{{fieldName}}Label()),
{{/hasTargetLabel}}{{/relations}}{{#auditApplicable}}                            csv(dto.createdAt()),
                            csv(dto.updatedAt()),
{{/auditApplicable}}                    };
                    w.write(String.join(",", cells));
                    w.write("\r\n");
                }
            } while (chunk.hasNext());
            w.flush();
        };
        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"{{entityNamePluralKebab}}.csv\"")
                .contentType(MediaType.parseMediaType("text/csv; charset=UTF-8"))
