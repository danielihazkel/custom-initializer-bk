package {{packageName}}.web;

import jakarta.servlet.http.HttpServletRequest;
import org.springframework.web.context.request.RequestAttributes;
import org.springframework.web.context.request.RequestContextHolder;
import org.springframework.web.context.request.ServletRequestAttributes;

/**
 * Who is making the change now, for the audit columns{{#hasHistory}} and the change history{{/hasHistory}}{{#hasOutbox}} and the events{{/hasOutbox}}: the
 * {@code userinfo} header of the request being served (set by the SSO gateway; in development by
 * the frontend's API client); {@value #ANONYMOUS} for a request without one, {@value #SYSTEM}
 * outside a request — demo data, scheduled work.
 */
public final class RequestUser {

    /** The author of a change made outside any request. */
    public static final String SYSTEM = "system";

    /** The author of a change made by a request that named nobody. */
    public static final String ANONYMOUS = "anonymous";

    private RequestUser() {}

    public static String current() {
        RequestAttributes attributes = RequestContextHolder.getRequestAttributes();
        if (attributes instanceof ServletRequestAttributes servlet) {
            HttpServletRequest request = servlet.getRequest();
            String user = request.getHeader("userinfo");
            return user != null && !user.isBlank() ? user.trim() : ANONYMOUS;
        }
        return SYSTEM;
    }
}
