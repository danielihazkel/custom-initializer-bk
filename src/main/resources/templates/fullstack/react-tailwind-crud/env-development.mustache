# Left empty so the app calls same-origin /api/... and the Vite dev server proxies it to
# {{apiBaseUrl}} (see vite.config.ts) — no CORS involved. Set an absolute origin here only to
# bypass the proxy; the backend's app.cors.allowed-origins must then include http://localhost:5173.
VITE_API_BASE_URL=
{{#hasLdapAuth}}VITE_DEV_USERINFO=dev-user
{{/hasLdapAuth}}
