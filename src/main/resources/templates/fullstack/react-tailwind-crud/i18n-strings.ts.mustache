/** Both tables — for code that needs the other language. Exported so neither is an unused local
 *  (the generated lint rejects those, and only one of them is selected below). */
export const STRINGS = { en, he } as const

export type StringKey = keyof typeof en

/** BCP-47 tag of the generated locale — feed it to Intl / toLocale*String so dates follow the UI language. */
export const LOCALE = '{{locale}}'

const S: Record<StringKey, string> = {{#isHebrew}}he{{/isHebrew}}{{^isHebrew}}en{{/isHebrew}}

/** A chrome string by key, with any `{name}` placeholders filled from `params` (unknown ones are left as-is). */
export function t(key: StringKey, params?: Record<string, string | number>): string {
  const s = S[key]
  if (!params) return s
  return s.replace(/\{(\w+)\}/g, (match, name: string) => (name in params ? String(params[name]) : match))
}
