import { {{#usesEffect}}useEffect, {{/usesEffect}}useState } from 'react'
import { ScreenHeader } from '@shared/ui/ScreenHeader'
{{#parentIconImports}}
import { {{parentIconImports}} } from 'lucide-react'
{{/parentIconImports}}
{{#parentHasDrawer}}
import { toast } from 'sonner'
{{/parentHasDrawer}}
{{#parentUsesApi}}
import { api{{#parentHasDrawer}}, ApiError{{/parentHasDrawer}} } from '@shared/api'
{{/parentUsesApi}}
import { use{{parentEntityName}} } from '@entities/{{parentEntityNameKebab}}'
import type { {{parentEntityName}} } from '@entities/{{parentEntityNameKebab}}'
{{#parentFeatureImports}}
import { {{parentFeatureImports}} } from '@features/{{parentEntityNameKebab}}-form'
{{/parentFeatureImports}}
import { {{childEntityName}}Page } from '@pages/{{childEntityNameKebab}}'
import { Alert, EmptyState, Skeleton{{#parentHasDrawer}}, FormDrawer{{/parentHasDrawer}} } from '@shared/ui'
import { t } from '@shared/i18n'

interface Props {
  /** The selected parent's key, from the route (#/<page>/<id>) — absent when embedded as a tab. */
  selectedId?: string
  /** Moves the route to another parent; without it the selection is local state. */
  onSelect?: (id: string) => void
{{#needsNavigate}}
  onNavigate: (view: string, arg?: string) => void
{{/needsNavigate}}
}

const PAGE_SIZE = 20

/** How a parent row is named in the list: its first text field, else its key. */
const parentLabel = (row: {{parentEntityName}}) =>
{{#parentHasLabel}}
  row.{{parentLabelField}} == null || row.{{parentLabelField}} === '' ? '#' + String(row.{{parentPkName}}) : String(row.{{parentLabelField}})
{{/parentHasLabel}}
{{^parentHasLabel}}
  '#' + String(row.{{parentPkName}})
{{/parentHasLabel}}
{{#parentCreatesInDrawer}}

/** A new parent starts from its fields' defaults. */
const newParent = (): Partial<{{parentEntityName}}> => ({{{parentNewTs}}})
{{/parentCreatesInDrawer}}

export function {{PageName}}Screen({ selectedId: routeId, onSelect{{#needsNavigate}}, onNavigate{{/needsNavigate}} }: Props) {
  const [page, setPage] = useState(0)
{{#parentSearchable}}
  const [search, setSearch] = useState('')
  const [q, setQ] = useState('')
{{/parentSearchable}}
  // The selection lives in the URL when the shell routes this page, so Back/reload/links keep it.
  const [localId, setLocalId] = useState<string | undefined>(undefined)
  const selectedId = onSelect ? routeId : localId
  const select = (id: string) => (onSelect ? onSelect(id) : setLocalId(id))
{{#parentSearchable}}

  useEffect(() => {
    const timer = setTimeout(() => {
      setQ(search)
      setPage(0)
    }, 300)
    return () => clearTimeout(timer)
  }, [search])
{{/parentSearchable}}

  const { items, totalPages, pageNumber, loading, error, reload } =
    use{{parentEntityName}}({ page, size: PAGE_SIZE, sort: null, {{#parentSearchable}}q{{/parentSearchable}}{{^parentSearchable}}q: ''{{/parentSearchable}} })
{{#showParent}}
  // The selected parent's own details: from the loaded list page, else fetched by id (a reload, a link).
  const [fetchedParent, setFetchedParent] = useState<{{parentEntityName}} | null>(null)
  const [parentFailed, setParentFailed] = useState(false)
  const [parentAttempt, setParentAttempt] = useState(0)
  const parent = selectedId == null ? null
    : items.find(r => String(r.{{parentPkName}}) === selectedId) ?? (fetchedParent && String(fetchedParent.{{parentPkName}}) === selectedId ? fetchedParent : null)
  useEffect(() => {
    if (selectedId == null || items.some(r => String(r.{{parentPkName}}) === selectedId)) return
    let current = true
    setParentFailed(false)
    api.get<{{parentEntityName}}>(`/api/{{parentEntityNamePluralKebab}}/${encodeURIComponent(selectedId)}`)
      .then(r => { if (current) setFetchedParent(r) })
      .catch(() => { if (current) { setFetchedParent(null); setParentFailed(true) } })
    return () => { current = false }
  }, [selectedId, items, parentAttempt])
{{/showParent}}
{{#parentHasDrawer}}
  const [editing, setEditing] = useState<Partial<{{parentEntityName}}> | null>(null)
{{#parentCreatesInDrawer}}
{{#showParentEdit}}
  // New and Edit share the drawer; `creating` says which one it is.
  const [creating, setCreating] = useState(false)
{{/showParentEdit}}
{{/parentCreatesInDrawer}}
  const [formErrors, setFormErrors] = useState<Record<string, string>>({})
  const [saving, setSaving] = useState(false)

  /** Runs the client-side checks; false (with the messages shown) when the draft is not ready. */
  function checked(draft: Partial<{{parentEntityName}}>) {
    const clientErrors = validate{{parentEntityName}}(draft)
    if (Object.keys(clientErrors).length === 0) return true
    setFormErrors(clientErrors)
    toast.error(t('fixHighlighted'))
    return false
  }

  function saveFailed(e: unknown) {
    // A 400 carries per-field messages — show them inline; anything else is a toast.
    if (e instanceof ApiError && e.fieldErrors) {
      setFormErrors(e.fieldErrors)
      toast.error(t('fixHighlighted'))
    } else {
      toast.error(e instanceof Error ? e.message : String(e))
    }
  }
{{#parentCreatesInDrawer}}

  function openNew() {
    setFormErrors({})
{{#showParentEdit}}
    setCreating(true)
{{/showParentEdit}}
    setEditing(newParent())
  }

  async function createParent() {
    if (!editing || !checked(editing)) return
    setSaving(true)
    setFormErrors({})
    try {
      const created = await api.post<{{parentEntityName}}>('/api/{{parentEntityNamePluralKebab}}', editing)
      setEditing(null)
      toast.success(t('xCreated', { x: {{parentLabelExpr}} }))
      void reload()
      // Open the new parent, so its first rows can be added straight away.
      select(String(created.{{parentPkName}}))
    } catch (e) {
      saveFailed(e)
    } finally {
      setSaving(false)
    }
  }
{{/parentCreatesInDrawer}}
{{#showParentEdit}}

  async function saveParent() {
    if (!editing || selectedId == null || !checked(editing)) return
    setSaving(true)
    setFormErrors({})
    try {
      const saved = await api.put<{{parentEntityName}}>(`/api/{{parentEntityNamePluralKebab}}/${encodeURIComponent(selectedId)}`, editing)
      setFetchedParent(saved)
      setEditing(null)
      toast.success(t('xUpdated', { x: {{parentLabelExpr}} }))
      void reload()
    } catch (e) {
      saveFailed(e)
    } finally {
      setSaving(false)
    }
  }
{{/showParentEdit}}
{{/parentHasDrawer}}

  return (
    <div className="mx-auto max-w-7xl p-4 md:p-8">
      <div className="mb-6">
        <ScreenHeader title={ {{pageTitleExpr}} }{{#hasPageDescription}} description={ {{pageDescriptionExpr}} }{{/hasPageDescription}} />
      </div>
      <div className="grid grid-cols-1 gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <aside className="self-start overflow-hidden rounded-2xl border border-border bg-surface shadow-sm">
{{#parentCreatable}}
          <div className="flex items-center justify-between gap-2 border-b border-border px-4 py-3">
            <span className="text-sm font-semibold text-fg">{ {{parentLabelPluralExpr}} }</span>
            <button
              type="button"
              onClick={ {{#parentCreatesInPage}}() => onNavigate('{{parentCreatePageId}}'){{/parentCreatesInPage}}{{#parentCreatesInDrawer}}openNew{{/parentCreatesInDrawer}} }
              className="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"
            >
              <Plus className="h-3.5 w-3.5" />
              {t('newX', { x: {{parentLabelExpr}} })}
            </button>
          </div>
{{/parentCreatable}}
{{^parentCreatable}}
          <div className="border-b border-border px-4 py-3 text-sm font-semibold text-fg">{ {{parentLabelPluralExpr}} }</div>
{{/parentCreatable}}
{{#parentSearchable}}
          <div className="border-b border-border p-3">
            <input
              type="search"
              value={search}
              onChange={e => setSearch(e.target.value)}
              placeholder={t('search')}
              aria-label={t('search')}
              className="w-full rounded-lg border border-border bg-canvas px-3 py-2 text-sm text-fg placeholder:text-muted focus:border-brand focus:outline-none"
            />
          </div>
{{/parentSearchable}}
          {error && (
            <div className="p-3">
              <Alert>
                {error}{' '}
                <button type="button" onClick={() => { void reload() }} className="font-medium underline">{t('retry')}</button>
              </Alert>
            </div>
          )}
          {loading && items.length === 0 && !error && (
            <div className="space-y-3 p-4" aria-busy="true">
              <Skeleton className="h-4 w-3/4" />
              <Skeleton className="h-4 w-2/3" />
              <Skeleton className="h-4 w-4/5" />
            </div>
          )}
          <ul className={`max-h-[60vh] divide-y divide-border overflow-auto transition-opacity ${loading ? 'opacity-60' : ''}`}>
            {items.map(row => {
              const active = selectedId === String(row.{{parentPkName}})
              return (
                <li key={String(row.{{parentPkName}})} className="flex items-center">
                  <button
                    type="button"
                    onClick={() => select(String(row.{{parentPkName}}))}
                    aria-pressed={active}
                    className={`min-w-0 flex-1 truncate px-4 py-2.5 text-start text-sm transition-colors ${
                      active ? 'bg-brand/10 font-medium text-fg' : 'text-muted hover:bg-surface-2 hover:text-fg'
                    }`}
                  >
                    {parentLabel(row)}
                  </button>
{{#parentHasRecordPage}}
                  <button
                    type="button"
                    onClick={() => onNavigate('{{parentRecordPageId}}', String(row.{{parentRecordPk}}))}
                    title={t('openX', { x: parentLabel(row) })}
                    aria-label={t('openX', { x: parentLabel(row) })}
                    className="me-2 rounded-md p-1.5 text-muted transition-colors hover:bg-surface-2 hover:text-brand"
                  >
                    <ArrowUpRight className="h-4 w-4 rtl:-scale-x-100" />
                  </button>
{{/parentHasRecordPage}}
                </li>
              )
            })}
            {!loading && items.length === 0 && (
              <li className="px-4 py-6 text-center text-sm text-muted">{t('noResults')}</li>
            )}
          </ul>
          {totalPages > 1 && (
            <div className="flex items-center justify-between border-t border-border px-3 py-2 text-xs text-muted">
              <button
                type="button"
                disabled={pageNumber === 0}
                onClick={() => setPage(pageNumber - 1)}
                className="rounded px-2 py-1 transition-colors hover:text-fg disabled:opacity-40"
              >
                {t('prev')}
              </button>
              <span className="tabular-nums">{pageNumber + 1} / {totalPages}</span>
              <button
                type="button"
                disabled={pageNumber >= totalPages - 1}
                onClick={() => setPage(pageNumber + 1)}
                className="rounded px-2 py-1 transition-colors hover:text-fg disabled:opacity-40"
              >
                {t('next')}
              </button>
            </div>
          )}
        </aside>
        <section className="min-w-0 rounded-2xl border border-border bg-surface shadow-sm">
          {selectedId ? (
{{#showParent}}
            <>
              <div className="border-b border-border p-5" data-parent-card>
                <div className="mb-3 flex items-start justify-between gap-3">
                  <h2 className="text-sm font-semibold text-fg">{parent ? parentLabel(parent) : {{parentLabelExpr}} }</h2>
{{#showParentEdit}}
                  {parent && (
                    <button
                      type="button"
                      onClick={() => { setFormErrors({}); {{#parentCreatesInDrawer}}setCreating(false); {{/parentCreatesInDrawer}}setEditing({ ...parent }) }}
                      className="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"
                    >
                      <Pencil className="h-3.5 w-3.5" />
                      {t('edit')}
                    </button>
                  )}
{{/showParentEdit}}
                </div>
                {parent ? <{{parentEntityName}}Detail value={parent} /> : parentFailed ? (
                  <p className="text-sm text-muted" role="alert">
                    {t('couldNotLoad')}{' '}
                    <button type="button" onClick={() => setParentAttempt(a => a + 1)} className="font-medium text-brand hover:underline">{t('retry')}</button>
                  </p>
                ) : <Skeleton className="h-4 w-1/2" />}
              </div>
{{/showParent}}
            <{{childEntityName}}Page
              key={selectedId}
              embedded
              scope={ { param: '{{viaParam}}', value: {{#parentPkIsNumber}}Number(selectedId){{/parentPkIsNumber}}{{^parentPkIsNumber}}selectedId{{/parentPkIsNumber}} } }
{{#childHasColumns}}
              columns={ {{{childColumnsTs}}} }
{{/childHasColumns}}
{{#childHasSort}}
              initialSort={ {{{childSortTs}}} }
{{/childHasSort}}
{{#childHasRecordPage}}
              onOpenRecord={r => onNavigate('{{childRecordPageId}}', String(r.{{childRecordPk}}))}
{{/childHasRecordPage}}
            />
{{#showParent}}
            </>
{{/showParent}}
          ) : (
            <EmptyState
              title={ {{parentLabelPluralExpr}} }
              hint={t('pickXToSeeY', { x: {{parentLabelPluralExpr}}, y: {{childLabelPluralExpr}} })}
            />
          )}
        </section>
      </div>
{{#parentHasDrawer}}
      <FormDrawer
        open={editing !== null}
{{#parentCreatesInDrawer}}
{{#showParentEdit}}
        title={creating ? t('newX', { x: {{parentLabelExpr}} }) : t('editX', { x: {{parentLabelExpr}} })}
        subtitle={creating ? t('createXBlurb', { x: {{parentLabelExpr}} }) : t('updateXBlurb', { x: {{parentLabelExpr}} })}
        onClose={() => setEditing(null)}
        onSave={creating ? createParent : saveParent}
        saving={saving}
        dirty={editing !== null && JSON.stringify(editing) !== JSON.stringify(creating ? newParent() : parent)}
{{/showParentEdit}}
{{^showParentEdit}}
        title={t('newX', { x: {{parentLabelExpr}} })}
        subtitle={t('createXBlurb', { x: {{parentLabelExpr}} })}
        onClose={() => setEditing(null)}
        onSave={createParent}
        saving={saving}
        dirty={editing !== null && JSON.stringify(editing) !== JSON.stringify(newParent())}
{{/showParentEdit}}
{{/parentCreatesInDrawer}}
{{^parentCreatesInDrawer}}
        title={t('editX', { x: {{parentLabelExpr}} })}
        subtitle={t('updateXBlurb', { x: {{parentLabelExpr}} })}
        onClose={() => setEditing(null)}
        onSave={saveParent}
        saving={saving}
        dirty={editing !== null && JSON.stringify(editing) !== JSON.stringify(parent)}
{{/parentCreatesInDrawer}}
      >
        {editing && (
          <{{parentEntityName}}Form
            value={editing}
            onChange={next => {
              // Clear the message of a field as soon as it is edited.
              const before = editing as Record<string, unknown>
              const after = next as Record<string, unknown>
              const changed = Object.keys(after).filter(k => after[k] !== before[k] && k in formErrors)
              if (changed.length > 0) {
                setFormErrors(prev => {
                  const copy = { ...prev }
                  for (const k of changed) delete copy[k]
                  return copy
                })
              }
              setEditing(next)
            }}
            errors={formErrors}
            isNew={ {{#parentCreatesInDrawer}}{{#showParentEdit}}creating{{/showParentEdit}}{{^showParentEdit}}true{{/showParentEdit}}{{/parentCreatesInDrawer}}{{^parentCreatesInDrawer}}false{{/parentCreatesInDrawer}} }
          />
        )}
      </FormDrawer>
{{/parentHasDrawer}}
    </div>
  )
}
