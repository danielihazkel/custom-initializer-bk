          <option value="">—</option>
          { {{enumTypeName}}Values.map(v => <option key={v} value={v}>{v}</option>) }
        </select>
      </Field>
{{/isEnum}}{{^isBoolean}}{{^isEnum}}      <Field label="{{Name}}"{{#isRequired}} required{{/isRequired}} error={errors?.{{name}}}>
{{#isText}}        <textarea
          className={`${inputClass} min-h-[96px] resize-y`}
          value={value.{{name}} == null ? '' : String(value.{{name}})}
          onChange={e => set('{{name}}', e.target.value === '' ? null : e.target.value)}
        />
{{/isText}}{{^isText}}        <input
          className={inputClass}
          {{#isNumeric}}type="number"{{/isNumeric}}{{#isDate}}type="date"{{/isDate}}{{#isDateTime}}type="datetime-local"{{/isDateTime}}{{^isNumeric}}{{^isTemporal}}{{#isEmail}}type="email"{{/isEmail}}{{^isEmail}}type="text"{{/isEmail}}{{/isTemporal}}{{/isNumeric}}{{#isNumeric}}{{#hasMin}} min="{{min}}"{{/hasMin}}{{#hasMax}} max="{{max}}"{{/hasMax}}{{/isNumeric}}{{#hasPattern}} pattern={"{{patternEscaped}}"}{{/hasPattern}}
          value={value.{{name}} == null ? '' : String(value.{{name}})}
          onChange={e => set('{{name}}', {{#isNumeric}}e.target.value === '' ? null : Number(e.target.value){{/isNumeric}}{{^isNumeric}}e.target.value === '' ? null : e.target.value{{/isNumeric}})}
        />
{{/isText}}      </Field>
{{/isEnum}}{{/isBoolean}}{{/isPrimaryKey}}
{{/fields}}
{{#relations}}
      <Field label="{{FieldName}}"{{#required}} required{{/required}} error={errors?.{{fkFieldName}}}>
        <select
          className={inputClass}
          value={value.{{fkFieldName}} == null ? '' : String(value.{{fkFieldName}})}
          onChange={e => set('{{fkFieldName}}', e.target.value === '' ? null : {{#isTargetPkNumeric}}Number(e.target.value){{/isTargetPkNumeric}}{{^isTargetPkNumeric}}e.target.value{{/isTargetPkNumeric}})}
