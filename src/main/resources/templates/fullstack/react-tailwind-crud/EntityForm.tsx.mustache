          <option value="">—</option>
          <option value="true">True</option>
          <option value="false">False</option>
        </select>
      </Field>
{{/isBoolean}}{{#isEnum}}      <Field label="{{Name}}"{{#isRequired}} required{{/isRequired}} error={errors?.{{name}}}>
        <select
