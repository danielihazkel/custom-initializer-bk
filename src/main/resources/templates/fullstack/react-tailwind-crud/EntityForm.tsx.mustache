import { Field, inputClass } from '@shared/ui'
{{#hasRelations}}import { useOptions } from '@shared/api'
{{/hasRelations}}import type { {{EntityName}}{{#fields}}{{#isEnum}}, {{enumTypeName}}{{/isEnum}}{{/fields}} } from '@entities/{{entityNameKebab}}'
{{#fields}}{{#isEnum}}import { {{enumTypeName}}Values } from '@entities/{{entityNameKebab}}'
{{/isEnum}}{{/fields}}

interface Props {
  value: Partial<{{EntityName}}>
  onChange: (next: Partial<{{EntityName}}>) => void
  errors?: Record<string, string>
  isNew: boolean
}

export function {{EntityName}}Form({ value, onChange, errors, isNew }: Props) {
  const set = (k: keyof {{EntityName}}, v: unknown) => onChange({ ...value, [k]: v })
{{#relations}}  const {{fieldName}}Options = useOptions<Record<string, unknown>>('/api/{{targetEntityKebabPlural}}')
{{/relations}}
  return (
    <>
{{#fields}}
{{#isPrimaryKey}}{{#isGenerated}}      {!isNew && (
        <Field label="{{Name}}" hint="System-generated, read-only">
          <input
            className={`${inputClass} cursor-not-allowed bg-surface-2 text-muted`}
            value={String(value.{{name}} ?? '')}
            disabled
          />
        </Field>
      )}
{{/isGenerated}}{{^isGenerated}}      <Field label="{{Name}}"{{#isRequired}} required{{/isRequired}} error={errors?.{{name}}}>
        <input
          className={isNew ? inputClass : `${inputClass} cursor-not-allowed bg-surface-2 text-muted`}
          value={value.{{name}} == null ? '' : String(value.{{name}})}
          onChange={e => set('{{name}}', {{#isNumeric}}e.target.value === '' ? null : Number(e.target.value){{/isNumeric}}{{^isNumeric}}e.target.value{{/isNumeric}})}
          {{#isNumeric}}type="number"{{/isNumeric}}{{^isNumeric}}type="text"{{/isNumeric}}
          disabled={!isNew}
        />
      </Field>
{{/isGenerated}}{{/isPrimaryKey}}
{{^isPrimaryKey}}{{#isBoolean}}      <Field label="{{Name}}"{{#isRequired}} required{{/isRequired}} error={errors?.{{name}}}>
        <select
          className={inputClass}
          value={value.{{name}} == null ? '' : String(value.{{name}})}
          onChange={e => set('{{name}}', e.target.value === '' ? null : e.target.value === 'true')}
