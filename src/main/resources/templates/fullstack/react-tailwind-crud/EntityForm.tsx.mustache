          { {{fieldName}}Options.options.map(o => (
            <option key={String(o.{{targetPkName}})} value={String(o.{{targetPkName}})}>
              {{#hasTargetLabel}}{`${String(o.{{targetLabelField}} ?? '')} (#${String(o.{{targetPkName}})})`}{{/hasTargetLabel}}{{^hasTargetLabel}}{String(o.{{targetPkName}})}{{/hasTargetLabel}}
            </option>
          )) }
        </select>
      </Field>
{{/relations}}
    </>
  )
}
