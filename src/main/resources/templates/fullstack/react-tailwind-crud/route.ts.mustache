import { useEffect, useState } from 'react'
{{#hasListStatePages}}
import type { FilterValues, ListState } from '@shared/ui'
{{/hasListStatePages}}

/** Every page the shell can show: the nav pages, plus record pages (opened with an id). */
export type View = {{#routePages}}{{^-first}} | {{/-first}}'{{pageId}}'{{/routePages}}

const VIEWS: readonly View[] = [{{#routePages}}{{^-first}}, {{/-first}}'{{pageId}}'{{/routePages}}]
{{#hasRecordPages}}
const RECORD_VIEWS: readonly View[] = [{{#recordPages}}{{^-first}}, {{/-first}}'{{pageId}}'{{/recordPages}}]
{{/hasRecordPages}}

/** Where the app is, as the URL hash spells it: #/<page>[/<arg>][?<field>=<value>&…]. */
export interface Route {
  view: View
  /** A record page's record id, or the open tab of a tabs page. */
  arg?: string
  /** The filters a list page opens with. */
  query: Record<string, string>
  /** Set when the hash names a page this app does not have; the shell says so. */
  notFound?: string
}

function decode(part: string): string {
  try {
    return decodeURIComponent(part)
  } catch {
    return part
  }
}

/** No page opens the start page; an unknown one is flagged as not found{{#hasRecordPages}}, and a record page without an id falls back to the start page{{/hasRecordPages}}. */
export function parseRoute(hash: string): Route {
  const [path, search = ''] = hash.replace(/^#\/?/, '').split('?')
  const [id, ...rest] = path.split('/')
  const view = VIEWS.find(v => v === decode(id))
  const arg = rest.join('/') !== '' ? decode(rest.join('/')) : undefined
  if (!view) return id === '' ? { view: '{{initialPageId}}', query: {} } : { view: '{{initialPageId}}', query: {}, notFound: decode(id) }
{{#hasRecordPages}}
  if (RECORD_VIEWS.includes(view) && !arg) return { view: '{{initialPageId}}', query: {} }
{{/hasRecordPages}}
  return { view, arg, query: Object.fromEntries(new URLSearchParams(search)) }
}

export function toHash({ view, arg, query }: Route): string {
  const search = new URLSearchParams(query).toString()
  return `#/${view}${arg ? `/${encodeURIComponent(arg)}` : ''}${search ? `?${search}` : ''}`
}

/**
 * The current route, kept in step with the URL hash — so Back/Forward, a reload and a bookmark all
 * land on the page they name — a way to move to another, and a way to rewrite the current one.
 */
export function useRoute(): [Route, (next: Route) => void, (next: Route) => void] {
  const [route, setRoute] = useState<Route>(() => parseRoute(window.location.hash))
  useEffect(() => {
    const onHashChange = () => setRoute(parseRoute(window.location.hash))
    window.addEventListener('hashchange', onHashChange)
    return () => window.removeEventListener('hashchange', onHashChange)
  }, [])
  const navigate = (next: Route) => {
    window.location.hash = toHash(next)
    setRoute(next)
  }
  // For screen state that changes with every click (a period, a filter): the current history
  // entry is rewritten, so Back still leaves the page. replaceState fires no hashchange.
  const replace = (next: Route) => {
    window.history.replaceState(null, '', toHash(next))
    setRoute(next)
  }
  return [route, navigate, replace]
}
{{#hasListStatePages}}

/**
 * A list page's state as its route query spells it: its filters under their own names, the rest
 * under `_`-prefixed keys (`_q`, `_sort` = `field` or `-field`, `_page` from 1, `_size`, `_view`).
 */
export function listStateOf(query: Record<string, string>): ListState {
  const filters: FilterValues = {}
  for (const [k, v] of Object.entries(query)) if (!k.startsWith('_')) filters[k] = v
  const sort = query._sort
  const page = Number(query._page)
  const size = Number(query._size)
  return {
    q: query._q || undefined,
    sort: sort === undefined ? undefined : sort === '' ? null : { field: sort.replace(/^-/, ''), direction: sort.startsWith('-') ? 'desc' : 'asc' },
    page: page >= 1 ? Math.floor(page) - 1 : undefined,
    size: size >= 1 ? Math.floor(size) : undefined,
    view: query._view || undefined,
    filters,
  }
}

/** The route query for a list's state; a filter still at the page's preset is left out, and one
 *  cleared from it is kept (blank) so it stays cleared. */
export function listQueryOf(state: ListState, preset: FilterValues = {}): Record<string, string> {
  const out: Record<string, string> = {}
  for (const [k, v] of Object.entries(state.filters ?? {})) {
    if (preset[k] === v) continue
    if (v !== '' || preset[k] != null) out[k] = v
  }
  if (state.q) out._q = state.q
  if (state.sort !== undefined) out._sort = state.sort == null ? '' : `${state.sort.direction === 'desc' ? '-' : ''}${state.sort.field}`
  if (state.page) out._page = String(state.page + 1)
  if (state.size) out._size = String(state.size)
  if (state.view) out._view = state.view
  return out
}
{{/hasListStatePages}}
