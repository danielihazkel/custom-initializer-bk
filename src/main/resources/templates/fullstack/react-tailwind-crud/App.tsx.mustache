{{^hasPages}}
import { useState } from 'react'
{{/hasPages}}
{{#hasPages}}
import { {{^navTopbar}}useState, {{/navTopbar}}useEffect, useRef } from 'react'
{{/hasPages}}
import type { LucideIcon } from 'lucide-react'
{{^hasPages}}
import { LayoutDashboard, Menu, Moon, Sun, Table2 } from 'lucide-react'
{{/hasPages}}
{{#hasPages}}
import { {{navIconImports}} } from 'lucide-react'
{{/hasPages}}
import { Toaster } from 'sonner'
import { useTheme } from '@shared/ui'
import { t } from '@shared/i18n'
{{^hasPages}}
import { DashboardPage } from '@pages/dashboard'
{{#entities}}
import { {{EntityName}}Page } from '@pages/{{entityNameKebab}}'
{{/entities}}

type View = 'dashboard'{{#entities}} | '{{entityNameKebab}}'{{/entities}}

const NAV: { id: View; label: string; icon: LucideIcon }[] = [
  { id: 'dashboard', label: t('dashboard'), icon: LayoutDashboard },
{{#entities}}
  { id: '{{entityNameKebab}}', label: '{{entityLabelPlural}}', icon: Table2 },
{{/entities}}
]

export default function App() {
  const [view, setView] = useState<View>('dashboard')
  const [navOpen, setNavOpen] = useState(false)
  const { isDark, toggle } = useTheme()
  const current = NAV.find(n => n.id === view)

  const go = (id: View) => {
    setView(id)
    setNavOpen(false)
  }

  const sidebar = (
    <>
      <div className="flex items-center gap-2.5 border-b border-white/10 px-5 py-5">
        <div className="flex h-9 w-9 items-center justify-center rounded-lg bg-white p-1.5 shadow-sm">
          <img src="/logo.png" alt="{{artifactId}}" className="h-full w-auto" />
        </div>
        <div className="leading-tight">
          <div className="font-semibold tracking-tight">{{artifactId}}</div>
          <div className="text-[11px] uppercase tracking-wider text-slate-400">{t('admin')}</div>
        </div>
      </div>
      <nav className="flex-1 space-y-0.5 px-3 py-4">
        <div className="px-2 pb-2 text-[10px] font-semibold uppercase tracking-wider text-slate-500">{t('main')}</div>
        {NAV.map(({ id, label, icon: Icon }) => {
          const active = view === id
          return (
            <button
              key={id}
              onClick={() => go(id)}
              aria-current={active ? 'page' : undefined}
              className={`flex w-full items-center gap-3 rounded-lg border-s-2 px-3 py-2 text-sm transition-colors ${
                active
                  ? 'border-gold bg-ink-soft font-medium text-white'
                  : 'border-transparent text-slate-300 hover:bg-ink-soft hover:text-white'
              }`}
            >
              <Icon className={`h-4 w-4 ${active ? 'text-gold' : ''}`} />
              {label}
            </button>
          )
        })}
      </nav>
      <div className="border-t border-white/10 px-5 py-3 text-[11px] text-white/70">
        v0.0.1
      </div>
    </>
  )

  return (
    <div className="flex h-full bg-canvas text-fg">
      {/* Static sidebar (tablet and up) */}
      <aside className="hidden w-64 flex-col bg-app-shell text-slate-100 md:flex">
        {sidebar}
      </aside>

      {/* Off-canvas sidebar (mobile) */}
      <div className={`fixed inset-0 z-40 md:hidden ${navOpen ? '' : 'pointer-events-none'}`}>
        <div
          className={`absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity duration-200 ${
            navOpen ? 'opacity-100' : 'opacity-0'
          }`}
          onClick={() => setNavOpen(false)}
        />
        <aside
          className={`absolute start-0 top-0 flex h-full w-64 flex-col bg-app-shell text-slate-100 shadow-2xl transition-transform duration-200 ease-out ${
            navOpen ? 'translate-x-0' : '-translate-x-full rtl:translate-x-full'
          }`}
        >
          {sidebar}
        </aside>
      </div>

      <div className="flex flex-1 flex-col overflow-hidden">
        <header className="flex items-center justify-between border-b border-border bg-surface px-4 py-3.5 md:px-8">
          <div className="flex items-center gap-3">
            <button
              onClick={() => setNavOpen(true)}
              className="-ms-1 rounded-lg p-2 text-muted transition-colors hover:bg-surface-2 hover:text-fg md:hidden"
              aria-label={t('openNav')}
            >
              <Menu className="h-5 w-5" />
            </button>
            <div>
              <div className="text-[11px] uppercase tracking-wider text-muted">{{artifactId}}</div>
              <h1 className="text-sm font-semibold text-fg">{current?.label ?? t('dashboard')}</h1>
            </div>
          </div>
          <button
            onClick={toggle}
            className="rounded-lg border border-border p-2 text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            title={isDark ? t('switchToLight') : t('switchToDark')}
            aria-label={t('toggleTheme')}
          >
            {isDark ? <Sun className="h-4 w-4" /> : <Moon className="h-4 w-4" />}
          </button>
        </header>

        <main className="flex-1 overflow-auto bg-canvas">
          {view === 'dashboard' && <DashboardPage onNavigate={v => go(v as View)} />}
{{#entities}}
          {view === '{{entityNameKebab}}' && <{{EntityName}}Page />}
{{/entities}}
        </main>
      </div>

      <Toaster richColors position={ {{#isRtl}}'top-left'{{/isRtl}}{{^isRtl}}'top-right'{{/isRtl}} } theme={isDark ? 'dark' : 'light'} />
    </div>
  )
}
{{/hasPages}}
{{#hasPages}}
import { useRoute, type View } from '@app/route'
{{#hasPageRoles}}
import { canSee, useRoles } from '@app/access'
{{/hasPageRoles}}
{{#routePages}}
import { {{PageName}}Screen } from '@app/screens/{{PageName}}Screen'
{{/routePages}}

interface NavItem {
  id: View
  label: string
  icon: LucideIcon
}

// The nav, section by section (a section without a label is a run of ungrouped pages).
const NAV_SECTIONS: { label: string; items: NavItem[] }[] = [
{{#navGroups}}
  {
    label: {{groupLabelExpr}},
    items: [
{{#items}}
      { id: '{{pageId}}', label: {{pageTitleExpr}}, icon: {{navIcon}} },
{{/items}}
    ],
  },
{{/navGroups}}
]
const NAV = NAV_SECTIONS.flatMap(section => section.items)
{{#hasOffNavPages}}

// Record pages open from a row (with its id) and stay out of the nav; the header still names them.
const RECORD_TITLES: Partial<Record<View, string>> = {
{{#offNavPages}}
  '{{pageId}}': {{pageTitleExpr}},
{{/offNavPages}}
}
{{/hasOffNavPages}}
{{#hasBreadcrumbs}}

// Where an off-nav page belongs: its entity's home page, shown as a breadcrumb in the header.
const RECORD_PARENTS: Partial<Record<View, View>> = {
{{#crumbPages}}
  '{{pageId}}': '{{backPageId}}',
{{/crumbPages}}
}
{{/hasBreadcrumbs}}

/** A whole-page message with one way out: an unknown page, or one this user may not open. */
function PageNotice({ title, hint, action, onAction }: { title: string; hint: string; action: string; onAction: () => void }) {
  return (
    <div className="mx-auto flex max-w-md flex-col items-center gap-3 p-10 text-center" role="alert">
      <h2 className="text-lg font-semibold text-fg">{title}</h2>
      <p className="text-sm text-muted">{hint}</p>
      <button
        type="button"
        onClick={onAction}
        className="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-sm transition-colors hover:bg-primary-deep"
      >
        {action}
      </button>
    </div>
  )
}

export default function App() {
  const [route, navigate{{#hasQueryScreens}}, replace{{/hasQueryScreens}}] = useRoute()
{{^navTopbar}}
  const [navOpen, setNavOpen] = useState(false)
{{/navTopbar}}
  const { isDark, toggle } = useTheme()
  const { view } = route
  // A new page starts at its top, not at the scroll offset the last one was left at.
  const mainRef = useRef<HTMLElement>(null)
  useEffect(() => {
    mainRef.current?.scrollTo(0, 0)
    window.scrollTo(0, 0)
  }, [view])
  const current = NAV.find(n => n.id === view)
{{#hasPageRoles}}
  // Pages restricted to roles leave the nav, and their route shows a notice, for other users.
  const roles = useRoles()
  const sections = NAV_SECTIONS.map(s => ({ ...s, items: s.items.filter(i => canSee(i.id, roles)) })).filter(s => s.items.length > 0)
{{/hasPageRoles}}
{{^hasPageRoles}}
  const sections = NAV_SECTIONS
{{/hasPageRoles}}
{{#hasBreadcrumbs}}
  const parentId = RECORD_PARENTS[view]
  const crumb = parentId ? NAV.find(n => n.id === parentId) : undefined
{{/hasBreadcrumbs}}

  const go = (id: View, arg?: string, query: Record<string, string> = {}) => {
    navigate({ view: id, arg, query })
{{^navTopbar}}
    setNavOpen(false)
{{/navTopbar}}
  }
{{#hasNavigatingScreens}}

  // Screens navigate by page id; a record page also takes the record's key, a list page its filters.
  const goView = (v: string, arg?: string, query?: Record<string, string>) => go(v as View, arg, query)
{{/hasNavigatingScreens}}
{{#hasQueryScreens}}

  // A screen's own state that belongs in the URL (a dashboard's period, a report's filters)
  // rewrites the current entry rather than adding one, so Back still leaves the page.
  const setQuery = (query: Record<string, string>) => replace({ ...route, query })
{{/hasQueryScreens}}

{{^navTopbar}}
  const sidebar = (
    <>
      <div className="flex items-center gap-2.5 border-b border-white/10 px-5 py-5">
        <div className="flex h-9 w-9 items-center justify-center rounded-lg bg-white p-1.5 shadow-sm">
          <img src="/logo.png" alt="{{artifactId}}" className="h-full w-auto" />
        </div>
        <div className="leading-tight">
          <div className="font-semibold tracking-tight">{{artifactId}}</div>
          <div className="text-[11px] uppercase tracking-wider text-slate-400">{t('admin')}</div>
        </div>
      </div>
      <nav className="flex-1 space-y-4 overflow-y-auto px-3 py-4">
{{^navCollapsibleGroups}}
        {sections.map((section, i) => (
          <div key={i} className="space-y-0.5">
            {section.label && (
              <div className="px-2 pb-2 text-[10px] font-semibold uppercase tracking-wider text-slate-500">{section.label}</div>
            )}
            {section.items.map(({ id, label, icon: Icon }) => {
              const active = view === id
              return (
                <a
                  key={id}
                  href={`#/${id}`}
                  onClick={e => {
                    e.preventDefault()
                    go(id)
                  }}
                  aria-current={active ? 'page' : undefined}
                  className={`flex w-full items-center gap-3 rounded-lg border-s-2 px-3 py-2 text-sm transition-colors ${
                    active
                      ? 'border-gold bg-ink-soft font-medium text-white'
                      : 'border-transparent text-slate-300 hover:bg-ink-soft hover:text-white'
                  }`}
                >
                  <Icon className={`h-4 w-4 ${active ? 'text-gold' : ''}`} />
                  {label}
                </a>
              )
            })}
          </div>
        ))}
{{/navCollapsibleGroups}}
{{#navCollapsibleGroups}}
        {sections.map((section, i) => {
          // A labelled section folds; a run of ungrouped pages has nothing to fold under.
          const links = section.items.map(({ id, label, icon: Icon }) => {
            const active = view === id
            return (
              <a
                key={id}
                href={`#/${id}`}
                onClick={e => {
                  e.preventDefault()
                  go(id)
                }}
                aria-current={active ? 'page' : undefined}
                className={`flex w-full items-center gap-3 rounded-lg border-s-2 px-3 py-2 text-sm transition-colors ${
                  active
                    ? 'border-gold bg-ink-soft font-medium text-white'
                    : 'border-transparent text-slate-300 hover:bg-ink-soft hover:text-white'
                }`}
              >
                <Icon className={`h-4 w-4 ${active ? 'text-gold' : ''}`} />
                {label}
              </a>
            )
          })
          return section.label ? (
            <details key={i} open className="space-y-0.5">
              <summary className="cursor-pointer select-none px-2 pb-2 text-[10px] font-semibold uppercase tracking-wider text-slate-500">{section.label}</summary>
              {links}
            </details>
          ) : (
            <div key={i} className="space-y-0.5">{links}</div>
          )
        })}
{{/navCollapsibleGroups}}
      </nav>
      <div className="border-t border-white/10 px-5 py-3 text-[11px] text-white/70">
        v0.0.1
      </div>
    </>
  )
{{/navTopbar}}

  return (
    <div className="flex h-full bg-canvas text-fg">
{{^navTopbar}}
      {/* Static sidebar (tablet and up) */}
      <aside className="hidden w-64 flex-col bg-app-shell text-slate-100 md:flex">
        {sidebar}
      </aside>

      {/* Off-canvas sidebar (mobile) */}
      <div className={`fixed inset-0 z-40 md:hidden ${navOpen ? '' : 'pointer-events-none'}`}>
        <div
          className={`absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity duration-200 ${
            navOpen ? 'opacity-100' : 'opacity-0'
          }`}
          onClick={() => setNavOpen(false)}
        />
        <aside
          className={`absolute start-0 top-0 flex h-full w-64 flex-col bg-app-shell text-slate-100 shadow-2xl transition-transform duration-200 ease-out ${
            navOpen ? 'translate-x-0' : '-translate-x-full rtl:translate-x-full'
          }`}
        >
          {sidebar}
        </aside>
      </div>
{{/navTopbar}}

      <div className="flex flex-1 flex-col overflow-hidden">
{{#navTopbar}}
        {/* Top bar: the brand, then every nav section in a row that scrolls sideways on a phone. */}
        <div className="bg-app-shell text-slate-100">
          <div className="flex items-center gap-4 px-4 md:px-8">
            <div className="flex shrink-0 items-center gap-2.5 py-2.5">
              <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-white p-1 shadow-sm">
                <img src="/logo.png" alt="{{artifactId}}" className="h-full w-auto" />
              </div>
              <div className="font-semibold tracking-tight">{{artifactId}}</div>
            </div>
            <nav className="flex min-w-0 flex-1 items-stretch gap-1 overflow-x-auto" aria-label={t('navigation')}>
              {sections.map((section, i) => (
                <div key={i} className="flex items-stretch gap-1">
                  {section.label && (
                    <span className="self-center whitespace-nowrap ps-2 pe-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">{section.label}</span>
                  )}
                  {section.items.map(({ id, label, icon: Icon }) => {
                    const active = view === id
                    return (
                      <a
                        key={id}
                        href={`#/${id}`}
                        onClick={e => {
                          e.preventDefault()
                          go(id)
                        }}
                        aria-current={active ? 'page' : undefined}
                        className={`flex items-center gap-2 whitespace-nowrap border-b-2 px-3 py-3 text-sm transition-colors ${
                          active ? 'border-gold font-medium text-white' : 'border-transparent text-slate-300 hover:text-white'
                        }`}
                      >
                        <Icon className={`h-4 w-4 ${active ? 'text-gold' : ''}`} />
                        {label}
                      </a>
                    )
                  })}
                </div>
              ))}
            </nav>
          </div>
        </div>
{{/navTopbar}}
        <header className="flex items-center justify-between border-b border-border bg-surface px-4 py-3.5 md:px-8">
          <div className="flex items-center gap-3">
{{^navTopbar}}
            <button
              onClick={() => setNavOpen(true)}
              className="-ms-1 rounded-lg p-2 text-muted transition-colors hover:bg-surface-2 hover:text-fg md:hidden"
              aria-label={t('openNav')}
            >
              <Menu className="h-5 w-5" />
            </button>
{{/navTopbar}}
            <div>
{{#hasBreadcrumbs}}
              {crumb ? (
                <nav aria-label={t('breadcrumb')} className="text-[11px] text-muted">
                  <a
                    href={`#/${crumb.id}`}
                    onClick={e => {
                      e.preventDefault()
                      go(crumb.id)
                    }}
                    className="transition-colors hover:text-fg hover:underline"
                  >
                    {crumb.label}
                  </a>
                  <span aria-hidden="true"> /</span>
                </nav>
              ) : (
                <div className="text-[11px] uppercase tracking-wider text-muted">{{artifactId}}</div>
              )}
{{/hasBreadcrumbs}}
{{^hasBreadcrumbs}}
              <div className="text-[11px] uppercase tracking-wider text-muted">{{artifactId}}</div>
{{/hasBreadcrumbs}}
              <h1 className="text-sm font-semibold text-fg">{current?.label ?? {{#hasOffNavPages}}RECORD_TITLES[view] ?? {{/hasOffNavPages}}t('dashboard')}</h1>
            </div>
          </div>
{{#hasShellSearch}}
          <div className="flex items-center gap-2">
            <form
              role="search"
              onSubmit={e => {
                e.preventDefault()
                const words = String(new FormData(e.currentTarget).get('q') ?? '').trim()
                go('{{searchPageId}}', undefined, words ? { q: words } : {})
              }}
            >
              <input
                name="q"
                type="search"
                placeholder={t('searchEverything')}
                aria-label={t('searchEverything')}
                className="w-40 rounded-lg border border-border bg-canvas px-3 py-1.5 text-sm text-fg placeholder:text-muted focus:border-brand focus:outline-none sm:w-64"
              />
            </form>
{{/hasShellSearch}}
          <button
            onClick={toggle}
            className="rounded-lg border border-border p-2 text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            title={isDark ? t('switchToLight') : t('switchToDark')}
            aria-label={t('toggleTheme')}
          >
            {isDark ? <Sun className="h-4 w-4" /> : <Moon className="h-4 w-4" />}
          </button>
{{#hasShellSearch}}
          </div>
{{/hasShellSearch}}
        </header>

        <main ref={mainRef} className="flex-1 overflow-auto bg-canvas">
        {route.notFound != null ? (
          <PageNotice title={t('pageNotFound')} hint={t('pageNotFoundHint', { x: route.notFound })} action={t('goToStart')} onAction={() => go('{{initialPageId}}')} />
{{#hasPageRoles}}
        ) : !canSee(view, roles) ? (
          roles == null ? null : <PageNotice title={t('noAccess')} hint={t('noAccessHint')} action={t('goToStart')} onAction={() => go('{{initialPageId}}')} />
{{/hasPageRoles}}
        ) : (
          <>
{{#routePages}}
{{^pageIsRecord}}
          {view === '{{pageId}}' && <{{PageName}}Screen{{routeProps}}{{#needsNavigate}} onNavigate={goView}{{/needsNavigate}} />}
{{/pageIsRecord}}
{{#pageIsRecord}}
          {view === '{{pageId}}' && route.arg && <{{PageName}}Screen key={route.arg} recordId={route.arg}{{#needsNavigate}} onNavigate={goView}{{/needsNavigate}} />}
{{/pageIsRecord}}
{{/routePages}}
          </>
        )}
        </main>
      </div>

      <Toaster richColors position={ {{#isRtl}}'top-left'{{/isRtl}}{{^isRtl}}'top-right'{{/isRtl}} } theme={isDark ? 'dark' : 'light'} />
    </div>
  )
}
{{/hasPages}}
