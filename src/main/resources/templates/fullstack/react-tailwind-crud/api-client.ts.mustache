// API origin. Empty (the default in both .env files) means same-origin `/api/...`: the Vite dev
// server proxies it to the backend (vite.config.ts) and so does nginx in production
// (nginx/nginx.conf, API_UPSTREAM). Set VITE_API_BASE_URL only to call a backend on another
// origin — the backend must then allow this app via app.cors.allowed-origins.
const BASE = ((import.meta.env.VITE_API_BASE_URL as string | undefined) ?? '').replace(/\/+$/, '')

/**
 * Error thrown for non-2xx responses. The API answers with RFC-7807 problem details
 * (`{ title, status, detail, errors? }`, see the backend's ApiExceptionHandler): `detail` becomes
 * the message and, on a 400, the per-field `errors` map is exposed as `fieldErrors` so forms can
 * show each message next to the offending input.
 */
export class ApiError extends Error {
  readonly status: number
  readonly fieldErrors?: Record<string, string>

  constructor(status: number, message: string, fieldErrors?: Record<string, string>) {
    super(message)
    this.name = 'ApiError'
    this.status = status
    this.fieldErrors = fieldErrors
  }
}

async function request<T>(method: string, path: string, body?: unknown): Promise<T> {
  const headers: Record<string, string> =
    body === undefined ? {} : { 'Content-Type': 'application/json' }
{{#hasLdapAuth}}
  // Dev-only: the backend's @RequiresPermission aspect reads the `userinfo` header to
  // resolve the caller's LDAP groups. In production this header is injected by the SSO
  // gateway; in `npm run dev` there is no gateway, so we supply it here. Override the
  // value via VITE_DEV_USERINFO in .env.development.
  if (import.meta.env.DEV) {
    headers['userinfo'] = import.meta.env.VITE_DEV_USERINFO ?? 'dev-user'
  }
{{/hasLdapAuth}}
  const res = await fetch(BASE + path, {
    method,
    headers: Object.keys(headers).length > 0 ? headers : undefined,
    body: body === undefined ? undefined : JSON.stringify(body),
  })
  if (!res.ok) {
    const text = await res.text().catch(() => '')
    let parsed: unknown = null
    try { parsed = text ? JSON.parse(text) : null } catch { /* not JSON */ }
    const problem = parsed != null && typeof parsed === 'object' && !Array.isArray(parsed)
      ? (parsed as Record<string, unknown>)
      : null
    const errors = problem && problem.errors != null && typeof problem.errors === 'object'
      ? (problem.errors as Record<string, string>)
      : undefined
    // A 400 carrying `errors` is bean validation: keep the field map for the form.
    if (res.status === 400 && errors) {
      throw new ApiError(res.status, String(problem?.detail ?? 'Validation failed'), errors)
    }
    // `detail`/`title` are the problem-detail fields; `error`/`message` cover non-scaffolded endpoints.
    const message = (problem && (problem.detail || problem.title || problem.error || problem.message)) || text
    throw new ApiError(res.status, `HTTP ${res.status} on ${method} ${path}: ${String(message)}`)
  }
  if (res.status === 204) return undefined as unknown as T
  // A misrouted /api (no proxy in front of a static build) answers with index.html and a 200;
  // fail with a pointed message instead of a bare JSON SyntaxError.
  const contentType = res.headers.get('content-type') ?? ''
  if (!contentType.includes('json')) {
    throw new ApiError(res.status,
      `Expected JSON from ${method} ${path} but got '${contentType || 'no content-type'}' — is /api routed to the backend?`)
  }
  return res.json() as Promise<T>
}

/** Fetches a path and saves the response body as a file via a transient object URL. Used for
 *  CSV export — the browser handles the download without a navigation. */
async function download(path: string, filename: string): Promise<void> {
  const headers: Record<string, string> = {}
{{#hasLdapAuth}}
  if (import.meta.env.DEV) {
    headers['userinfo'] = import.meta.env.VITE_DEV_USERINFO ?? 'dev-user'
  }
{{/hasLdapAuth}}
  const res = await fetch(BASE + path, { headers: Object.keys(headers).length > 0 ? headers : undefined })
  if (!res.ok) throw new ApiError(res.status, `HTTP ${res.status} on GET ${path}`)
  const blob = await res.blob()
  const url = URL.createObjectURL(blob)
  const a = document.createElement('a')
  a.href = url
  a.download = filename
  document.body.appendChild(a)
  a.click()
  a.remove()
  URL.revokeObjectURL(url)
}

export const api = {
  get: <T>(path: string) => request<T>('GET', path),
  post: <T>(path: string, body: unknown) => request<T>('POST', path, body),
  put: <T>(path: string, body: unknown) => request<T>('PUT', path, body),
  patch: <T>(path: string, body: unknown) => request<T>('PATCH', path, body),
  del: (path: string, body?: unknown) => request<void>('DELETE', path, body),
  download,
}
