{{#hasFilters}}
import { useMemo, useState } from 'react'
{{/hasFilters}}
{{#reportHasExport}}
import { Download } from 'lucide-react'
import { api } from '@shared/api'
{{/reportHasExport}}
{{#hasFilters}}
import { FilterBar, type FilterDescriptor, type FilterValues } from '@shared/ui'
{{/hasFilters}}
import { ReportChart } from '@shared/ui/widgets'
{{#usesStatsImport}}
import { {{#usesBucketRange}}bucketRange{{/usesBucketRange}}{{#usesBucketRange}}{{#presetUsesPeriod}}, {{/presetUsesPeriod}}{{/usesBucketRange}}{{#presetUsesPeriod}}queryOf, rangeParams{{/presetUsesPeriod}} } from '@shared/ui/stats'
{{/usesStatsImport}}
import { t } from '@shared/i18n'
{{#hasChartLabels}}
import { {{chartLabelsRefs}} } from '@entities/{{entityNameKebab}}'
{{/hasChartLabels}}

/** The report's rows; the filter bar's values ride along every chart's rollup and the CSV, so
 *  they always describe exactly the same rows. */
const PATH = '/api/{{entityNamePluralKebab}}'
{{#hasFilters}}
{{#hasPresetFilter}}

/** The filters the report opens with. A cleared preset field stays in the route, cleared. */
const PRESET: FilterValues = {{presetFilterTs}}
{{/hasPresetFilter}}

const filterDescriptors: FilterDescriptor[] = [
{{#filterFields}}  { name: '{{name}}', label: '{{label}}', kind: '{{#isEnumFilter}}enum{{/isEnumFilter}}{{#isBooleanFilter}}boolean{{/isBooleanFilter}}{{#isTemporalFilter}}temporal{{/isTemporalFilter}}{{#isNumericFilter}}numeric{{/isNumericFilter}}{{#isRelationFilter}}relation{{/isRelationFilter}}'{{#isEnumFilter}}, options: [{{#enumValues}}{ value: '{{value}}', label: '{{labelTs}}' }{{^last}}, {{/last}}{{/enumValues}}]{{/isEnumFilter}}{{#isDateTime}}, inputType: 'datetime-local'{{/isDateTime}}{{#isRelationFilter}}, optionsPath: '/api/{{targetEntityKebabPlural}}', optionValue: '{{targetPkName}}'{{#hasTargetLabel}}, optionLabel: '{{targetLabelField}}'{{/hasTargetLabel}}{{/isRelationFilter}} },
{{/filterFields}}]
{{/hasFilters}}
{{#hasScreenProps}}

interface Props {
{{#hasFilters}}
  /** The filters from the route (#/<page>?<field>=<value>); absent (a tab), the screen keeps its own. */
  query?: Record<string, string>
  onQueryChange?: (query: Record<string, string>) => void
{{/hasFilters}}
{{#needsNavigate}}
  onNavigate: (view: string, arg?: string, query?: Record<string, string>) => void
{{/needsNavigate}}
}
{{/hasScreenProps}}

export function {{PageName}}Screen({{#hasScreenProps}}{ {{screenParams}} }: Props{{/hasScreenProps}}) {
{{#hasFilters}}
  const [localFilters, setLocalFilters] = useState<FilterValues>({{#hasPresetFilter}}PRESET{{/hasPresetFilter}}{{^hasPresetFilter}}{}{{/hasPresetFilter}})
  // Routed, the filters live in the URL, so a reload or bookmark keeps them; embedded as a tab,
  // they are local state. Memoized: the rollups below key on this object.
  const filters = useMemo<FilterValues>(() => (onQueryChange ? { {{#hasPresetFilter}}...PRESET, {{/hasPresetFilter}}...query } : localFilters), [onQueryChange, query, localFilters])
  const setFilters = (next: FilterValues) => {
    if (!onQueryChange) return setLocalFilters(next)
    // Empties leave the route{{#hasPresetFilter}} — except a cleared preset field, which has to stay cleared{{/hasPresetFilter}}.
    onQueryChange(Object.fromEntries(Object.entries(next).filter({{#hasPresetFilter}}([name, value]) => value !== '' || name in PRESET{{/hasPresetFilter}}{{^hasPresetFilter}}([, value]) => value !== ''{{/hasPresetFilter}})))
  }
  // A string, so the rollups only refetch when a filter actually changes.
  const search = useMemo(() => {
    const params = new URLSearchParams()
    for (const [name, value] of Object.entries(filters)) if (value !== '') params.set(name, value)
    return params.toString()
  }, [filters])
{{/hasFilters}}
{{^hasFilters}}
  const search = ''
{{/hasFilters}}

  return (
    <div className="mx-auto max-w-5xl space-y-4 p-4 md:p-8">
      <div className="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 className="text-2xl font-semibold tracking-tight text-fg">{ {{pageTitleExpr}} }</h1>
{{#hasPageDescription}}
          <p className="mt-1 max-w-2xl text-sm text-muted">{ {{pageDescriptionExpr}} }</p>
{{/hasPageDescription}}
        </div>
{{#reportHasExport}}
        <button
          type="button"
          onClick={() => api.download(`${PATH}/export.csv${search ? `?${search}` : ''}`, '{{entityNamePluralKebab}}.csv')}
          className="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-medium text-fg shadow-sm transition-colors hover:bg-surface-2"
        >
          <Download className="h-4 w-4" />
          {t('exportCsv')}
        </button>
{{/reportHasExport}}
      </div>
{{#hasFilters}}
      <FilterBar filters={filterDescriptors} values={filters} onChange={setFilters} />
{{/hasFilters}}

{{#firstChart}}
      <ReportChart
{{#hasManyCharts}}
        title={ {{chartTitleExpr}} }
{{/hasManyCharts}}
        path={PATH}
        rollup="{{rollupQuery}}"
        search={search}
{{#chartIsLine}}
        line
{{/chartIsLine}}
{{#chartHasLabels}}
        labels={ {{chartLabelsRef}} }
{{/chartHasLabels}}
{{#chartIsRelation}}
        optionsPath="{{optionsPath}}"
        optionValue="{{optionValue}}"
{{#hasOptionLabel}}
        optionLabel="{{optionLabel}}"
{{/hasOptionLabel}}
{{/chartIsRelation}}
        groupLabel={ {{chartGroupLabelExpr}} }
        valueLabel={ {{chartValueHeaderExpr}} }
        table
{{#hasDrill}}
        onSelect={key => onNavigate('{{drillPageId}}', undefined, { {{#hasFilters}}...filters, {{/hasFilters}}{{drillExpr}} })}
{{/hasDrill}}
      />
{{/firstChart}}
{{#hasManyCharts}}
      <div className="grid grid-cols-1 gap-4 lg:grid-cols-2">
{{#moreCharts}}
        <ReportChart
          title={ {{chartTitleExpr}} }
          path={PATH}
          rollup="{{rollupQuery}}"
          search={search}
{{#chartIsLine}}
          line
{{/chartIsLine}}
{{#chartHasLabels}}
          labels={ {{chartLabelsRef}} }
{{/chartHasLabels}}
{{#chartIsRelation}}
          optionsPath="{{optionsPath}}"
          optionValue="{{optionValue}}"
{{#hasOptionLabel}}
          optionLabel="{{optionLabel}}"
{{/hasOptionLabel}}
{{/chartIsRelation}}
          groupLabel={ {{chartGroupLabelExpr}} }
          valueLabel={ {{chartValueHeaderExpr}} }
{{#hasDrill}}
          onSelect={key => onNavigate('{{drillPageId}}', undefined, { {{#hasFilters}}...filters, {{/hasFilters}}{{drillExpr}} })}
{{/hasDrill}}
        />
{{/moreCharts}}
      </div>
{{/hasManyCharts}}
    </div>
  )
}
