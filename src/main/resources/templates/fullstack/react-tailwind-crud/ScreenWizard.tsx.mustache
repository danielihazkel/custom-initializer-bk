import { useEffect, useState } from 'react'
import { toast } from 'sonner'
import { api, ApiError } from '@shared/api'
import { t } from '@shared/i18n'
import { {{EntityName}}Detail, {{EntityName}}Form, validate{{EntityName}} } from '@features/{{entityNameKebab}}-form'
import type { {{EntityName}} } from '@entities/{{entityNameKebab}}'

/** The create form, step by step: the fields each step shows, and the validation keys it owns
 *  (a relation's picker reports under `<relation>Id`). */
const STEPS: { title: string; fields: readonly string[]; keys: readonly string[] }[] = [
{{#steps}}
  { title: {{stepTitleExpr}}, fields: [{{fieldsTs}}], keys: [{{keysTs}}] },
{{/steps}}
]

const INITIAL: Partial<{{EntityName}}> = {{initialTs}}

/** Where a new record's answers are kept for this browser tab while the wizard is unfinished:
 *  another page and back, or a reload, picks up at the same step. */
const DRAFT = 'wizard-draft:{{pageId}}'

function readDraft(): { step: number; value: Partial<{{EntityName}}> } | null {
  try {
    const raw = sessionStorage.getItem(DRAFT)
    return raw ? JSON.parse(raw) : null
  } catch {
    return null
  }
}

function forgetDraft() {
  try {
    sessionStorage.removeItem(DRAFT)
  } catch {
    // No storage: nothing was kept.
  }
}

/** The messages of `all` that belong to step `index`. */
function errorsOf(index: number, all: Record<string, string>): Record<string, string> {
  return Object.fromEntries(Object.entries(all).filter(([key]) => STEPS[index].keys.includes(key)))
}

/** The first step with a message in `all`, or -1. */
function firstStepWith(all: Record<string, string>): number {
  return STEPS.findIndex((_, i) => Object.keys(errorsOf(i, all)).length > 0)
}
{{#wizardHasProps}}

interface Props {
{{#wizardEditable}}
  /** The key of the row to edit (#/<page>/<id>); absent, the wizard creates a new one. */
  editId?: string
{{/wizardEditable}}
{{#needsNavigate}}
  onNavigate: (view: string, arg?: string, query?: Record<string, string>) => void
{{/needsNavigate}}
}
{{/wizardHasProps}}
{{#wizardEditable}}

const PATH = '/api/{{entityNamePluralKebab}}'
{{/wizardEditable}}

export function {{PageName}}Screen({{#wizardHasProps}}{ {{#wizardEditable}}editId{{#needsNavigate}}, {{/needsNavigate}}{{/wizardEditable}}{{#needsNavigate}}onNavigate{{/needsNavigate}} }: Props{{/wizardHasProps}}) {
  // A new record picks up its draft; STEPS.length is the review step.
  const [draft] = useState(() => {{#wizardEditable}}editId != null ? null : {{/wizardEditable}}readDraft())
  const [step, setStep] = useState(Math.min(Math.max(draft?.step ?? 0, 0), STEPS.length))
  const [value, setValue] = useState<Partial<{{EntityName}}>>(draft?.value ?? INITIAL)
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [saving, setSaving] = useState(false)
  const reviewing = step === STEPS.length
{{#wizardEditable}}
  // Editing: the row is loaded first, and the same steps save it back with a PUT.
  const [loadError, setLoadError] = useState<string | null>(null)
  const [loaded, setLoaded] = useState(editId == null)

  useEffect(() => {
    if (editId == null) return
    let current = true
    api.get<{{EntityName}}>(PATH + '/' + encodeURIComponent(editId))
      .then(row => {
        if (!current) return
        setValue(row)
        setLoaded(true)
      })
      .catch(e => { if (current) setLoadError(e instanceof Error ? e.message : String(e)) })
    return () => { current = false }
  }, [editId])
{{/wizardEditable}}

  useEffect(() => {
{{#wizardEditable}}
    if (editId != null) return
{{/wizardEditable}}
    try {
      sessionStorage.setItem(DRAFT, JSON.stringify({ step, value }))
    } catch {
      // No storage: the answers live only while the page is open.
    }
  }, [step, value{{#wizardEditable}}, editId{{/wizardEditable}}])

  function startOver() {
    forgetDraft()
    setValue(INITIAL)
    setErrors({})
    setStep(0)
  }

  // Editing a field clears its message, as the entity page's form does.
  const edit = (next: Partial<{{EntityName}}>) => {
    setErrors(prev => Object.fromEntries(Object.entries(prev).filter(
      ([key]) => next[key as keyof {{EntityName}}] === value[key as keyof {{EntityName}}])))
    setValue(next)
  }

  function forward() {
    const found = errorsOf(step, validate{{EntityName}}(value))
    setErrors(found)
    if (Object.keys(found).length === 0) setStep(step + 1)
  }

  async function finish() {
    const all = validate{{EntityName}}(value)
    const broken = firstStepWith(all)
    if (broken >= 0) {
      setErrors(errorsOf(broken, all))
      setStep(broken)
      return
    }
    setSaving(true)
    try {
{{#wizardEditable}}
      if (editId != null) {
        await api.put<{{EntityName}}>(PATH + '/' + encodeURIComponent(editId), value)
        toast.success(t('xUpdated', { x: {{entityLabelExpr}} }))
{{#hasRecordPage}}
        onNavigate('{{recordPageId}}', editId)
{{/hasRecordPage}}
{{^hasRecordPage}}
        window.history.back()
{{/hasRecordPage}}
        return
      }
{{/wizardEditable}}
      {{#hasRecordPage}}const created = {{/hasRecordPage}}await api.post<{{EntityName}}>('/api/{{entityNamePluralKebab}}', value)
      forgetDraft()
      toast.success(t('xCreated', { x: {{entityLabelExpr}} }))
{{#hasRecordPage}}
      onNavigate('{{recordPageId}}', String(created.{{recordPk}}))
{{/hasRecordPage}}
{{^hasRecordPage}}
{{#hasBack}}
      onNavigate('{{backPageId}}')
{{/hasBack}}
{{^hasBack}}
      startOver()
{{/hasBack}}
{{/hasRecordPage}}
    } catch (e) {
      // The server's own checks (unique keys, relations) land on the step that owns the field.
      const fieldErrors = e instanceof ApiError ? e.fieldErrors : undefined
      const owner = fieldErrors ? firstStepWith(fieldErrors) : -1
      if (fieldErrors && owner >= 0) {
        setErrors(errorsOf(owner, fieldErrors))
        setStep(owner)
      } else {
        toast.error(e instanceof Error ? e.message : String(e))
      }
    } finally {
      setSaving(false)
    }
  }

  return (
    <div className="mx-auto max-w-3xl space-y-6 p-4 md:p-8">
      <div>
        <h1 className="text-2xl font-semibold tracking-tight text-fg">{{#wizardEditable}}{editId != null ? t('editX', { x: {{entityLabelExpr}} }) : {{pageTitleExpr}} }{{/wizardEditable}}{{^wizardEditable}}{ {{pageTitleExpr}} }{{/wizardEditable}}</h1>
{{#hasPageDescription}}
        <p className="mt-1 max-w-2xl text-sm text-muted">{ {{pageDescriptionExpr}} }</p>
{{/hasPageDescription}}
      </div>

      <ol className="flex flex-wrap gap-2" aria-label={t('stepXOfY', { x: Math.min(step + 1, STEPS.length + 1), y: STEPS.length + 1 })}>
        {[...STEPS.map(s => s.title), t('review')].map((title, i) => (
          <li key={i} aria-current={i === step ? 'step' : undefined}>
            <button
              type="button"
              // A step already passed can be gone back to; the ones ahead open through Next.
              disabled={i >= step || saving}
              onClick={() => {
                setErrors({})
                setStep(i)
              }}
              className={`flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium ${
                i === step
                  ? 'border-brand bg-brand/10 text-brand'
                  : i < step
                    ? 'border-border bg-surface text-fg hover:border-brand/50 hover:text-brand'
                    : 'border-border bg-surface text-muted'
              }`}
            >
              <span className="tabular-nums">{i + 1}</span>
              {title}
            </button>
          </li>
        ))}
      </ol>

{{#wizardEditable}}
      {loadError && <div role="alert" className="rounded-lg border border-danger/20 bg-danger/5 px-4 py-3 text-sm text-danger">{loadError}</div>}
      {loaded && (
{{/wizardEditable}}
      <form
        noValidate
        onSubmit={e => {
          e.preventDefault()
          if (reviewing) void finish()
          else forward()
        }}
        className="space-y-5 rounded-2xl border border-border bg-surface p-5 shadow-sm"
      >
        {reviewing ? (
          <{{EntityName}}Detail value={value as {{EntityName}}} />
        ) : (
          <{{EntityName}}Form value={value} onChange={edit} errors={errors} isNew={ {{#wizardEditable}}editId == null{{/wizardEditable}}{{^wizardEditable}}true{{/wizardEditable}} } only={STEPS[step].fields} />
        )}
        <div className="flex items-center justify-between gap-3 border-t border-border pt-4">
          <button
            type="button"
            onClick={() => {
              setErrors({})
              setStep(step - 1)
            }}
            disabled={step === 0 || saving}
            className="rounded-lg border border-border px-4 py-2 text-sm font-medium text-fg transition-colors hover:bg-surface-2 disabled:opacity-40"
          >
            {t('back')}
          </button>
          <span className="flex items-center gap-3 text-xs tabular-nums text-muted">
            {t('stepXOfY', { x: step + 1, y: STEPS.length + 1 })}
            { {{#wizardEditable}}editId == null && {{/wizardEditable}}(step > 0 || JSON.stringify(value) !== JSON.stringify(INITIAL)) && (
              <button type="button" onClick={startOver} disabled={saving} className="font-medium text-muted underline-offset-2 hover:text-fg hover:underline">
                {t('startOver')}
              </button>
            )}
          </span>
          <button
            type="submit"
            disabled={saving}
            className="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-sm transition-colors hover:bg-primary-deep disabled:opacity-60"
          >
            {reviewing ? (saving ? t('saving') : t('finish')) : t('next')}
          </button>
        </div>
      </form>
{{#wizardEditable}}
      )}
{{/wizardEditable}}
    </div>
  )
}
