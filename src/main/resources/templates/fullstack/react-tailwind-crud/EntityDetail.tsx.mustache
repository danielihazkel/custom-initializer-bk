import type { ReactNode } from 'react'
import type { {{EntityName}} } from '@entities/{{entityNameKebab}}'
{{#hasEnumFields}}import { {{#fields}}{{#isEnum}}{{enumTypeName}}Labels, {{/isEnum}}{{/fields}}} from '@entities/{{entityNameKebab}}'
{{/hasEnumFields}}
{{#detailUsesI18n}}import { {{#detailUsesT}}t{{/detailUsesT}}{{#detailUsesT}}{{#detailUsesLocale}}, {{/detailUsesLocale}}{{/detailUsesT}}{{#detailUsesLocale}}LOCALE{{/detailUsesLocale}} } from '@shared/i18n'
{{/detailUsesI18n}}
interface Props {
  value: {{EntityName}}
}

function Row({ label, children }: { label: string; children: ReactNode }) {
  return (
    <div className="border-b border-border py-3 last:border-0">
      <dt className="text-[11px] font-semibold uppercase tracking-wider text-muted">{label}</dt>
      <dd className="mt-1 text-sm text-fg">{children}</dd>
    </div>
  )
}

const empty = <span className="text-muted">—</span>

/** Read-only, stacked view of one {{EntityName}} — every field, relation FK, and (when enabled)
 *  audit timestamps and child counts. Long TEXT fields wrap rather than truncate. */
export function {{EntityName}}Detail({ value }: Props) {
  return (
    <dl>
{{#formGroups}}
{{#groupHasTitle}}
      <div role="presentation" className="pb-1 pt-5 text-xs font-semibold uppercase tracking-wider text-brand first:pt-0">{ {{{groupTitleExpr}}} }</div>
{{/groupHasTitle}}
{{#groupFields}}      <Row label="{{label}}">{value.{{name}} == null ? empty : {{#isText}}<span className="whitespace-pre-wrap break-words">{String(value.{{name}})}</span>{{/isText}}{{^isText}}{{#isEnum}}{{enumTypeName}}Labels[value.{{name}}]{{/isEnum}}{{^isEnum}}{{#isBoolean}}(value.{{name}} ? t('trueLabel') : t('falseLabel')){{/isBoolean}}{{#isDate}}new Date(`${value.{{name}}}T00:00:00`).toLocaleDateString(LOCALE){{/isDate}}{{#isDateTime}}new Date(value.{{name}}).toLocaleString(LOCALE){{/isDateTime}}{{^isBoolean}}{{^isDate}}{{^isDateTime}}String(value.{{name}}){{/isDateTime}}{{/isDate}}{{/isBoolean}}{{/isEnum}}{{/isText}}}</Row>
{{/groupFields}}{{#groupRelations}}      <Row label="{{FieldName}}">{ {{#targetHasRecordPage}}value.{{fkFieldName}} == null ? empty : <a href={`#/{{targetRecordPageId}}/${encodeURIComponent(String(value.{{fkFieldName}}))}`} onClick={e => e.stopPropagation()} className="font-medium text-brand hover:underline">{ {{#hasTargetLabel}}value.{{fieldName}}Label ?? {{/hasTargetLabel}}'#' + String(value.{{fkFieldName}})}</a>{{/targetHasRecordPage}}{{^targetHasRecordPage}}{{#hasTargetLabel}}value.{{fieldName}}Label ?? ({{/hasTargetLabel}}value.{{fkFieldName}} == null ? empty : {{#hasTargetLabel}}'#' + {{/hasTargetLabel}}String(value.{{fkFieldName}}){{#hasTargetLabel}}){{/hasTargetLabel}}{{/targetHasRecordPage}} }</Row>
{{/groupRelations}}{{/formGroups}}{{#auditApplicable}}      <Row label={t('created')}>{value.createdAt == null ? empty : new Date(value.createdAt).toLocaleString(LOCALE)}</Row>
      <Row label={t('updated')}>{value.updatedAt == null ? empty : new Date(value.updatedAt).toLocaleString(LOCALE)}</Row>
{{/auditApplicable}}{{#optScaffoldInverse}}{{#inverseRelations}}      <Row label="{{CollectionField}}">{value.{{collectionField}}Count == null ? empty : String(value.{{collectionField}}Count)}</Row>
{{/inverseRelations}}{{/optScaffoldInverse}}    </dl>
  )
}
