@import "tailwindcss";

/* Class-based dark mode (toggled by adding `dark` to <html>). */
@custom-variant dark (&:where(.dark, .dark *));

/*
 * Design tokens (Tailwind v4 @theme). Each becomes utilities — bg-brand, text-fg, border-border,
 * rounded-xl, shadow-card, font-sans, … — and the `.dark` block below re-points them for dark mode.
 */
@theme {
  --color-brand:        {{palette.primary}};
  --color-brand-deep:   color-mix(in srgb, {{palette.primary}} 85%, black);
  --color-primary:      {{palette.primary}};
  --color-primary-deep: color-mix(in srgb, {{palette.primary}} 85%, black);
  --color-on-primary:   #ffffff;
  --color-ink:          #2B2F4C;
  --color-ink-soft:     color-mix(in srgb, #2B2F4C 86%, white);
  --color-gold:         {{palette.secondary}};
  --color-success:      {{#hasPaletteAccent}}{{palette.accent}}{{/hasPaletteAccent}}{{^hasPaletteAccent}}#16a34a{{/hasPaletteAccent}};
  --color-danger:       {{#hasPaletteError}}{{palette.error}}{{/hasPaletteError}}{{^hasPaletteError}}#dc2626{{/hasPaletteError}};

  --color-canvas:       #f6f7f9;
  --color-surface:      #ffffff;
  --color-surface-2:    #f1f5f9;
  --color-fg:           #0f172a;
  --color-muted:        #64748b;
  --color-border:       #e6e9ee;
  --color-ring:         {{palette.primary}};

  --font-sans:          'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.dark {
  --color-canvas:    #0b1120;
  --color-surface:   #111827;
  --color-surface-2: #1b2435;
  --color-fg:        #e8edf5;
  --color-muted:     #94a3b8;
  --color-border:    #243049;
}

/*
 * Menora signature gradient (purple → purple → gold), mirroring colors.ts
 * appBarGradient / sideBarGradient. Defined as plain utilities (not @theme tokens)
 * because Tailwind v4 only generates colour utilities from @theme colours.
 */
.bg-app-shell {
  background-image: linear-gradient(to bottom, var(--color-brand) 0%, var(--color-brand) 75%, var(--color-gold) 100%);
}
.bg-app-bar {
  background-image: linear-gradient(to right, var(--color-brand) 0%, var(--color-brand) 75%, var(--color-gold) 100%);
}

html, body, #root {
  height: 100%;
}

body {
  font-family: var(--font-sans);
  background-color: var(--color-canvas);
  color: var(--color-fg);
  margin: 0;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  transition: background-color 0.2s ease, color 0.2s ease;
}

/* Thin, theme-aware scrollbars so the dark mode doesn't show bright gutters. */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--color-border) transparent;
}
