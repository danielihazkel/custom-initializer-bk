# Production build: leave empty so the app calls same-origin /api/..., which the shipped
# nginx/nginx.conf proxies to the backend named by the API_UPSTREAM container env var
# (e.g. docker run -e API_UPSTREAM=http://backend:8080). Set an absolute origin here only when
# the API lives elsewhere; the backend must then allow it via app.cors.allowed-origins.
VITE_API_BASE_URL=
