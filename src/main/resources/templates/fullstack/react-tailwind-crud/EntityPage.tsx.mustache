              title={t('calendarView')}
              aria-label={t('calendarView')}
            >
              <Calendar className="h-4 w-4" />
            </button>
{{/viewCalendar}}          </div>
{{/hasViewToggle}}{{#optScaffoldCsvExport}}          <button
            onClick={() => download.run(() => exportCsv('{{entityNamePluralKebab}}.csv'))}
