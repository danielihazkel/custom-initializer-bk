import { useEffect, useState } from 'react'
import { Plus } from 'lucide-react'
import { toast } from 'sonner'
import { use{{EntityName}} } from '@entities/{{entityNameKebab}}'
import type { {{EntityName}} } from '@entities/{{entityNameKebab}}'
import { Table, type Column, type SortSpec } from '@shared/ui'
import { FormDrawer, Alert, ConfirmDialog } from '@shared/ui'
import { {{EntityName}}Form } from '@features/{{entityNameKebab}}-form'
import { ApiError } from '@shared/api'

const columns: Column<{{EntityName}}>[] = [
{{#fields}}  { label: '{{Name}}', sortKey: '{{name}}', render: r => r.{{name}} == null ? '—' : String(r.{{name}}) },
{{/fields}}{{#relations}}  { label: '{{FieldName}} ID', render: r => r.{{fkFieldName}} == null ? '—' : String(r.{{fkFieldName}}) },
{{/relations}}]

export function {{EntityName}}Page() {
  const [page, setPage] = useState(0)
  const [size, setSize] = useState(20)
  const [sort, setSort] = useState<SortSpec | null>(null)
  const [search, setSearch] = useState('')
  const [debouncedSearch, setDebouncedSearch] = useState('')

  useEffect(() => {
    const t = setTimeout(() => setDebouncedSearch(search), 300)
    return () => clearTimeout(t)
  }, [search])

  useEffect(() => {
    setPage(0)
  }, [debouncedSearch, sort, size])

  const {
    items, totalElements, totalPages, pageNumber, pageSize,
    loading, error, create, update, remove,
  } = use{{EntityName}}({ page, size, sort, q: debouncedSearch })

  const [editing, setEditing] = useState<Partial<{{EntityName}}> | null>(null)
  const [isNew, setIsNew] = useState(false)
  const [saving, setSaving] = useState(false)
  const [drawerOpen, setDrawerOpen] = useState(false)
  const [formErrors, setFormErrors] = useState<Record<string, string>>({})
  const [pendingDelete, setPendingDelete] = useState<{{EntityName}} | null>(null)
  const [deleting, setDeleting] = useState(false)

  function openNew() {
    setEditing({})
    setIsNew(true)
    setFormErrors({})
    setDrawerOpen(true)
  }
  function openEdit(row: {{EntityName}}) {
    setEditing({ ...row })
    setIsNew(false)
    setFormErrors({})
    setDrawerOpen(true)
  }
  function close() {
    setDrawerOpen(false)
    setEditing(null)
    setFormErrors({})
  }
  async function save() {
    if (!editing) return
    setSaving(true)
    setFormErrors({})
    try {
      if (isNew) await create(editing as Omit<{{EntityName}}, 'id'>)
      else await update(editing.{{pkField.name}} as number | string, editing as {{EntityName}})
      toast.success(isNew ? '{{EntityName}} created' : '{{EntityName}} updated')
      close()
    } catch (e) {
      // A 400 carries per-field messages — show them inline; anything else is a toast.
      if (e instanceof ApiError && e.fieldErrors) {
        setFormErrors(e.fieldErrors)
        toast.error('Please fix the highlighted fields')
      } else {
        toast.error(e instanceof Error ? e.message : String(e))
      }
    } finally {
      setSaving(false)
    }
  }
  async function confirmDelete() {
    if (!pendingDelete) return
    setDeleting(true)
    try {
      await remove(pendingDelete.{{pkField.name}} as number | string)
      toast.success('{{EntityName}} deleted')
      setPendingDelete(null)
    } catch (e) {
      toast.error(e instanceof Error ? e.message : String(e))
    } finally {
      setDeleting(false)
    }
  }

  const pagination = {
    pageNumber,
    pageSize,
    totalPages,
    totalElements,
    onPageChange: setPage,
    onPageSizeChange: setSize,
  }

  return (
    <div className="mx-auto max-w-6xl p-8">
      <div className="mb-6 flex items-end justify-between">
        <div>
          <h1 className="text-2xl font-semibold tracking-tight text-fg">{{EntityNamePlural}}</h1>
          <p className="mt-1 text-sm text-muted">
            {totalElements} {totalElements === 1 ? 'record' : 'records'}
          </p>
        </div>
        <button
          onClick={openNew}
          className="inline-flex items-center gap-2 rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white shadow-sm transition-colors hover:bg-brand-deep"
        >
          <Plus className="h-4 w-4" />
          New {{EntityName}}
        </button>
      </div>

      {error && <Alert>{error}</Alert>}

      <Table
        columns={columns}
        rows={items}
        loading={loading}
        onEdit={openEdit}
        onDelete={setPendingDelete}
        sort={sort}
        onSortChange={setSort}
        search={search}
        onSearchChange={setSearch}
{{#hasStringFields}}        searchable={true}
{{/hasStringFields}}{{^hasStringFields}}        searchable={false}
{{/hasStringFields}}        pagination={pagination}
      />

      <FormDrawer
        open={drawerOpen}
        title={isNew ? 'New {{EntityName}}' : 'Edit {{EntityName}}'}
        subtitle={isNew ? 'Create a new {{EntityName}} record' : 'Update this {{EntityName}} record'}
        onClose={close}
        onSave={save}
        saving={saving}
      >
        {editing && (
          <{{EntityName}}Form
            value={editing}
            onChange={setEditing}
            errors={formErrors}
            isNew={isNew}
          />
        )}
      </FormDrawer>

      <ConfirmDialog
        open={pendingDelete !== null}
        title="Delete {{EntityName}}?"
        message="This action cannot be undone."
        busy={deleting}
        onConfirm={confirmDelete}
        onCancel={() => setPendingDelete(null)}
      />
    </div>
  )
}
