          onMove={onKanbanMove}
          totals={laneTotals}
          filtered={filtered}
          emptyAction={emptyAction}
{{#kanbanShowsLane}}
          onShowLane={value => { setFilters(f => ({ ...f, {{kanbanField}}: value })); setViewMode('table') }}
{{/kanbanShowsLane}}
        />
      ) : {{/viewKanban}}{{#viewCalendar}}viewMode === 'calendar' ? (
        <CalendarView
          columns={{#listConfigurable}}{shown}{{/listConfigurable}}{{^listConfigurable}}{columns}{{/listConfigurable}}
          rows={items}
