          onToggleAllOnPage={toggleAllOnPage}
{{/bulkSelectApplicable}}          pagination={pagination}
          filtered={filtered}
{{#mutable}}          emptyAction={emptyAction}
{{/mutable}}        />
      ) : {{/viewTable}}null}
{{#listSideDetail}}
      </div>
      {sidePane && (
        <aside className="self-start rounded-2xl border border-border bg-surface p-5 shadow-sm" data-side-pane>
          {selectedRow ? (
            <>
              <div className="mb-4 flex items-start justify-between gap-3">
                <h2 className="text-sm font-semibold text-fg">{t('xDetails', { x: '{{entityLabel}}' })}</h2>
                <div className="flex items-center gap-3">
{{#mutable}}
                  <button type="button" onClick={() => openEdit(selectedRow)} className="text-xs font-medium text-brand hover:underline">{t('edit')}</button>
                  <button type="button" onClick={() => setPendingDelete(selectedRow)} className="text-xs font-medium text-brand hover:underline">{t('delete')}</button>
{{/mutable}}
                  <button type="button" onClick={() => onSelect?.(undefined)} className="text-xs font-medium text-muted hover:text-fg" aria-label={t('close')}>×</button>
                </div>
