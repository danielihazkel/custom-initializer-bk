{{#hasStringFields}}          searchable={true}
{{/hasStringFields}}{{^hasStringFields}}          searchable={false}
{{/hasStringFields}}{{#bulkSelectApplicable}}          selectable={true}
          isRowSelected={isRowSelected}
          onToggleRow={toggleRow}
