{{/hasPages}}
          <p className="mt-1 text-sm text-muted">
            {totalElements} {t(totalElements === 1 ? 'record' : 'records')}{{#isView}} · {t('readOnlyView')}{{/isView}}
          </p>
        </div>
        <div className="flex items-center gap-2">
{{#hasViewToggle}}          <div className="inline-flex rounded-lg border border-border bg-surface p-0.5">
{{#viewTable}}            <button
