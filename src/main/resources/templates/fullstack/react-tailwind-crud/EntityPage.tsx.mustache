          filtered={filtered}
          onView={{#hasPages}}{openRow}{{/hasPages}}{{^hasPages}}{setDetailRow}{{/hasPages}}
{{#calendarRanged}}
          onRangeChange={onCalendarRange}
          total={calendarRange ? totalElements : undefined}
{{/calendarRanged}}
        />
      ) : {{/viewCalendar}}{{#viewTable}}viewMode === 'table' ? (
        <Table
          columns={{#listConfigurable}}{shown}{{/listConfigurable}}{{^listConfigurable}}{columns}{{/listConfigurable}}
          rows={items}
          rowKey={rowKey}
          loading={loading}
          onView={{#hasPages}}{openRow}{{/hasPages}}{{^hasPages}}{setDetailRow}{{/hasPages}}
{{#mutable}}          onEdit={openEdit}
