        </Alert>
      )}
{{#hasFilters}}
      <div className="mb-4">
        <FilterBar filters={{#pageScopeable}}{visibleFilters}{{/pageScopeable}}{{^pageScopeable}}{filterDescriptors}{{/pageScopeable}} values={filters} onChange={setFilters} />
      </div>
{{/hasFilters}}{{#bulkSelectApplicable}}{{#viewTable}}      {selected.length > 0 && (
        <div className="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-brand/40 bg-brand/5 px-4 py-2.5">
          <span className="text-sm font-medium text-fg">{t('nSelected', { n: selected.length })}</span>
          <div className="flex flex-wrap items-center gap-2">
{{#bulkUpdateApplicable}}            <select
