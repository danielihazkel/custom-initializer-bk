          >
            <Download className="h-4 w-4" />
            {download.busy ? t('exporting') : t('export')}
          </button>
{{/optScaffoldCsvExport}}{{#mutable}}          <button
            {{^hasWizardPage}}onClick={openNew}{{/hasWizardPage}}{{#hasWizardPage}}onClick={onCreate ?? openNew}{{/hasWizardPage}}
