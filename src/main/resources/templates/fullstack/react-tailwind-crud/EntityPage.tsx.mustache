        open={list.drawerOpen}
        title={list.isNew ? t('newX', { x: '{{entityLabelTs}}' }) : t('editX', { x: '{{entityLabelTs}}' })}
        subtitle={list.isNew ? t('createXBlurb', { x: '{{entityLabelTs}}' }) : t('updateXBlurb', { x: '{{entityLabelTs}}' })}
        onClose={list.close}
        onSave={list.save}
        saving={list.saving}
        dirty={list.dirty}
      >
{{#lockingApplicable}}        {list.stale && <StaleNotice busy={list.saving} onReload={list.loadTheirs} onOverwrite={list.saveMineAnyway} />}
{{/lockingApplicable}}        {list.editing && (
          <{{EntityName}}Form
            value={list.editing}
            onChange={next => {
              // Clear the message of any field the user just edited; the others stay until the
              // next save re-validates.
              const before = (list.editing ?? {}) as Record<string, unknown>
              const after = next as Record<string, unknown>
              const changed = Object.keys(after).filter(k => after[k] !== before[k] && k in list.formErrors)
              if (changed.length > 0) {
                list.setFormErrors(prev => {
                  const copy = { ...prev }
                  for (const k of changed) delete copy[k]
                  return copy
                })
              }
              list.setEditing(next)
            }}
            errors={list.formErrors}
            isNew={list.isNew}
          />
        )}
      </FormDrawer>
{{#importApplicable}}

      <DetailDrawer open={list.importing} title={t('importX', { x: '{{entityLabelPluralTs}}' })} onClose={() => list.setImporting(false)}>
        {list.importing && (
          <CsvImport
            fields={ {{EntityName}}ImportFields }
            validate={value => validate{{EntityName}}(value as Partial<{{EntityName}}>)}
            path="/api/{{entityNamePluralKebab}}"
            label={'{{entityLabelPluralTs}}'}
            onDone={n => {
              list.setImporting(false)
              toast.success(t('importDone', { n, x: '{{entityLabelPluralTs}}' }))
              void list.reload()
            }}
          />
        )}
      </DetailDrawer>
{{/importApplicable}}

      <ConfirmDialog
        open={list.pendingDelete !== null}
        title={t('deleteX', { x: '{{entityLabelTs}}' })}
        message={t('{{#softDeleteApplicable}}undoHint{{/softDeleteApplicable}}{{^softDeleteApplicable}}cannotUndo{{/softDeleteApplicable}}')}
        busy={list.deleting}
        onConfirm={list.confirmDelete}
        onCancel={() => list.setPendingDelete(null)}
      />
{{/mutable}}{{#bulkDeleteApplicable}}{{#viewTable}}
      <ConfirmDialog
        open={list.bulkConfirm}
        title={t('deleteNX', { n: list.selected.length, x: '{{entityLabelTs}}', unit: t(list.selected.length === 1 ? 'record' : 'records') })}
        message={t('cannotUndo')}
        busy={list.bulkBusy}
        onConfirm={list.runBulkDelete}
        onCancel={() => list.setBulkConfirm(false)}
      />
{{/viewTable}}{{/bulkDeleteApplicable}}
      <DetailDrawer
        open={list.detailRow !== null}
        title={t('xDetails', { x: '{{entityLabelTs}}' })}
        onClose={() => list.setDetailRow(null)}
{{#mutable}}{{^listActionsConfigurable}}        onEdit={() => { if (list.detailRow) { list.openEdit(list.detailRow); list.setDetailRow(null) } }}
{{/listActionsConfigurable}}{{#listActionsConfigurable}}        onEdit={list.can('edit'){{#listOwnWrites}} && (!list.detailRow || list.mine(list.detailRow)){{/listOwnWrites}} ? () => { if (list.detailRow) { list.openEdit(list.detailRow); list.setDetailRow(null) } } : undefined}
{{/listActionsConfigurable}}{{/mutable}}      >
        {list.detailRow && <{{EntityName}}Detail value={list.detailRow} />}
{{#historyApplicable}}        {list.detailRow && <{{EntityName}}History id={String(list.rowKey(list.detailRow))} version={list.detailRow} onRestored={next => { list.setDetailRow(next); void list.reload() }} />}
{{/historyApplicable}}
{{#hasWorkflow}}
        {list.detailRow && (
          <div className="mt-4 border-t border-border pt-4">
            <{{EntityName}}Transitions row={list.detailRow} onDone={next => { list.setDetailRow(next); void list.reload() }} />
          </div>
        )}
{{/hasWorkflow}}
      </DetailDrawer>
    </div>
  )
}
