    } finally {
      setBulkBusy(false)
    }
  }
{{/viewTable}}{{/bulkDeleteApplicable}}{{#bulkUpdateApplicable}}{{#viewTable}}
  const [bulkField, setBulkField] = useState<string>('')
  const [bulkValue, setBulkValue] = useState<string>('')
  const [bulkUpdating, setBulkUpdating] = useState(false)
  async function runBulkUpdate() {
    if (!bulkField) return
    setBulkUpdating(true)
    try {
      // An empty value clears the field (sent as null); otherwise the raw string is coerced server-side.
      await updateMany(selected, bulkField, bulkValue === '' ? null : bulkValue)
      toast.success(t('nXRecordsUpdated', { n: selected.length, x: '{{entityLabel}}', unit: t(selected.length === 1 ? 'record' : 'records') }))
      setSelected([])
      setBulkField('')
      setBulkValue('')
    } catch (e) {
      toast.error(e instanceof Error ? e.message : String(e))
    } finally {
      setBulkUpdating(false)
    }
  }
{{/viewTable}}{{/bulkUpdateApplicable}}
  // An empty list offers the first record — unless a search or filter is what emptied it.
  const filtered = debouncedSearch !== ''{{#hasFilters}} || Object.values(filters).some(v => v !== ''){{/hasFilters}}
{{#mutable}}  const emptyAction = { label: t('newX', { x: '{{entityLabel}}' }), onClick: {{^hasWizardPage}}openNew{{/hasWizardPage}}{{#hasWizardPage}}onCreate ?? openNew{{/hasWizardPage}} }
{{/mutable}}  const pagination = {
