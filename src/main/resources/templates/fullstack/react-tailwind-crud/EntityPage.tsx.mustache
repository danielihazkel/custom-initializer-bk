              aria-label={t('fieldToEdit')}
            >
              <option value="">{t('setField')}</option>
{{#bulkUpdatableFields}}              <option value="{{name}}">{{label}}</option>
{{/bulkUpdatableFields}}            </select>
            {bulkField && (() => {
              const meta = BULK_FIELDS[bulkField]
              if (!meta) return null
              const cls = 'rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-fg'
              if (meta.kind === 'boolean') return (
                <select value={bulkValue} onChange={e => setBulkValue(e.target.value)} className={cls} aria-label={t('newValue')}>
                  <option value="">—</option>
                  <option value="true">{t('trueLabel')}</option>
                  <option value="false">{t('falseLabel')}</option>
                </select>
              )
              if (meta.kind === 'enum') return (
                <select value={bulkValue} onChange={e => setBulkValue(e.target.value)} className={cls} aria-label={t('newValue')}>
                  <option value="">—</option>
                  {meta.options!.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
                </select>
              )
              const type = meta.kind === 'number' ? 'number' : meta.kind === 'date' ? 'date' : meta.kind === 'datetime' ? 'datetime-local' : 'text'
              return <input type={type} value={bulkValue} onChange={e => setBulkValue(e.target.value)} className={cls} placeholder={t('newValue')} aria-label={t('newValue')} />
            })()}
            <button
              onClick={runBulkUpdate}
              disabled={!bulkField || bulkUpdating}
              className="inline-flex items-center gap-2 rounded-lg bg-primary px-3 py-1.5 text-sm font-medium text-on-primary transition-colors hover:bg-primary-deep disabled:opacity-50"
            >
              <PencilLine className="h-4 w-4" />
              {t('apply')}
            </button>
{{/bulkUpdateApplicable}}            <button onClick={() => setSelected([])} className="rounded-lg px-3 py-1.5 text-sm text-muted transition-colors hover:text-fg">{t('clear')}</button>
{{#bulkDeleteApplicable}}            <button
              onClick={() => setBulkConfirm(true)}
              className="inline-flex items-center gap-2 rounded-lg bg-danger px-3 py-1.5 text-sm font-medium text-white transition-colors hover:opacity-90"
