import { useEffect, useState } from 'react'
import { api } from '@shared/api'
import { t } from '@shared/i18n'
{{#entities}}{{#breakdownEnumTypeName}}import { {{breakdownEnumTypeName}}Labels } from '@entities/{{entityNameKebab}}'
{{/breakdownEnumTypeName}}{{/entities}}
import { DashboardFrame, DashboardSection, StatCard, ChartCard } from '@shared/ui/ClassicDashboard'

interface CardDef {
  label: string
  view: string
  path: string
}

const CARDS: CardDef[] = [
{{#entities}}
  { label: '{{entityLabelPlural}}', view: '{{entityNameKebab}}', path: '/api/{{entityNamePluralKebab}}' },
{{/entities}}
]

interface ChartDef {
  label: string
  path: string
  field: string
  /** Enum breakdowns: display label per constant, so the bars read like the rest of the app. */
  labels?: Record<string, string>
}

// One breakdown per entity that has a low-cardinality (enum/boolean) field. Grouped client-side
// from a sample page (see useBreakdown), so the chart labels itself as a sample on large tables.
const CHARTS: ChartDef[] = [
{{#entities}}{{#hasBreakdown}}  { label: t('xByY', { x: '{{entityLabelPlural}}', y: '{{breakdownLabel}}' }), path: '/api/{{entityNamePluralKebab}}', field: '{{breakdownField}}'{{#breakdownEnumTypeName}}, labels: {{breakdownEnumTypeName}}Labels{{/breakdownEnumTypeName}} },
{{/hasBreakdown}}{{/entities}}]

/** Reads just the page metadata (size=1) to surface a live record count per entity. */
function useCount(path: string) {
  const [count, setCount] = useState<number | null>(null)
  const [failed, setFailed] = useState(false)

  useEffect(() => {
    let active = true
    api.get<{ totalElements: number }>(`${path}?size=1`)
      .then(p => { if (active) setCount(p.totalElements) })
      .catch(() => { if (active) setFailed(true) })
    return () => { active = false }
  }, [path])

  return { count, failed }
}

/** Groups the records by `field` through the entity's /stats rollup — one request, exact totals,
 *  and no page of rows crossing the wire. */
function useBreakdown(path: string, field: string, labels?: Record<string, string>) {
  const [data, setData] = useState<{ label: string; count: number }[] | null>(null)
  const [failed, setFailed] = useState(false)

  useEffect(() => {
    let active = true
    api.get<{ buckets: { key: string; value: number | null }[] }>(`${path}/stats?groupBy=${field}`)
      .then(s => {
        if (!active) return
        const buckets = s.buckets ?? []
        setData(buckets
          .map(b => {
            const raw = b.key === '' ? '—' : b.key
            return { label: labels?.[raw] ?? raw, count: b.value ?? 0 }
          })
          .sort((a, b) => b.count - a.count))
      })
      .catch(() => { if (active) setFailed(true) })
    return () => { active = false }
    // `labels` is a module-level constant (the CHARTS entry), so it never changes identity.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [path, field])

  return { data, failed }
}

function Breakdown({ chart }: { chart: ChartDef }) {
  const { data, failed } = useBreakdown(chart.path, chart.field, chart.labels)
  return <ChartCard label={chart.label} data={data} failed={failed} />
}

function Count({ card, onNavigate }: { card: CardDef; onNavigate: (view: string) => void }) {
  const { count, failed } = useCount(card.path)
  return <StatCard label={card.label} count={count} failed={failed} onOpen={() => onNavigate(card.view)} />
}

interface Props {
  onNavigate: (view: string) => void
}

export function DashboardPage({ onNavigate }: Props) {
  return (
    <DashboardFrame
      title={ {{#dashboardTitleExpr}}{{dashboardTitleExpr}}{{/dashboardTitleExpr}}{{^dashboardTitleExpr}}t('welcomeTo', { name: '{{artifactId}}' }){{/dashboardTitleExpr}} }
      lead={ {{#dashboardOverviewExpr}}{{dashboardOverviewExpr}}{{/dashboardOverviewExpr}}{{^dashboardOverviewExpr}}t('manageBlurb'){{/dashboardOverviewExpr}} }
      shortcuts={CARDS.map(card => ({ label: card.label, onOpen: () => onNavigate(card.view) }))}
    >
      <DashboardSection title={t('collections')} kind="stats">
        {CARDS.map(card => (
          <Count key={card.view} card={card} onNavigate={onNavigate} />
        ))}
      </DashboardSection>
      {CHARTS.length > 0 && (
        <DashboardSection title={t('breakdowns')} kind="charts">
          {CHARTS.map(chart => <Breakdown key={chart.label} chart={chart} />)}
        </DashboardSection>
      )}
    </DashboardFrame>
  )
}
