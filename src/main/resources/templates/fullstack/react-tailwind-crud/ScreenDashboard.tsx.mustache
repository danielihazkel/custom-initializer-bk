  const [tick, setTick] = useState(0)
{{/hasRefresh}}
{{#hasAutoRefresh}}
  useEffect(() => {
    const timer = setInterval(() => {
      if (document.visibilityState === 'visible') setTick(n => n + 1)
    }, {{refreshMs}})
    return () => clearInterval(timer)
  }, [])
{{/hasAutoRefresh}}
