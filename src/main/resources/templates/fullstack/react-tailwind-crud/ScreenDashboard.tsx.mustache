{{#hasScreenProps}}

interface Props {
{{#hasDateRange}}
  /** The period from the route (#/<page>?period=30d); absent (a tab), the screen keeps its own. */
  period?: string
  onPeriodChange?: (period: Period) => void
{{/hasDateRange}}
{{#needsNavigate}}
  onNavigate: (view: string, arg?: string, query?: Record<string, string>) => void
{{/needsNavigate}}
}
{{/hasScreenProps}}

export function {{PageName}}Screen({{#hasScreenProps}}{ {{screenParams}} }: Props{{/hasScreenProps}}) {
{{#hasDateRange}}
  const [localPeriod, setLocalPeriod] = useState<Period>('{{dateRangeDefault}}')
  // The period every widget with a date column is limited to. Routed, it lives in the URL, so a
  // reload or bookmark keeps it; embedded as a tab, it is local state.
  const period = onPeriodChange ? parsePeriod(routePeriod, '{{dateRangeDefault}}') : localPeriod
  const setPeriod = onPeriodChange ?? setLocalPeriod
{{/hasDateRange}}
{{#hasRefresh}}
  // Bumped by Refresh{{#hasAutoRefresh}} and every {{refreshMs}} ms while the tab is visible{{/hasAutoRefresh}}: the widgets reload.
  const [tick, setTick] = useState(0)
{{/hasRefresh}}
{{#hasAutoRefresh}}
  useEffect(() => {
    const timer = setInterval(() => {
      if (document.visibilityState === 'visible') setTick(n => n + 1)
    }, {{refreshMs}})
    return () => clearInterval(timer)
  }, [])
{{/hasAutoRefresh}}
  return (
    <div className="mx-auto max-w-6xl p-4 md:p-8">
{{^hasHeaderTools}}
      <div className="mb-6">
        <h1 className="text-2xl font-semibold tracking-tight text-fg">{ {{pageTitleExpr}} }</h1>
{{#hasPageDescription}}
        <p className="mt-1 max-w-2xl text-sm text-muted">{ {{pageDescriptionExpr}} }</p>
{{/hasPageDescription}}
      </div>
{{/hasHeaderTools}}
{{#hasHeaderTools}}
      <div className="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 className="text-2xl font-semibold tracking-tight text-fg">{ {{pageTitleExpr}} }</h1>
{{#hasPageDescription}}
          <p className="mt-1 max-w-2xl text-sm text-muted">{ {{pageDescriptionExpr}} }</p>
{{/hasPageDescription}}
        </div>
        <div className="flex flex-wrap items-center gap-2">
{{#hasDateRange}}
          <PeriodSelect value={period} onChange={setPeriod} />
{{/hasDateRange}}
{{#hasRefresh}}
          <RefreshButton onClick={() => setTick(n => n + 1)} />
{{/hasRefresh}}
        </div>
      </div>
{{/hasHeaderTools}}
{{#hasRefresh}}
      <RefreshTick.Provider value={tick}>
{{/hasRefresh}}
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
{{#widgets}}
{{#widgetIsKpi}}
        <KpiTile
          title={ {{titleExpr}} }
          path="{{path}}"
{{#hasAgg}}
          agg="{{agg}}"
          field="{{aggField}}"
{{/hasAgg}}
{{#hasParams}}
          params={ {{paramsExpr}} }
{{/hasParams}}
{{#hasCompare}}
          compareParams={ period === 'all' ? undefined : {{compareParamsExpr}} }
{{/hasCompare}}
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
{{#hasTarget}}
          onOpen={() => onNavigate('{{targetPageId}}'{{#openWithQuery}}, undefined, queryOf({{paramsExpr}}){{/openWithQuery}})}
{{/hasTarget}}
        />
{{/widgetIsKpi}}
{{#widgetIsProgress}}
        <ProgressTile
          title={ {{titleExpr}} }
          path="{{path}}"
{{#hasAgg}}
          agg="{{agg}}"
          field="{{aggField}}"
{{/hasAgg}}
          target={ {{target}} }
{{#hasParams}}
          params={ {{paramsExpr}} }
{{/hasParams}}
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
{{#hasTarget}}
          onOpen={() => onNavigate('{{targetPageId}}'{{#openWithQuery}}, undefined, queryOf({{paramsExpr}}){{/openWithQuery}})}
{{/hasTarget}}
        />
{{/widgetIsProgress}}
{{#widgetIsLine}}
        <TrendCard
          title={ {{titleExpr}} }
          path="{{path}}"
          on="{{groupBy}}"
          bucket="{{bucket}}"
{{#hasAgg}}
          agg="{{agg}}"
          field="{{aggField}}"
{{/hasAgg}}
{{#hasParams}}
          params={ {{paramsExpr}} }
{{/hasParams}}
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
{{#hasDrill}}
          onSelect={key => onNavigate('{{drillPageId}}', undefined, { {{drillBase}}...bucketRange('{{groupBy}}', key, {{groupByIsDateTime}}) })}
{{/hasDrill}}
{{#hasTarget}}
          onOpen={() => onNavigate('{{targetPageId}}'{{#openWithQuery}}, undefined, queryOf({{paramsExpr}}){{/openWithQuery}})}
{{/hasTarget}}
        />
{{/widgetIsLine}}
{{#widgetIsBar}}
        <BreakdownCard
          title={ {{titleExpr}} }
          path="{{path}}"
          field="{{groupBy}}"
{{#hasAgg}}
          agg="{{agg}}"
          valueField="{{aggField}}"
{{/hasAgg}}
{{#hasLabels}}
          labels={ {{labelsRef}} }
{{/hasLabels}}
{{#isRelationRank}}
          optionsPath="{{optionsPath}}"
          optionValue="{{optionValue}}"
{{#hasOptionLabel}}
          optionLabel="{{optionLabel}}"
{{/hasOptionLabel}}
{{/isRelationRank}}
{{#hasParams}}
          params={ {{paramsExpr}} }
{{/hasParams}}
{{#isDonut}}
          donut
{{/isDonut}}
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
{{#hasDrill}}
          onSelect={key => onNavigate('{{drillPageId}}', undefined, { {{drillBase}}{{drillKey}}: key })}
{{/hasDrill}}
{{#hasTarget}}
          onOpen={() => onNavigate('{{targetPageId}}'{{#openWithQuery}}, undefined, queryOf({{paramsExpr}}){{/openWithQuery}})}
{{/hasTarget}}
        />
{{/widgetIsBar}}
{{#widgetIsStacked}}
        <StackedCard
          title={ {{titleExpr}} }
          path="{{path}}"
          field="{{groupBy}}"
          series="{{seriesField}}"
{{#hasAgg}}
          agg="{{agg}}"
          valueField="{{aggField}}"
{{/hasAgg}}
{{#hasLabels}}
          labels={ {{labelsRef}} }
{{/hasLabels}}
{{#hasSeriesLabels}}
          seriesLabels={ {{seriesLabelsRef}} }
{{/hasSeriesLabels}}
{{#hasParams}}
          params={ {{paramsExpr}} }
{{/hasParams}}
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
{{#hasDrill}}
          onSelect={key => onNavigate('{{drillPageId}}', undefined, { {{drillBase}}{{drillKey}}: key })}
{{/hasDrill}}
{{#hasTarget}}
          onOpen={() => onNavigate('{{targetPageId}}'{{#openWithQuery}}, undefined, queryOf({{paramsExpr}}){{/openWithQuery}})}
{{/hasTarget}}
        />
{{/widgetIsStacked}}
{{#widgetIsText}}
        <TextCard
{{#hasTitle}}
          title={ {{titleExpr}} }
{{/hasTitle}}
          paragraphs={ [{{#paragraphs}}{{^-first}}, {{/-first}}{{textExpr}}{{/paragraphs}}] }
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
        />
{{/widgetIsText}}
{{#widgetIsLinks}}
        <LinksCard
{{#hasTitle}}
          title={ {{titleExpr}} }
{{/hasTitle}}
          items={ [{{#links}}{{^-first}}, {{/-first}}{ id: '{{pageId}}', label: {{labelExpr}}, icon: {{navIcon}} }{{/links}}] }
          onOpen={id => onNavigate(id)}
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
        />
{{/widgetIsLinks}}
{{#widgetIsList}}
        <ListCard
          title={ {{titleExpr}} }
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
{{#hasTarget}}
          onOpen={() => onNavigate('{{targetPageId}}')}
{{/hasTarget}}
        >
          <{{EntityName}}Page embedded initialPageSize={ {{limit}} }{{#hasPresetFilter}} initialFilters={ {{presetFilterTs}} }{{/hasPresetFilter}}{{#hasColumns}} columns={ {{{columnsTs}}} }{{/hasColumns}}{{#hasSort}} initialSort={ {{{sortTs}}} }{{/hasSort}}{{#hasRecordPage}} onOpenRecord={r => onNavigate('{{recordPageId}}', String(r.{{recordPk}}))}{{/hasRecordPage}} />
        </ListCard>
{{/widgetIsList}}
{{#widgetIsTop}}
        <TopList
          title={ {{titleExpr}} }
          path="{{path}}"
          by="{{groupBy}}"
{{#hasAgg}}
          agg="{{agg}}"
          valueField="{{aggField}}"
{{/hasAgg}}
          limit={ {{limit}} }
{{#hasLabels}}
          labels={ {{labelsRef}} }
{{/hasLabels}}
{{#isRelationRank}}
          optionsPath="{{optionsPath}}"
          optionValue="{{optionValue}}"
{{#hasOptionLabel}}
          optionLabel="{{optionLabel}}"
{{/hasOptionLabel}}
{{/isRelationRank}}
{{#hasParams}}
          params={ {{paramsExpr}} }
{{/hasParams}}
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
{{#hasDrill}}
          onSelect={key => onNavigate('{{drillPageId}}', undefined, { {{drillBase}}{{drillKey}}: key })}
{{/hasDrill}}
{{#hasTarget}}
          onOpen={() => onNavigate('{{targetPageId}}'{{#openWithQuery}}, undefined, queryOf({{paramsExpr}}){{/openWithQuery}})}
{{/hasTarget}}
        />
{{/widgetIsTop}}
{{#widgetIsRecent}}
        <RecentList
          title={ {{titleExpr}} }
          path="{{path}}"
          sortField="{{sortField}}"
{{#hasKeyField}}
          keyField="{{keyField}}"
{{/hasKeyField}}
          displayField="{{displayField}}"
          limit={ {{limit}} }
{{#hasParams}}
          params={ {{paramsExpr}} }
{{/hasParams}}
{{#hasSpanClass}}
          className="{{spanClass}}"
{{/hasSpanClass}}
{{#hasRecordPage}}
          onOpenRow={r => onNavigate('{{recordPageId}}', String(r['{{recordPk}}']))}
{{/hasRecordPage}}
{{#hasTarget}}
          onOpen={() => onNavigate('{{targetPageId}}'{{#openWithQuery}}, undefined, queryOf({{paramsExpr}}){{/openWithQuery}})}
{{/hasTarget}}
        />
{{/widgetIsRecent}}
{{/widgets}}
      </div>
{{#hasRefresh}}
      </RefreshTick.Provider>
{{/hasRefresh}}
    </div>
  )
}
