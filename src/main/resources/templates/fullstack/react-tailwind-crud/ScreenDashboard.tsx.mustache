{{#hasDashFilters}}
  // The filter bar's values{{#hasDateRange}} and the period{{/hasDateRange}}. Routed, they live in the URL, so a reload
  // or bookmark keeps them; embedded as a tab, they are local state.
  const [localQuery, setLocalQuery] = useState<Record<string, string>>({})
  const query = onQueryChange ? routeQuery ?? {} : localQuery
  const setQuery = onQueryChange ?? setLocalQuery
{{#hasDateRange}}
  const period = parsePeriod(query.period, '{{dateRangeDefault}}')
  const setPeriod = (next: Period) => setQuery({ ...query, period: next })
{{/hasDateRange}}
  const filters: FilterValues = Object.fromEntries(Object.entries(query).filter(([k, v]) => k !== 'period' && v !== ''))
  const setFilters = (next: FilterValues) => setQuery({ ...next{{#hasDateRange}}, ...(query.period ? { period: query.period } : {}){{/hasDateRange}} })
  /** The filters a widget's entity takes (by their param names), set to a value — as a query string. */
  const dashValues = (keys: string[]): FilterValues => Object.fromEntries(Object.entries(filters).filter(([k]) => keys.includes(k)))
  const dashParams = (keys: string[]) => new URLSearchParams(dashValues(keys)).toString()
{{/hasDashFilters}}
{{^hasDashFilters}}
{{#hasDateRange}}
  const [localPeriod, setLocalPeriod] = useState<Period>('{{dateRangeDefault}}')
  // The period every widget with a date column is limited to. Routed, it lives in the URL, so a
  // reload or bookmark keeps it; embedded as a tab, it is local state.
  const period = onPeriodChange ? parsePeriod(routePeriod, '{{dateRangeDefault}}') : localPeriod
  const setPeriod = onPeriodChange ?? setLocalPeriod
{{/hasDateRange}}
{{/hasDashFilters}}
{{#hasRefresh}}
