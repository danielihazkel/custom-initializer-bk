import { {{#usesBar}}BreakdownCard, {{/usesBar}}{{#usesKpi}}KpiTile, {{/usesKpi}}{{#hasDateRange}}PeriodSelect, {{/hasDateRange}}{{#usesProgress}}ProgressTile, {{/usesProgress}}{{#usesTop}}TopList, {{/usesTop}}{{#usesLine}}TrendCard, {{/usesLine}}{{#usesRecent}}RecentList, {{/usesRecent}}{{#usesStacked}}StackedCard, {{/usesStacked}}{{#usesText}}TextCard, {{/usesText}}{{#usesList}}ListCard, {{/usesList}}{{#hasRefresh}}RefreshButton, {{/hasRefresh}}} from '@shared/ui/widgets'
{{#listImports}}
import { {{EntityName}}Page } from '@pages/{{entityNameKebab}}'
{{/listImports}}
{{#usesLinks}}
import { LinksCard } from '@shared/ui/links'
{{/usesLinks}}
{{#hasLinkIcons}}
import { {{linkIcons}} } from 'lucide-react'
