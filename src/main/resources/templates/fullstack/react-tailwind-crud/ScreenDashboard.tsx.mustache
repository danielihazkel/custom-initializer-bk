import { {{#hasRefresh}}RefreshTick, {{/hasRefresh}}{{#usesBucketRange}}bucketRange, {{/usesBucketRange}}{{#hasDateRange}}parsePeriod, {{/hasDateRange}}{{#usesQueryOf}}queryOf, {{/usesQueryOf}}{{#usesRangeParams}}rangeParams, {{/usesRangeParams}}{{#usesStatsQuery}}statsQuery, {{/usesStatsQuery}}{{#hasDateRange}}type Period {{/hasDateRange}}} from '@shared/ui/stats'
