      ) : {{/viewCards}}{{#viewKanban}}viewMode === 'kanban' ? (
        <KanbanBoard
          columns={{#listConfigurable}}{shown}{{/listConfigurable}}{{^listConfigurable}}{columns}{{/listConfigurable}}
          rows={items}
          rowKey={rowKey}
          loading={loading}
          groupField="{{kanbanField}}"
          groupValues={[{{#kanbanColumns}}{ value: '{{value}}', label: {{labelExpr}} }{{^last}}, {{/last}}{{/kanbanColumns}}]}
          onView={{#hasPages}}{openRow}{{/hasPages}}{{^hasPages}}{setDetailRow}{{/hasPages}}
          onEdit={openEdit}
          onDelete={setPendingDelete}
          onMove={onKanbanMove}
        />
      ) : {{/viewKanban}}{{#viewCalendar}}viewMode === 'calendar' ? (
        <CalendarView
          columns={{#listConfigurable}}{shown}{{/listConfigurable}}{{^listConfigurable}}{columns}{{/listConfigurable}}
          rows={items}
          rowKey={rowKey}
          loading={loading}
          dateField="{{calendarField}}"
          onView={{#hasPages}}{openRow}{{/hasPages}}{{^hasPages}}{setDetailRow}{{/hasPages}}
        />
      ) : {{/viewCalendar}}{{#viewTable}}viewMode === 'table' ? (
        <Table
          caption="{{entityLabelPlural}}"
          columns={{#listConfigurable}}{shown}{{/listConfigurable}}{{^listConfigurable}}{columns}{{/listConfigurable}}
          rows={items}
          rowKey={rowKey}
          loading={loading}
          onView={{#hasPages}}{openRow}{{/hasPages}}{{^hasPages}}{setDetailRow}{{/hasPages}}
{{#mutable}}          onEdit={openEdit}
          onDelete={setPendingDelete}
{{/mutable}}          sort={sort}
          onSortChange={setSort}
          search={search}
          onSearchChange={setSearch}
{{#hasStringFields}}          searchable={true}
{{/hasStringFields}}{{^hasStringFields}}          searchable={false}
{{/hasStringFields}}{{#bulkSelectApplicable}}          selectable={true}
          isRowSelected={isRowSelected}
          onToggleRow={toggleRow}
          allOnPageSelected={allOnPageSelected}
          onToggleAllOnPage={toggleAllOnPage}
{{/bulkSelectApplicable}}          pagination={pagination}
        />
      ) : {{/viewTable}}null}
{{#mutable}}
      <FormDrawer
        open={drawerOpen}
        title={isNew ? t('newX', { x: '{{entityLabel}}' }) : t('editX', { x: '{{entityLabel}}' })}
        subtitle={isNew ? t('createXBlurb', { x: '{{entityLabel}}' }) : t('updateXBlurb', { x: '{{entityLabel}}' })}
        onClose={close}
        onSave={save}
        saving={saving}
        dirty={dirty}
      >
        {editing && (
          <{{EntityName}}Form
            value={editing}
            onChange={next => {
              // Clear the message of any field the user just edited; the others stay until the
              // next save re-validates.
              const before = (editing ?? {}) as Record<string, unknown>
              const after = next as Record<string, unknown>
              const changed = Object.keys(after).filter(k => after[k] !== before[k] && k in formErrors)
              if (changed.length > 0) {
                setFormErrors(prev => {
                  const copy = { ...prev }
                  for (const k of changed) delete copy[k]
                  return copy
                })
              }
              setEditing(next)
            }}
            errors={formErrors}
            isNew={isNew}
          />
        )}
      </FormDrawer>

      <ConfirmDialog
        open={pendingDelete !== null}
        title={t('deleteX', { x: '{{entityLabel}}' })}
        message={t('undoHint')}
        busy={deleting}
        onConfirm={confirmDelete}
        onCancel={() => setPendingDelete(null)}
      />
{{/mutable}}{{#bulkDeleteApplicable}}{{#viewTable}}
      <ConfirmDialog
        open={bulkConfirm}
        title={t('deleteNX', { n: selected.length, x: '{{entityLabel}}', unit: t(selected.length === 1 ? 'record' : 'records') })}
        message={t('cannotUndo')}
        busy={bulkBusy}
        onConfirm={runBulkDelete}
        onCancel={() => setBulkConfirm(false)}
      />
{{/viewTable}}{{/bulkDeleteApplicable}}
      <DetailDrawer
        open={detailRow !== null}
        title={t('xDetails', { x: '{{entityLabel}}' })}
        onClose={() => setDetailRow(null)}
{{#mutable}}        onEdit={() => { if (detailRow) { openEdit(detailRow); setDetailRow(null) } }}
{{/mutable}}      >
        {detailRow && <{{EntityName}}Detail value={detailRow} />}
      </DetailDrawer>
    </div>
  )
}
