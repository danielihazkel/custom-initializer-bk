{{/relations}}{{#collections}}  { {{#listConfigurable}}key: '{{fieldName}}', {{/listConfigurable}}label: '{{labelTs}}', render: r => r.{{labelsField}} == null || r.{{labelsField}}.length === 0 ? '—' : r.{{labelsField}}.join(', ') },
{{/collections}}{{#auditApplicable}}  { {{#listConfigurable}}key: 'createdAt', {{/listConfigurable}}label: t('created'), sortKey: 'createdAt', numeric: true, render: r => r.createdAt == null ? '—' : new Date(r.createdAt).toLocaleString(LOCALE) },
  { {{#listConfigurable}}key: 'updatedAt', {{/listConfigurable}}label: t('updated'), sortKey: 'updatedAt', numeric: true, render: r => r.updatedAt == null ? '—' : new Date(r.updatedAt).toLocaleString(LOCALE) },
  { {{#listConfigurable}}key: 'createdBy', {{/listConfigurable}}label: t('createdBy'), sortKey: 'createdBy', render: r => r.createdBy ?? '—' },
  { {{#listConfigurable}}key: 'updatedBy', {{/listConfigurable}}label: t('updatedBy'), sortKey: 'updatedBy', render: r => r.updatedBy ?? '—' },
{{/auditApplicable}}{{#childLists}}  { {{#listConfigurable}}key: '{{collectionField}}Count', {{/listConfigurable}}label: '{{collectionLabelTs}}', numeric: true, render: r => r.{{collectionField}}Count == null ? '—' : String(r.{{collectionField}}Count) },
{{/childLists}}]
{{#hasViewToggle}}
