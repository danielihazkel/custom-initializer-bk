            <>
              <div className="mb-4 flex items-start justify-between gap-3">
                <h2 className="text-sm font-semibold text-fg">{t('xDetails', { x: '{{entityLabelTs}}' })}</h2>
                <div className="flex items-center gap-3">
{{#mutable}}
{{^listActionsConfigurable}}
                  <button type="button" onClick={() => list.openEdit(selectedRow)} className="text-xs font-medium text-brand hover:underline">{t('edit')}</button>
                  <button type="button" onClick={() => list.setPendingDelete(selectedRow)} className="text-xs font-medium text-brand hover:underline">{t('delete')}</button>
{{/listActionsConfigurable}}
{{#listActionsConfigurable}}
                  {list.can('edit'){{#listOwnWrites}} && list.mine(selectedRow){{/listOwnWrites}} && <button type="button" onClick={() => list.openEdit(selectedRow)} className="text-xs font-medium text-brand hover:underline">{t('edit')}</button>}
                  {list.can('delete'){{#listOwnWrites}} && list.mine(selectedRow){{/listOwnWrites}} && <button type="button" onClick={() => list.setPendingDelete(selectedRow)} className="text-xs font-medium text-brand hover:underline">{t('delete')}</button>}
{{/listActionsConfigurable}}
{{/mutable}}
                  <button type="button" onClick={() => props.onSelect?.(undefined)} className="text-xs font-medium text-muted hover:text-fg" aria-label={t('close')}>×</button>
                </div>
              </div>
              <{{EntityName}}Detail value={selectedRow} />
{{#historyApplicable}}              <{{EntityName}}History id={String(list.rowKey(selectedRow))} version={selectedRow} onRestored={next => { list.setFetchedRow(next); void list.reload() }} />
{{/historyApplicable}}
{{#hasWorkflow}}
              <div className="mt-4 border-t border-border pt-4">
                <{{EntityName}}Transitions row={selectedRow} onDone={next => { list.setFetchedRow(next); void list.reload() }} />
              </div>
{{/hasWorkflow}}
            </>
