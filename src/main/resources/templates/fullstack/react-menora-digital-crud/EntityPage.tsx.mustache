      </div>
{{/hasFilters}}{{#bulkSelectApplicable}}{{#viewTable}}      {list.selected.length > 0 && (
        <div className="mn-panel mn-panel--lined mb-4 flex flex-wrap items-center justify-between gap-3 px-4 py-2.5">
          <Chip weight={600} label={t('nSelected', { n: list.selected.length })} />
          <div className="flex flex-wrap items-center gap-2">
{{#bulkUpdateApplicable}}            <select
              value={list.bulkField}
              onChange={e => { list.setBulkField(e.target.value); list.setBulkValue('') }}
              className="mn-field"
              aria-label={t('fieldToEdit')}
            >
              <option value="">{t('setField')}</option>
{{#bulkUpdatableFields}}              <option value="{{name}}">{{labelJsx}}</option>
{{/bulkUpdatableFields}}            </select>
            {list.bulkField && (() => {
              const meta = list.bulkFields[list.bulkField]
              if (!meta) return null
              const cls = 'mn-field'
              if (meta.kind === 'boolean') return (
                <select value={list.bulkValue} onChange={e => list.setBulkValue(e.target.value)} className={cls} aria-label={t('newValue')}>
                  <option value="">—</option>
                  <option value="true">{t('trueLabel')}</option>
                  <option value="false">{t('falseLabel')}</option>
                </select>
              )
              if (meta.kind === 'enum') return (
                <select value={list.bulkValue} onChange={e => list.setBulkValue(e.target.value)} className={cls} aria-label={t('newValue')}>
                  <option value="">—</option>
                  {meta.options!.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
                </select>
              )
              const type = meta.kind === 'number' ? 'number' : meta.kind === 'date' ? 'date' : meta.kind === 'datetime' ? 'datetime-local' : 'text'
              return <input type={type} value={list.bulkValue} onChange={e => list.setBulkValue(e.target.value)} className={cls} placeholder={t('newValue')} aria-label={t('newValue')} />
            })()}
            {/* Native button: the Button port has no `disabled`. */}
            <button
              type="button"
              onClick={list.runBulkUpdate}
              disabled={!list.bulkField || list.bulkUpdating}
              className="mn mn-btn mn-btn--primary mn-btn--compact"
            >
              {t('apply')}
            </button>
{{/bulkUpdateApplicable}}            <Button variant="text" label={t('clear')} onClick={() => list.setSelected([])} />
{{#bulkDeleteApplicable}}            <button
              type="button"
              onClick={() => list.setBulkConfirm(true)}
              className="inline-flex items-center gap-2 rounded-full bg-danger px-4 py-2 text-sm font-medium text-white transition-colors hover:opacity-90"
            >
              <Trash2 className="h-4 w-4" />
              {t('delete')}
            </button>
{{/bulkDeleteApplicable}}          </div>
        </div>
      )}
{{/viewTable}}{{/bulkSelectApplicable}}
{{#listSideDetail}}
      <div className={props.sidePane ? 'grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]' : ''}>
      <div className="min-w-0">
{{/listSideDetail}}
      {
{{#viewCards}}      list.viewMode === 'cards' ? (
        <CardGrid
          columns={list.columns}
          rows={list.items}
          rowKey={list.rowKey}
          loading={list.loading}
          onView={{#hasPages}}{list.openRow}{{/hasPages}}{{^hasPages}}{list.setDetailRow}{{/hasPages}}
{{#mutable}}{{^listActionsConfigurable}}          onEdit={list.openEdit}
          onDelete={list.setPendingDelete}
{{/listActionsConfigurable}}{{#listActionsConfigurable}}          onEdit={list.editRow}
          onDelete={list.deleteRow}
{{/listActionsConfigurable}}{{/mutable}}          search={list.search}
          onSearchChange={list.setSearch}
{{#hasStringFields}}          searchable={true}
{{/hasStringFields}}{{^hasStringFields}}          searchable={false}
{{/hasStringFields}}          pagination={list.pagination}
          filtered={list.filtered}
{{#mutable}}          emptyAction={list.emptyAction}
{{/mutable}}        />
      ) : {{/viewCards}}{{#viewKanban}}list.viewMode === 'kanban' ? (
        <KanbanBoard
          columns={list.columns}
          rows={list.items}
          rowKey={list.rowKey}
          loading={list.loading}
          groupField="{{kanbanField}}"
          groupValues={[{{#kanbanColumns}}{ value: '{{value}}', label: {{labelExpr}} }{{^last}}, {{/last}}{{/kanbanColumns}}]}
          onView={{#hasPages}}{list.openRow}{{/hasPages}}{{^hasPages}}{list.setDetailRow}{{/hasPages}}
{{^listActionsConfigurable}}          onEdit={list.openEdit}
          onDelete={list.setPendingDelete}
          onMove={list.onKanbanMove}
{{/listActionsConfigurable}}{{#listActionsConfigurable}}          onEdit={list.editRow}
          onDelete={list.deleteRow}
          onMove={list.can('edit') ? list.onKanbanMove : undefined}
{{/listActionsConfigurable}}
          totals={list.laneTotals}
          filtered={list.filtered}
          emptyAction={list.emptyAction}
{{#kanbanShowsLane}}
          onShowLane={value => { list.setFilters(f => ({ ...f, {{kanbanField}}: value })); list.setViewMode('table') }}
{{/kanbanShowsLane}}
        />
      ) : {{/viewKanban}}{{#viewCalendar}}list.viewMode === 'calendar' ? (
        <CalendarView
          columns={list.columns}
          rows={list.items}
          rowKey={list.rowKey}
          loading={list.loading}
          dateField="{{calendarField}}"
          filtered={list.filtered}
          onView={{#hasPages}}{list.openRow}{{/hasPages}}{{^hasPages}}{list.setDetailRow}{{/hasPages}}
{{#calendarRanged}}
          onRangeChange={list.onCalendarRange}
          total={list.calendarRange ? list.totalElements : undefined}
{{/calendarRanged}}
        />
      ) : {{/viewCalendar}}{{#viewGallery}}list.viewMode === 'gallery' ? (
        <GalleryView
          columns={list.columns}
          rows={list.items}
          rowKey={list.rowKey}
          imageField="{{galleryField}}"
          imageLabel={'{{galleryLabelTs}}'}
          loading={list.loading}
          onView={{#hasPages}}{list.openRow}{{/hasPages}}{{^hasPages}}{list.setDetailRow}{{/hasPages}}
          search={list.search}
          onSearchChange={list.setSearch}
{{#hasStringFields}}          searchable={true}
{{/hasStringFields}}{{^hasStringFields}}          searchable={false}
{{/hasStringFields}}          pagination={list.pagination}
          filtered={list.filtered}
{{#mutable}}          emptyAction={list.emptyAction}
{{/mutable}}        />
      ) : {{/viewGallery}}{{#viewTable}}list.viewMode === 'table' ? (
        <Table
          caption="{{entityLabelPluralAttr}}"
          columns={{#inlineEditApplicable}}{{#listActionsConfigurable}}{list.can('edit') ? list.inline(list.columns) : list.columns}{{/listActionsConfigurable}}{{^listActionsConfigurable}}{list.inline(list.columns)}{{/listActionsConfigurable}}{{/inlineEditApplicable}}{{^inlineEditApplicable}}{list.columns}{{/inlineEditApplicable}}
          columnMenu={list.columnMenu}
          rows={list.items}
          rowKey={list.rowKey}
          loading={list.loading}
          onView={{#hasPages}}{list.openRow}{{/hasPages}}{{^hasPages}}{list.setDetailRow}{{/hasPages}}
{{#mutable}}{{^listActionsConfigurable}}          onEdit={list.openEdit}
          onDelete={list.setPendingDelete}
{{/listActionsConfigurable}}{{#listActionsConfigurable}}          onEdit={list.editRow}
          onDelete={list.deleteRow}
{{/listActionsConfigurable}}{{/mutable}}          sort={list.sort}
          onSortChange={list.setSort}
          search={list.search}
          onSearchChange={list.setSearch}
{{#hasStringFields}}          searchable={true}
{{/hasStringFields}}{{^hasStringFields}}          searchable={false}
{{/hasStringFields}}{{#bulkSelectApplicable}}{{^listActionsConfigurable}}          selectable={true}{{/listActionsConfigurable}}{{#listActionsConfigurable}}          selectable={list.can('bulk')}{{/listActionsConfigurable}}
          isRowSelected={list.isRowSelected}
          onToggleRow={list.toggleRow}
          allOnPageSelected={list.allOnPageSelected}
          onToggleAllOnPage={list.toggleAllOnPage}
{{/bulkSelectApplicable}}          pagination={list.pagination}
          filtered={list.filtered}
{{#mutable}}          emptyAction={list.emptyAction}
{{/mutable}}        />
      ) : {{/viewTable}}null}
{{#listSideDetail}}
      </div>
