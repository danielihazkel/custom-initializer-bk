{{/optScaffoldSavedViews}}{{#auditApplicable}}          <Button variant="outlined" className="mn-btn--compact" label={(list.changedByMe ? '✓ ' : '') + t('changedByMe')} onClick={() => list.setChangedByMe(on => !on)} />
{{/auditApplicable}}{{#optScaffoldCsvExport}}          {{#listActionsConfigurable}}{list.can('export') && {{/listActionsConfigurable}}<Button variant="outlined" className="mn-btn--compact" label={list.download.busy ? t('exporting') : t('export')} onClick={() => list.download.run(() => list.exportCsv('{{entityNamePluralKebab}}.csv'))} />{{#listActionsConfigurable}}}{{/listActionsConfigurable}}
{{/optScaffoldCsvExport}}{{#optScaffoldXlsxExport}}          {{#listActionsConfigurable}}{list.can('export') && {{/listActionsConfigurable}}<Button variant="outlined" className="mn-btn--compact" label={t('excel')} onClick={() => list.download.run(list.exportXlsx)} />{{#listActionsConfigurable}}}{{/listActionsConfigurable}}
{{/optScaffoldXlsxExport}}{{#importApplicable}}          {{#listActionsConfigurable}}{list.can('import') && {{/listActionsConfigurable}}<Button variant="outlined" className="mn-btn--compact" label={t('import')} onClick={ {{#hasImportPage}}props.onImport ?? {{/hasImportPage}}(() => list.setImporting(true)) } />{{#listActionsConfigurable}}}{{/listActionsConfigurable}}
{{/importApplicable}}{{#mutable}}          {{#listActionsConfigurable}}{list.can('new') && {{/listActionsConfigurable}}<Button variant="primary" className="mn-btn--compact" label={t('newX', { x: '{{entityLabelTs}}' })} {{^hasCreatePage}}onClick={list.openNew}{{/hasCreatePage}}{{#hasCreatePage}}onClick={props.onCreate ?? list.openNew}{{/hasCreatePage}} />{{#listActionsConfigurable}}}{{/listActionsConfigurable}}
{{/mutable}}        </div>
      </div>

      {list.error && (
