import { useEffect, useState } from 'react'
import { api } from '@shared/api'
import { t } from '@shared/i18n'
{{#entities}}{{#breakdownEnumTypeName}}import { {{breakdownEnumTypeName}}Labels } from '@entities/{{entityNameKebab}}'
{{/breakdownEnumTypeName}}{{/entities}}
import { Hero, ActionPanel, SectionHeader } from '@shared/ui/menora'

interface CardDef {
  label: string
  view: string
  path: string
}

const CARDS: CardDef[] = [
{{#entities}}
  { label: '{{entityLabelPlural}}', view: '{{entityNameKebab}}', path: '/api/{{entityNamePluralKebab}}' },
{{/entities}}
]

interface ChartDef {
  label: string
  path: string
  field: string
  /** Enum breakdowns: display label per constant, so the bars read like the rest of the app. */
  labels?: Record<string, string>
}

// One breakdown per entity that has a low-cardinality (enum/boolean) field. Grouped client-side
// from a sample page (see useBreakdown), so the chart labels itself as a sample on large tables.
const CHARTS: ChartDef[] = [
{{#entities}}{{#hasBreakdown}}  { label: t('xByY', { x: '{{entityLabelPlural}}', y: '{{breakdownLabel}}' }), path: '/api/{{entityNamePluralKebab}}', field: '{{breakdownField}}'{{#breakdownEnumTypeName}}, labels: {{breakdownEnumTypeName}}Labels{{/breakdownEnumTypeName}} },
{{/hasBreakdown}}{{/entities}}]

// The 22px line icon every action disc holds (stroke currentColor, so it inherits on-yellow).
const tableGlyph = (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" aria-hidden="true">
    <rect x="4" y="5" width="16" height="14" rx="2" />
    <path d="M4 10h16M10 10v9" />
  </svg>
)

/** Reads just the page metadata (size=1) to surface a live record count per entity. */
function useCount(path: string) {
  const [count, setCount] = useState<number | null>(null)
  const [failed, setFailed] = useState(false)

  useEffect(() => {
    let active = true
    api.get<{ totalElements: number }>(`${path}?size=1`)
      .then(p => { if (active) setCount(p.totalElements) })
      .catch(() => { if (active) setFailed(true) })
    return () => { active = false }
  }, [path])

  return { count, failed }
}

/** Groups the records by `field` through the entity's /stats rollup — one request, exact totals,
 *  and no page of rows crossing the wire. */
function useBreakdown(path: string, field: string, labels?: Record<string, string>) {
  const [data, setData] = useState<{ label: string; count: number }[] | null>(null)
  const [failed, setFailed] = useState(false)

  useEffect(() => {
    let active = true
    api.get<{ buckets: { key: string; value: number | null }[] }>(`${path}/stats?groupBy=${field}`)
      .then(s => {
        if (!active) return
        const buckets = s.buckets ?? []
        setData(buckets
          .map(b => {
            const raw = b.key === '' ? '—' : b.key
            return { label: labels?.[raw] ?? raw, count: b.value ?? 0 }
          })
          .sort((a, b) => b.count - a.count))
      })
      .catch(() => { if (active) setFailed(true) })
    return () => { active = false }
    // `labels` is a module-level constant (the CHARTS entry), so it never changes identity.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [path, field])

  return { data, failed }
}

function BarChart({ data }: { data: { label: string; count: number }[] }) {
  const max = data.reduce((m, d) => Math.max(m, d.count), 0) || 1
  return (
    <div className="space-y-2">
      {data.map(d => (
        <div key={d.label} className="flex items-center gap-3 text-sm">
          <div className="w-28 shrink-0 truncate text-muted" title={d.label}>{d.label}</div>
          <div className="h-2.5 flex-1 overflow-hidden rounded-full bg-surface-2">
            <div className="h-full rounded-full bg-brand" style={{ width: `${(d.count / max) * 100}%` }} />
          </div>
          <div className="w-8 shrink-0 text-end tabular-nums text-fg">{d.count}</div>
        </div>
      ))}
    </div>
  )
}

function ChartCard({ chart }: { chart: ChartDef }) {
  const { data, failed } = useBreakdown(chart.path, chart.field, chart.labels)
  return (
    <div className="mn-panel mn-panel--lined p-6">
      <div className="mb-4 text-base font-semibold text-fg">{chart.label}</div>
      {failed ? (
        <div className="text-sm text-muted">{t('couldNotLoad')}</div>
      ) : data == null ? (
        <div className="text-sm text-muted">…</div>
      ) : data.length === 0 ? (
        <div className="text-sm text-muted">{t('noRecordsYetDot')}</div>
      ) : (
        <BarChart data={data} />
      )}
    </div>
  )
}

/** A white surface card with the live record count in ink tabular figures and the collection label in micro. */
function StatCard({ card, onNavigate }: { card: CardDef; onNavigate: (view: string) => void }) {
  const { count, failed } = useCount(card.path)
  return (
    <button
      onClick={() => onNavigate(card.view)}
      className="mn-panel mn-panel--lined flex flex-col p-6 text-start transition-transform hover:-translate-y-0.5"
    >
      <div className="text-[28px] font-semibold leading-[30px] tabular-nums text-fg">
        {failed ? '—' : count == null ? <span className="text-muted">…</span> : count}
      </div>
      <div className="mt-2 text-sm text-muted">{card.label}</div>
    </button>
  )
}

interface Props {
  onNavigate: (view: string) => void
}

export function DashboardPage({ onNavigate }: Props) {
  return (
    <div className="mx-auto w-full max-w-[1283px] px-4 py-5 md:px-6 md:py-8">
      {/* Menora hero: the display headline whose full stop is the yellow action colour, and a light lead line.
          No CTA here — the ActionPanel directly under it is the shortcut bar, one yellow disc per collection. */}
      <div className="mb-6">
        <Hero
          title={ {{#dashboardTitle}}'{{dashboardTitle}}.'{{/dashboardTitle}}{{^dashboardTitle}}t('welcomeTo', { name: '{{artifactId}}' }) + '.'{{/dashboardTitle}} }
          lead={ {{#dashboardOverview}}'{{dashboardOverview}}'{{/dashboardOverview}}{{^dashboardOverview}}t('manageBlurb'){{/dashboardOverview}} }
        />
      </div>
      {CARDS.length > 0 && (
        <div className="mb-10">
          <ActionPanel
            ariaLabel={t('collections')}
            items={CARDS.map(card => ({ label: card.label, icon: tableGlyph, href: '#', onClick: () => onNavigate(card.view) }))}
          />
        </div>
      )}

      <div className="mb-4"><SectionHeader title={t('collections')} align="start" /></div>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {CARDS.map(card => (
          <StatCard key={card.view} card={card} onNavigate={onNavigate} />
        ))}
      </div>

      {CHARTS.length > 0 && (
        <>
          <div className="mb-4 mt-10"><SectionHeader title={t('breakdowns')} align="start" /></div>
          <div className="grid grid-cols-1 gap-4 lg:grid-cols-2">
            {CHARTS.map(chart => <ChartCard key={chart.label} chart={chart} />)}
          </div>
        </>
      )}
    </div>
  )
}
