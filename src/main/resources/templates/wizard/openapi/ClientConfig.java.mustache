package {{package}};

import org.springframework.boot.web.client.RestTemplateBuilder;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.web.client.RestTemplate;

/**
 * Provides the RestTemplate bean used by the generated OpenAPI clients.
 * The base URL is read from the {@code {{baseUrlProperty}}} property
 * in application.yaml.
 */
@Configuration
public class OpenApiClientConfig {

    @Bean
    public RestTemplate openApiRestTemplate(RestTemplateBuilder builder) {
        return builder.build();
    }
}
