    void readsAMessageThroughTheRegistry() {
        Map<String, Object> config = Map.of("schema.registry.url", "mock://{{stem}}ListenerTest",
                "auto.register.schemas", true, "specific.avro.reader", true);
        try (KafkaAvroSerializer serializer = new KafkaAvroSerializer();
             KafkaAvroDeserializer deserializer = new KafkaAvroDeserializer()) {
            serializer.configure(config, false);
            deserializer.configure(config, false);
            SpecificRecord written = {{listenerSample}};
            Object read = deserializer.deserialize("topic-under-test", serializer.serialize("topic-under-test", written));
            assertThat(read).isEqualTo(written);

            ConsumerRecord record = new ConsumerRecord<>("topic-under-test", 0, 0L, {{listenerTestKey}}, read);
            assertThatCode(() -> listener.onMessage(record)).doesNotThrowAnyException();
        }
    }

