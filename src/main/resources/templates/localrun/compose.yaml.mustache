# {{#apps}}The whole application on a developer's machine: the services it needs, its backend and
# its frontend, each built from its own Dockerfile.
#
#   docker compose up --build       then open http://localhost:3000 (the API is on :8080)
#   docker compose down             stops it and throws the data away{{/apps}}{{^apps}}The services this project needs, on a developer's machine.
#
#   docker compose up -d
#   mvn spring-boot:run -Dspring-boot.run.profiles={{profiles}}
#   docker compose down             stops them and throws the data away{{/apps}}
#
# The `compose` profile ({{profilePath}}) points the
# application at these containers. The passwords here are for this machine only, never a
# server's.{{#unsupported}}
#
# {{.}}{{/unsupported}}
name: {{name}}

services:
{{#postgresql}}
  postgres:
    image: {{postgresImage}}
    environment:
      POSTGRES_DB: appdb
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d appdb"]
      interval: 5s
      timeout: 5s
      retries: 30
{{/postgresql}}
{{#oracle}}
  oracle:
    image: {{oracleImage}}
    environment:
      ORACLE_PASSWORD: password
      APP_USER: appuser
      APP_USER_PASSWORD: password
    ports:
      - "1521:1521"
    healthcheck:
      test: ["CMD", "healthcheck.sh"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
{{/oracle}}
{{#mssql}}
  mssql:
    image: {{mssqlImage}}
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_SA_PASSWORD: "LocalDev-Passw0rd"
    ports:
      - "1433:1433"
    healthcheck:
      # Healthy once the appdb database exists: the check creates it.
      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -C -b -S localhost -U sa -P \"$$MSSQL_SA_PASSWORD\" -Q \"IF DB_ID('appdb') IS NULL CREATE DATABASE appdb\""]
      interval: 10s
      timeout: 10s
      retries: 30
      start_period: 20s
{{/mssql}}
{{#mongodb}}
  mongo:
    image: {{mongoImage}}
    ports:
      - "27017:27017"
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 5s
      timeout: 5s
      retries: 30
{{/mongodb}}
{{#redis}}
  redis:
    image: {{redisImage}}
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 30
{{/redis}}
{{#kafka}}
  kafka:
    image: {{kafkaImage}}
    environment:
      # One broker, no TLS or SASL: localhost:9092 from this machine, kafka:29092 from a container.
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,DOCKER://:29092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://localhost:9092,DOCKER://kafka:29092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,DOCKER:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:9093
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
    ports:
      - "9092:9092"
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 > /dev/null 2>&1"]
      interval: 10s
      timeout: 10s
      retries: 30
      start_period: 15s
{{/kafka}}
{{#apps}}
  backend:
    build: ./backend
    # The image's own command, on the compose profile{{#ldap}} and the local one (dev-user is an admin){{/ldap}}.
    command: ["java", "-Duser.timezone=Asia/Jerusalem", "-XX:+UseContainerSupport", "-jar", "/app/springboot-app.jar", "--spring.profiles.active={{profiles}}"]
{{#hasBackendEnv}}
    environment:
{{#backendEnv}}
      {{name}}: "{{value}}"
{{/backendEnv}}
{{/hasBackendEnv}}
    ports:
      - "8080:3000"
{{#hasDependsOn}}
    depends_on:
{{#dependsOn}}
      {{.}}:
        condition: service_healthy
{{/dependsOn}}
{{/hasDependsOn}}
  frontend:
    build: ./frontend
    environment:
      API_UPSTREAM: "http://backend:3000"
{{#ldap}}
      # nginx signs calls that come without a userinfo header as dev-user (no SSO gateway here).
      DEV_USERINFO_ENABLED: "on"
      DEV_USERINFO_DEFAULT: "dev-user"
{{/ldap}}
    ports:
      - "3000:3000"
    depends_on:
      - backend
{{/apps}}
