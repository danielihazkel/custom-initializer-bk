package {{packageName}}.web;

import {{packageName}}.security.Constants;
import {{packageName}}.security.RequiresPermission;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.Map;

/**
 * Demonstrates the {@link RequiresPermission} authorization guard. The {@code PermissionAspect}
 * intercepts the annotated method, reads the {@code userinfo} header, and resolves the caller's
 * LDAP groups before the body runs. Methods must return {@link ResponseEntity} so the aspect can
 * short-circuit with 401/403 when access is denied.
 */
@RestController
@RequestMapping("/api/secured")
public class SampleSecuredController {

    @GetMapping("/admin")
    @RequiresPermission(Constants.ADMIN)
    public ResponseEntity<?> adminOnly() {
        return ResponseEntity.ok(Map.of("message", "Hello, admin — you are authorized."));
    }

    @GetMapping("/user")
    @RequiresPermission(Constants.USER)
    public ResponseEntity<?> userOnly() {
        return ResponseEntity.ok(Map.of("message", "Hello — you have read access."));
    }
}
