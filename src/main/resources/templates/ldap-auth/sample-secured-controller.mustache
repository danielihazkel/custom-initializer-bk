package {{packageName}}.web;

import {{packageName}}.security.Constants;
import {{packageName}}.security.RequiresPermission;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.Map;

/**
 * Demonstrates the {@link RequiresPermission} authorization guard. The {@code PermissionAspect}
 * intercepts the annotated method, reads the {@code userinfo} header, and resolves the caller's
 * LDAP groups before the body runs. When access is denied the aspect throws a 401/403, so the
 * guarded method may return any type — these handlers return a plain object, just like the
 * generated CRUD controllers return their DTOs.
 */
@RestController
@RequestMapping("/api/secured")
public class SampleSecuredController {

    @GetMapping("/admin")
    @RequiresPermission(Constants.ADMIN)
    public Map<String, String> adminOnly() {
        return Map.of("message", "Hello, admin — you are authorized.");
    }

    @GetMapping("/user")
    @RequiresPermission(Constants.USER)
    public Map<String, String> userOnly() {
        return Map.of("message", "Hello — you have read access.");
    }
}
