{
  "systemName": "{{artifactId}}",
  "appName": "{{artifactId}}",
  "logType": "technical-info",
  "uuid": {
    "$resolver": "mdc",
    "key": "uuid"
  },
  "version": "1.1",
  "host": "${hostName}",
  "javaHome": "${env:JAVA_HOME:-NOT_FOUND}",
  "operatingSystem": "${sys:os.name:-}",
  "serviceName": {
    "$resolver": "mdc",
    "key": "serviceName"
  },
  "methodName": {
    "$resolver": "mdc",
    "key": "methodName"
  },
  "status": {
    "$resolver": "mdc",
    "key": "techStatusId"
  },
  "positionStatus": {
    "$resolver": "mdc",
    "key": "position"
  },
  "eventTimeStamp": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSS"
    }
  },
  "level": {
    "$resolver": "level",
    "field": "name"
  },
  "loggerName": {
    "$resolver": "logger",
    "field": "name"
  },
  "message": {
    "$resolver": "message",
    "stringified": true
  },
  "error": {
    "$resolver": "exception",
    "field": "className"
  },
  "errorDescription": {
    "$resolver": "exception",
    "field": "message"
  },
  "stacktrace": {
    "$resolver": "exception",
    "field": "stackTrace",
    "stackTrace": {
      "stringified": true
    }
  }
}
