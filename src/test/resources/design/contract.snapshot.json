{
  "contractVersion" : 1,
  "runtimeProtocol" : 5,
  "tokenSchema" : {
    "schema" : "menora-design-tokens/1",
    "required" : [ {
      "name" : "color-brand",
      "type" : "color",
      "description" : "Identity colour: active nav, focus, charts, links"
    }, {
      "name" : "color-brand-deep",
      "type" : "color",
      "description" : "Brand hover/pressed shade"
    }, {
      "name" : "color-primary",
      "type" : "color",
      "description" : "Primary action fill (New, Save, Edit)"
    }, {
      "name" : "color-primary-deep",
      "type" : "color",
      "description" : "Primary action hover"
    }, {
      "name" : "color-on-primary",
      "type" : "color",
      "description" : "Text on a primary action"
    }, {
      "name" : "color-ink",
      "type" : "color",
      "description" : "Dark band of the classic dashboard's heading"
    }, {
      "name" : "color-ink-soft",
      "type" : "color",
      "description" : "Sidebar active/hover item; end of the dashboard heading band"
    }, {
      "name" : "color-gold",
      "type" : "color",
      "description" : "Highlight accent: active nav marker and icon"
    }, {
      "name" : "color-success",
      "type" : "color",
      "description" : "Positive state"
    }, {
      "name" : "color-danger",
      "type" : "color",
      "description" : "Destructive / error state"
    }, {
      "name" : "color-canvas",
      "type" : "color",
      "description" : "Page ground"
    }, {
      "name" : "color-surface",
      "type" : "color",
      "description" : "Cards, tables, drawers"
    }, {
      "name" : "color-surface-2",
      "type" : "color",
      "description" : "Subtle fills, hover rows"
    }, {
      "name" : "color-fg",
      "type" : "color",
      "description" : "Body text"
    }, {
      "name" : "color-muted",
      "type" : "color",
      "description" : "Secondary text"
    }, {
      "name" : "color-border",
      "type" : "color",
      "description" : "Hairlines and borders"
    }, {
      "name" : "color-ring",
      "type" : "color",
      "description" : "Focus ring"
    }, {
      "name" : "font-sans",
      "type" : "font",
      "description" : "The app's typeface stack"
    } ],
    "shell" : [ {
      "name" : "color-shell",
      "type" : "color",
      "description" : "Shell band: the sidebar, or the top bar",
      "value" : "var(--color-brand)"
    }, {
      "name" : "color-shell-end",
      "type" : "color",
      "description" : "Where the shell band's gradient ends (its bottom edge)",
      "value" : "var(--color-gold)"
    }, {
      "name" : "color-on-shell",
      "type" : "color",
      "description" : "Text and hairlines on the shell band",
      "value" : "#ffffff"
    }, {
      "name" : "color-on-shell-muted",
      "type" : "color",
      "description" : "Nav links and section labels on the shell band",
      "value" : "#cbd5e1"
    } ],
    "namePattern" : "^(color|font|text|radius|shadow|spacing|leading|tracking|font-weight|ease|blur|drop-shadow|inset-shadow)-[a-z0-9]+(-[a-z0-9]+)*$",
    "types" : [ "color", "font", "radius", "shadow", "length", "number" ],
    "paletteReferences" : [ "{palette.primary}", "{palette.secondary}", "{palette.accent|<fallback>}", "{palette.error|<fallback>}" ]
  },
  "pageTypes" : [ "entity-list", "dashboard", "tabs", "master-detail", "record", "report", "wizard", "calendar", "board", "content", "import", "search", "form", "inbox" ],
  "widgetKinds" : [ "kpi", "bar", "line", "recent", "top", "progress", "donut", "stacked", "text", "links", "list", "pivot", "activity" ],
  "chartKinds" : [ "bar", "donut", "stacked", "line", "area", "table" ],
  "aggs" : [ "count", "sum", "avg", "min", "max" ],
  "buckets" : [ "day", "month", "year" ],
  "dateRanges" : [ "all", "7d", "30d", "90d", "ytd", "12m" ],
  "navStyles" : [ "sidebar", "topbar" ],
  "navIcons" : [ "BarChart3", "Building2", "Calendar", "Columns3", "FilePlus", "FileText", "Inbox", "Layers", "LayoutDashboard", "ListChecks", "Package", "PanelLeft", "Search", "Settings", "ShoppingCart", "Star", "Table2", "Tag", "Ticket", "Truck", "Upload", "Users", "Wallet", "Wand2" ],
  "assetRoles" : [ "LOGO", "FAVICON", "FONT", "ICON", "IMAGE", "THUMBNAIL" ],
  "assetTypes" : [ "image/png", "image/jpeg", "image/webp", "image/svg+xml", "image/x-icon", "font/woff2", "font/woff" ],
  "limits" : {
    "assetBytes" : 2097152,
    "versionAssetBytes" : 10485760,
    "kitCssBytes" : 65536,
    "tokens" : 200,
    "tokenValueChars" : 300
  },
  "components" : {
    "slotPattern" : "^src/shared/ui/[A-Za-z0-9_-]+\\.tsx$",
    "helperPattern" : "^src/shared/ui/[a-z][a-z0-9_-]*/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.(?:tsx|ts|css)$",
    "allowedImports" : [ "react", "react-dom", "react-dom/client", "react/jsx-runtime", "lucide-react", "clsx", "sonner" ],
    "alsoAllowed" : [ "@shared/…", "relative paths inside src/shared" ],
    "refused" : [ "calls fetch() — components get their data from the generator's hooks (@shared/api)", "opens a network connection", "imports a module at run time (import())", "evaluates code from a string", "writes raw HTML", "reads or writes cookies", "reaches another window" ],
    "refusedPatterns" : [ {
      "pattern" : "\\bfetch\\s*\\(",
      "message" : "calls fetch() — components get their data from the generator's hooks (@shared/api)"
    }, {
      "pattern" : "\\b(?:XMLHttpRequest|WebSocket|EventSource)\\b|\\bsendBeacon\\b",
      "message" : "opens a network connection"
    }, {
      "pattern" : "\\bimport\\s*\\(",
      "message" : "imports a module at run time (import())"
    }, {
      "pattern" : "\\beval\\s*\\(|\\bnew\\s+Function\\b|(?<![\\w.])Function\\s*\\(",
      "message" : "evaluates code from a string"
    }, {
      "pattern" : "dangerouslySetInnerHTML|\\.(?:inner|outer)HTML\\s*=|insertAdjacentHTML|document\\s*\\.\\s*write",
      "message" : "writes raw HTML"
    }, {
      "pattern" : "document\\s*\\.\\s*cookie",
      "message" : "reads or writes cookies"
    }, {
      "pattern" : "\\bwindow\\s*\\.\\s*(?:top|parent|opener)\\b",
      "message" : "reaches another window"
    } ],
    "slotExports" : "exactly the exports of the file it replaces",
    "maxFileBytes" : 262144,
    "maxFiles" : 200,
    "navIcons" : "manifest navIcons {module, names}: up to 24 components named <Name>Icon exported by one .tsx helper; pages may then name them as nav icons",
    "thumbnail" : "an asset at kit/thumbnail.<png|jpg|webp|svg> (role THUMBNAIL) pictures the kit in the generator; it is not written into the app"
  }
}
